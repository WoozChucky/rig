{
    // IntelliSense for the C/C++ extension. The compiler is one unity build
    // (src/rig.cpp includes everything), so every file sees the same flags.
    // On Windows no compilerPath is given on purpose: the extension then finds
    // Visual Studio's headers itself, which clang can fail to do when another
    // Visual Studio installer product is newer (see build.bat). The RIG_
    // defines stand in for the stamp the build scripts pass (src/version.h),
    // without which every file would show its #error.
    "configurations": [
        {
            "name": "Windows",
            "includePath": ["${workspaceFolder}/src", "${workspaceFolder}/deps/llvm-windows/include"],
            "defines": ["_CRT_SECURE_NO_WARNINGS", "RIG_VERSION=\"0.0.0\"", "RIG_COMMIT=\"unknown\"", "RIG_COMMIT_DIRTY=0", "RIG_COMMIT_DATE=\"unknown\"", "RIG_BUILD=\"debug\""],
            "cppStandard": "c++23",
            "cStandard": "c17",
            "intelliSenseMode": "windows-clang-x64"
        },
        {
            "name": "Linux",
            "includePath": ["${workspaceFolder}/src", "${workspaceFolder}/deps/llvm-linux/include"],
            "compilerPath": "/usr/bin/clang++",
            "defines": ["RIG_VERSION=\"0.0.0\"", "RIG_COMMIT=\"unknown\"", "RIG_COMMIT_DIRTY=0", "RIG_COMMIT_DATE=\"unknown\"", "RIG_BUILD=\"debug\""],
            "cppStandard": "c++23",
            "cStandard": "c17",
            "intelliSenseMode": "linux-clang-x64"
        }
    ],
    "version": 4
}
