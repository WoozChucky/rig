{
    // Debug Rig's compiler and its unit tests (F5). Each builds first.
    // Windows uses Visual Studio's debugger with the .pdb files clang writes;
    // Linux (VS Code's WSL extension) uses gdb (sudo apt install gdb).
    // The last debugs a Rig program instead: the open .rig file, built with
    // bin/rig by Rig's own extension (editors/vscode, which must be
    // installed for it), on either system. It's last so that F5's default,
    // the first, works without the extension.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "unit tests (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/unit-tests.exe",
            "args": ["${input:testFilter}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "rig version (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/rig.exe",
            "args": ["version"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "rig build the open .rig file (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/rig.exe",
            "args": ["build", "${file}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "unit tests (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/unit-tests",
            "args": ["${input:testFilter}"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "build"
        },
        {
            "name": "rig version (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/rig",
            "args": ["version"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "build"
        },
        {
            "name": "rig build the open .rig file (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/rig",
            "args": ["build", "${file}"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "preLaunchTask": "build"
        },
        {
            "name": "Rig: debug the open .rig file",
            "type": "rig",
            "request": "launch"
        }
    ],
    "inputs": [
        {
            "id": "testFilter",
            "type": "promptString",
            "description": "Run the tests whose names, or files' names, contain (empty: all):",
            "default": "base"
        }
    ]
}
