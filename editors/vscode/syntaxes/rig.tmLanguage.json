{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Rig",
    "scopeName": "source.rig",
    "fileTypes": ["rig"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#directives" },
        { "include": "#declarations" },
        { "include": "#cast" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#iterators" },
        { "include": "#types" },
        { "include": "#numbers" },
        { "include": "#calls" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.rig",
                    "match": "//.*$"
                },
                { "include": "#block-comment" }
            ]
        },
        "block-comment": {
            "comment": "Block comments nest, as the lexer reads them: /* a /* b */ c */ is one comment.",
            "name": "comment.block.rig",
            "begin": "/\\*",
            "end": "\\*/",
            "patterns": [{ "include": "#block-comment" }]
        },
        "strings": {
            "comment": "A string is on one line; only \\n \\t \\r \\0 \\\\ and \\\" are escapes, anything else after a backslash is an error.",
            "name": "string.quoted.double.rig",
            "begin": "\"",
            "end": "\"|$",
            "patterns": [
                {
                    "name": "constant.character.escape.rig",
                    "match": "\\\\[ntr0\\\\\"]"
                },
                {
                    "name": "invalid.illegal.unknown-escape.rig",
                    "match": "\\\\."
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "comment": "#foreign names the library after it: #foreign libc.",
                    "match": "(#foreign)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.directive.rig" },
                        "2": { "name": "entity.name.namespace.rig" }
                    }
                },
                {
                    "name": "keyword.other.directive.rig",
                    "match": "#[A-Za-z_][A-Za-z0-9_]*"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "name :: ( ... a procedure, when the parenthesis holds nothing, a parameter (IDENT ':'), or ends the line, as the parser decides; otherwise a parenthesised constant.",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=\\(\\s*(?:\\)|$|[A-Za-z_][A-Za-z0-9_]*\\s*:(?![:=])))",
                    "captures": {
                        "1": { "name": "entity.name.function.rig" },
                        "2": { "name": "keyword.operator.declaration.rig" }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=(?:struct|enum|union)\\b)",
                    "captures": {
                        "1": { "name": "entity.name.type.rig" },
                        "2": { "name": "keyword.operator.declaration.rig" }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
                    "captures": {
                        "1": { "name": "variable.other.constant.rig" },
                        "2": { "name": "keyword.operator.declaration.rig" }
                    }
                }
            ]
        },
        "cast": {
            "comment": "cast,trunc(T): the modifier after the comma.",
            "match": "\\b(cast)\\s*(,)\\s*([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.other.cast.rig" },
                "2": { "name": "punctuation.separator.comma.rig" },
                "3": { "name": "keyword.other.cast-modifier.rig" }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.rig",
                    "match": "\\b(?:if|else|while|for|break|continue|return|defer)\\b"
                },
                {
                    "name": "storage.type.rig",
                    "match": "\\b(?:struct|enum|union)\\b"
                },
                {
                    "name": "keyword.other.rig",
                    "match": "\\b(?:cast|using)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.rig",
                    "match": "\\b(?:true|false|null)\\b"
                },
                {
                    "comment": "--- leaves a variable uninitialised on purpose.",
                    "name": "constant.language.uninitialized.rig",
                    "match": "---"
                }
            ]
        },
        "iterators": {
            "comment": "The names a for loop declares.",
            "name": "variable.language.rig",
            "match": "\\b(?:it|it_index)\\b"
        },
        "types": {
            "name": "support.type.primitive.rig",
            "match": "\\b(?:s8|s16|s32|s64|u8|u16|u32|u64|int|bool|float|float32|float64|string)\\b"
        },
        "numbers": {
            "comment": "As the lexer reads them: decimal, 0x and 0b with lowercase prefixes, '_' anywhere after the first digit, floats with a digit after the '.' or an exponent. A number running into letters (123abc, 0b12, 0X10) is one bad literal.",
            "patterns": [
                {
                    "name": "constant.numeric.hex.rig",
                    "match": "\\b0x[0-9A-Fa-f_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.rig",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.numeric.float.rig",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?\\b"
                },
                {
                    "name": "constant.numeric.float.rig",
                    "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
                },
                {
                    "name": "constant.numeric.integer.rig",
                    "match": "\\b[0-9][0-9_]*\\b"
                },
                {
                    "name": "invalid.illegal.number.rig",
                    "match": "\\b[0-9][A-Za-z0-9_]*"
                }
            ]
        },
        "calls": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": { "name": "entity.name.function.call.rig" }
            }
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.declaration.rig",
                    "match": "::|:="
                },
                {
                    "name": "keyword.operator.arrow.rig",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.range.rig",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.assignment.compound.rig",
                    "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
                },
                {
                    "name": "keyword.operator.logical.rig",
                    "match": "&&|\\|\\||!(?!=)"
                },
                {
                    "name": "keyword.operator.comparison.rig",
                    "match": "==|!=|<=|>=|<(?!<)|>(?!>)"
                },
                {
                    "name": "keyword.operator.bitwise.rig",
                    "match": "<<|>>|&|\\||\\^|~"
                },
                {
                    "name": "keyword.operator.arithmetic.rig",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.assignment.rig",
                    "match": "="
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.rig",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.rig",
                    "match": ","
                },
                {
                    "name": "punctuation.separator.colon.rig",
                    "match": ":"
                },
                {
                    "name": "punctuation.accessor.rig",
                    "match": "\\."
                }
            ]
        }
    }
}
