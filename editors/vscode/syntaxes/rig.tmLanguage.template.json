{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Rig",
    "scopeName": "source.rig",
    "comment": "rig.tmLanguage.json is generated from rig.tmLanguage.template.json by tests/unit/test_grammar.cpp, which fills in the keyword, type and operator lists from the compiler's tables: edit the template, then run RIG_BLESS=1 bin/unit-tests vscode_grammar.",
    "fileTypes": [
        "rig"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#cast"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#iterators"
        },
        {
            "include": "#types"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#invalid"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.rig",
                    "match": "//.*$"
                },
                {
                    "include": "#block-comment"
                }
            ]
        },
        "block-comment": {
            "comment": "Block comments nest, as the lexer reads them: /* a /* b */ c */ is one comment.",
            "name": "comment.block.rig",
            "begin": "/\\*",
            "end": "\\*/",
            "patterns": [
                {
                    "include": "#block-comment"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "A string with no closing quote on its line is an error.",
                    "name": "invalid.illegal.unterminated-string.rig",
                    "match": "\"(?:[^\"\\\\]|\\\\.)*\\\\?$"
                },
                {
                    "comment": "A string is on one line; only \\n \\t \\r \\0 \\\\ and \\\" are escapes, anything else after a backslash is an error.",
                    "name": "string.quoted.double.rig",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.rig"
                        }
                    },
                    "end": "\"|$",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.rig"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.rig",
                            "match": "\\\\[ntr0\\\\\"]"
                        },
                        {
                            "name": "invalid.illegal.unknown-escape.rig",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "comment": "#foreign names the library after it: #foreign libc.",
                    "match": "(#foreign)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.directive.rig"
                        },
                        "2": {
                            "name": "entity.name.namespace.rig"
                        }
                    }
                },
                {
                    "name": "keyword.other.directive.rig",
                    "match": "#[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "comment": "'#' without a name right after it is an error.",
                    "name": "invalid.illegal.directive.rig",
                    "match": "#(?![A-Za-z_])"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "name :: ( ... is a procedure when the parenthesis holds nothing, starts with a parameter (IDENT ':'), or ends the line: a one-line approximation of the parser's parameters_follow, which looks past the ')'. Otherwise a parenthesised constant.",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=\\(\\s*(?:\\)|$|[A-Za-z_][A-Za-z0-9_]*\\s*:(?![:=])))",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.rig"
                        },
                        "2": {
                            "name": "keyword.operator.declaration.rig"
                        }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=(?:@KEYWORDS_STORAGE@)\\b)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.rig"
                        },
                        "2": {
                            "name": "keyword.operator.declaration.rig"
                        }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
                    "captures": {
                        "1": {
                            "name": "variable.other.constant.rig"
                        },
                        "2": {
                            "name": "keyword.operator.declaration.rig"
                        }
                    }
                }
            ]
        },
        "cast": {
            "comment": "cast,trunc(T): the modifier after the comma. Hand-written: a modifier (trunc, spec 6.4) is a name after cast's comma, not a keyword, so no compiler table lists the modifiers, and the rule takes any name there.",
            "match": "\\b(cast)\\s*(,)\\s*([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.other.cast.rig"
                },
                "2": {
                    "name": "punctuation.separator.comma.rig"
                },
                "3": {
                    "name": "keyword.other.cast-modifier.rig"
                }
            }
        },
        "keywords": {
            "comment": "The lexer's keywords, in the groups tests/unit/test_grammar.cpp's KEYWORD_SCOPES gives them.",
            "patterns": [
                {
                    "name": "keyword.control.rig",
                    "match": "\\b(?:@KEYWORDS_CONTROL@)\\b"
                },
                {
                    "name": "storage.type.rig",
                    "match": "\\b(?:@KEYWORDS_STORAGE@)\\b"
                },
                {
                    "name": "keyword.other.cast.rig",
                    "match": "\\b(?:@KEYWORDS_CAST@)\\b"
                },
                {
                    "name": "keyword.other.rig",
                    "match": "\\b(?:@KEYWORDS_OTHER@)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.rig",
                    "match": "\\b(?:@KEYWORDS_CONSTANT@)\\b"
                }
            ]
        },
        "iterators": {
            "comment": "The names a for loop declares. Hand-written: to the lexer they're identifiers, not keywords, so no compiler table lists them.",
            "name": "variable.language.rig",
            "match": "\\b(?:it|it_index)\\b"
        },
        "types": {
            "comment": "The checker's built-in type names (src/types.cpp's NAMED_TYPES), then the ones the language will have but the checker doesn't know yet (tests/unit/test_grammar.cpp's RESERVED_TYPES).",
            "name": "support.type.primitive.rig",
            "match": "\\b(?:@TYPES@)\\b"
        },
        "numbers": {
            "comment": "As the lexer reads them: decimal, 0x and 0b with lowercase prefixes and at least one digit, '_' anywhere after the first digit, floats with a digit after the '.' or an exponent. A number running into letters (123abc, 0b12, 0X10, 1.5f, 1e+, 0x_) is one bad literal.",
            "patterns": [
                {
                    "name": "constant.numeric.hex.rig",
                    "match": "\\b0x_*[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
                },
                {
                    "name": "constant.numeric.binary.rig",
                    "match": "\\b0b_*[01][01_]*\\b"
                },
                {
                    "name": "constant.numeric.float.rig",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?\\b"
                },
                {
                    "name": "constant.numeric.float.rig",
                    "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
                },
                {
                    "name": "constant.numeric.integer.rig",
                    "match": "\\b[0-9][0-9_]*\\b(?!\\.[0-9])"
                },
                {
                    "name": "invalid.illegal.number.rig",
                    "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?)?[A-Za-z0-9_]*"
                }
            ]
        },
        "calls": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.call.rig"
                }
            }
        },
        "operators": {
            "comment": "The lexer's punctuation but the brackets, longest first, each its own capture group with its scope (tests/unit/test_grammar.cpp's OPERATOR_SCOPES): the first alternative that matches is then the longest, as the lexer reads them, so <<= is one operator, not << and =. --- (a variable left uninitialised on purpose) is here too.",
            "match": "@OPERATORS@",
            "captures": "@OPERATOR_CAPTURES@"
        },
        "invalid": {
            "comment": "Characters the lexer rejects: punctuation Rig doesn't use, and non-ASCII outside strings and comments.",
            "name": "invalid.illegal.character.rig",
            "match": "[@$?'`\\\\]|\\w*[^\\x00-\\x7F]\\w*"
        }
    }
}
