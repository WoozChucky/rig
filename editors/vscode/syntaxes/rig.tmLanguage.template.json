{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Rig",
    "scopeName": "source.rig",
    "comment": "rig.tmLanguage.json is generated from rig.tmLanguage.template.json by tests/unit/test_grammar.cpp, which fills in the keyword, type and operator lists from the compiler's tables: edit the template, then run RIG_BLESS=1 bin/unit-tests vscode_grammar.",
    "fileTypes": [
        "rig"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#cast-type"
        },
        {
            "include": "#cast"
        },
        {
            "include": "#size-of"
        },
        {
            "include": "#for-iterator"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#iterators"
        },
        {
            "include": "#typed-literal"
        },
        {
            "include": "#types"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#dereference"
        },
        {
            "include": "#type-annotation"
        },
        {
            "include": "#result-types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#invalid"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.rig",
                    "match": "//.*$"
                },
                {
                    "include": "#block-comment"
                }
            ]
        },
        "block-comment": {
            "comment": "Block comments nest, as the lexer reads them: /* a /* b */ c */ is one comment.",
            "name": "comment.block.rig",
            "begin": "/\\*",
            "end": "\\*/",
            "patterns": [
                {
                    "include": "#block-comment"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "A string with no closing quote on its line is an error.",
                    "name": "invalid.illegal.unterminated-string.rig",
                    "match": "\"(?:[^\"\\\\]|\\\\.)*\\\\?$"
                },
                {
                    "comment": "A string is on one line; only \\n \\t \\r \\0 \\\\ and \\\" are escapes, anything else after a backslash is an error.",
                    "name": "string.quoted.double.rig",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.rig"
                        }
                    },
                    "end": "\"|$",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.rig"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.rig",
                            "match": "\\\\[ntr0\\\\\"]"
                        },
                        {
                            "name": "invalid.illegal.unknown-escape.rig",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "comment": "#foreign names the library after it: #foreign libc.",
                    "match": "(#foreign)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.directive.rig"
                        },
                        "2": {
                            "name": "entity.name.namespace.rig"
                        }
                    }
                },
                {
                    "name": "keyword.other.directive.rig",
                    "match": "#[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "comment": "'#' without a name right after it is an error.",
                    "name": "invalid.illegal.directive.rig",
                    "match": "#(?![A-Za-z_])"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "name :: ( ... is a procedure when the parenthesis holds nothing, starts with a parameter (IDENT ':'), or ends the line: a one-line approximation of the parser's parameters_follow, which looks past the ')'. Otherwise a parenthesised constant.",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=\\(\\s*(?:\\)|$|[A-Za-z_][A-Za-z0-9_]*\\s*:(?![:=])))",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.rig"
                        },
                        "2": {
                            "name": "keyword.operator.declaration.rig"
                        }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=(?:@KEYWORDS_STORAGE@)\\b)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.rig"
                        },
                        "2": {
                            "name": "keyword.operator.declaration.rig"
                        }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
                    "captures": {
                        "1": {
                            "name": "variable.other.constant.rig"
                        },
                        "2": {
                            "name": "keyword.operator.declaration.rig"
                        }
                    }
                }
            ]
        },
        "cast-type": {
            "comment": "cast(T) and cast,trunc(T): T is a type (#type), up to the ')' that closes the cast's '(', or the line's end, so a '(' left unclosed while typing doesn't make the lines after it types. The cast and its modifier get #cast's scopes, which takes them when no '(' follows on the line.",
            "begin": "\\b(cast)\\s*(?:(,)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*)?(\\()",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.cast.rig"
                },
                "2": {
                    "name": "punctuation.separator.comma.rig"
                },
                "3": {
                    "name": "keyword.other.cast-modifier.rig"
                }
            },
            "end": "\\)|$",
            "patterns": [
                {
                    "include": "#type"
                }
            ]
        },
        "size-of": {
            "comment": "size_of(T): T is a type (#type), up to the ')' or the line's end, as in #cast-type. size_of is a name, not a keyword (spec A.4), so it's coloured as a call, as before it took its type.",
            "begin": "\\b(size_of)\\s*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.function.call.rig"
                }
            },
            "end": "\\)|$",
            "patterns": [
                {
                    "include": "#type"
                }
            ]
        },
        "for-iterator": {
            "comment": "for n: numbers, for * p: items (spec 6.7, 6.8): the name and ':' after 'for' (or 'for *') name the iterator, and what follows is the sequence or range, an expression. Taken here, with its ':', before #type-annotation would take the ':' as a type's.",
            "match": "\\b(for)\\b\\s*(?:(\\*)\\s*)?([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?![:=])",
            "captures": {
                "1": {
                    "patterns": [
                        {
                            "include": "#keywords"
                        }
                    ]
                },
                "2": {
                    "patterns": [
                        {
                            "include": "#operators"
                        }
                    ]
                },
                "4": {
                    "patterns": [
                        {
                            "include": "#operators"
                        }
                    ]
                }
            }
        },
        "cast": {
            "comment": "cast,trunc(T): the modifier after the comma, when no '(' follows it on the line (#cast-type takes it otherwise, with the same scopes). Hand-written: a modifier (trunc, spec 3.14) is a name after cast's comma, not a keyword, so no compiler table lists the modifiers, and the rule takes any name there.",
            "match": "\\b(cast)\\s*(,)\\s*([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.other.cast.rig"
                },
                "2": {
                    "name": "punctuation.separator.comma.rig"
                },
                "3": {
                    "name": "keyword.other.cast-modifier.rig"
                }
            }
        },
        "keywords": {
            "comment": "The lexer's keywords, in the groups tests/unit/test_grammar.cpp's KEYWORD_SCOPES gives them.",
            "patterns": [
                {
                    "name": "keyword.control.rig",
                    "match": "\\b(?:@KEYWORDS_CONTROL@)\\b"
                },
                {
                    "name": "storage.type.rig",
                    "match": "\\b(?:@KEYWORDS_STORAGE@)\\b"
                },
                {
                    "name": "keyword.other.cast.rig",
                    "match": "\\b(?:@KEYWORDS_CAST@)\\b"
                },
                {
                    "name": "keyword.other.rig",
                    "match": "\\b(?:@KEYWORDS_OTHER@)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.rig",
                    "match": "\\b(?:@KEYWORDS_CONSTANT@)\\b"
                }
            ]
        },
        "iterators": {
            "comment": "The names a for loop declares. Hand-written: to the lexer they're identifiers, not keywords, so no compiler table lists them.",
            "name": "variable.language.rig",
            "match": "\\b(?:it|it_index)\\b"
        },
        "types": {
            "comment": "The checker's built-in type names (src/types.cpp's NAMED_TYPES), then the ones the language will have but the checker doesn't know yet (tests/unit/test_grammar.cpp's RESERVED_TYPES).",
            "name": "support.type.primitive.rig",
            "match": "\\b(?:@TYPES@)\\b"
        },
        "type-name": {
            "comment": "A name where a type is written: a built-in type keeps its scope (#types), any other is a type the program declares.",
            "patterns": [
                {
                    "include": "#types"
                },
                {
                    "name": "entity.name.type.rig",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "typed-literal": {
            "comment": "The type a literal is written with, before its '.{' or '.[', spaces allowed around the '.' as the lexer allows them: Vec2.{1, 2}, Vec2 .{1, 2}, int.[1, 2] (spec 5.17). A keyword before an untyped literal, return .{a, b}, is #keywords', listed earlier.",
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\.\\s*[{\\[])",
            "captures": {
                "1": {
                    "patterns": [
                        {
                            "include": "#type-name"
                        }
                    ]
                }
            }
        },
        "numbers": {
            "comment": "As the lexer reads them: decimal, 0x and 0b with lowercase prefixes and at least one digit, '_' anywhere after the first digit, floats with a digit after the '.' or an exponent. A number running into letters (123abc, 0b12, 0X10, 1.5f, 1e+, 0x_) is one bad literal.",
            "patterns": [
                {
                    "name": "constant.numeric.hex.rig",
                    "match": "\\b0x_*[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
                },
                {
                    "name": "constant.numeric.binary.rig",
                    "match": "\\b0b_*[01][01_]*\\b"
                },
                {
                    "name": "constant.numeric.float.rig",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?\\b"
                },
                {
                    "name": "constant.numeric.float.rig",
                    "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
                },
                {
                    "name": "constant.numeric.integer.rig",
                    "match": "\\b[0-9][0-9_]*\\b(?!\\.[0-9])"
                },
                {
                    "name": "invalid.illegal.number.rig",
                    "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?)?[A-Za-z0-9_]*"
                }
            ]
        },
        "calls": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.call.rig"
                }
            }
        },
        "dereference": {
            "comment": "p.* reads what p points at. The lexer reads a '*' right after a '.' token alone, whatever follows it (src/lexer.h), so p.*=5 is p.* = 5 and p.*==q is p.* == q; the operators' longest match would take *= instead, so this comes first. Not after another '.': that's the range's '..'.",
            "match": "(?<!\\.)(\\.)\\s*(\\*)",
            "captures": {
                "1": {
                    "name": "punctuation.accessor.rig"
                },
                "2": {
                    "name": "keyword.operator.dereference.rig"
                }
            }
        },
        "type-annotation": {
            "comment": "The type after a single ':' (not '::' or ':='): a parameter's, a field's, a variable's (spec 3.1, 4). It runs to what ends a type at its own level, ; = , ) ] { or }, or to the line's end: only a procedure type's parameters (#type-parameters) go on past it, to their ')'. A for loop's iterator, for n: numbers, is #for-iterator's, which takes its ':' first.",
            "begin": "(?<!:)(:)(?![:=])",
            "beginCaptures": {
                "1": {
                    "patterns": [
                        {
                            "include": "#operators"
                        }
                    ]
                }
            },
            "end": "(?=[;=,)\\]{}]|$)",
            "patterns": [
                {
                    "include": "#type"
                }
            ]
        },
        "result-types": {
            "comment": "A procedure's results after its '->' (spec 7.1): -> Vec2, Vec2 { has two, separated by commas, up to the body's '{', a ';' (#foreign), ) ] } = or the line's end. A '->' inside a type, as in f: (Vec2) -> Vec2, n: int, is the type's own (#type), where a ',' ends the type.",
            "begin": "->",
            "beginCaptures": {
                "0": {
                    "patterns": [
                        {
                            "include": "#operators"
                        }
                    ]
                }
            },
            "end": "(?=[;={})\\]]|$)",
            "patterns": [
                {
                    "include": "#type"
                }
            ]
        },
        "type": {
            "comment": "A type (spec 3.1): the prefixes *, [N] and [], a procedure type's (...) -> ..., #c_call, and names, each a type. The rule that starts the type says where it ends.",
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#directives"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#invalid"
                },
                {
                    "include": "#type-parameters"
                },
                {
                    "include": "#type-brackets"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#type-name"
                }
            ]
        },
        "type-parameters": {
            "comment": "A procedure type's parameters (spec 3.15): (Vec2, int), or with names, (a: Vec2, b: int). A name before a ':' names a parameter; every other is a type.",
            "begin": "\\(",
            "end": "\\)",
            "patterns": [
                {
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(:)(?![:=])",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#operators"
                                }
                            ]
                        }
                    }
                },
                {
                    "include": "#type"
                }
            ]
        },
        "type-brackets": {
            "comment": "The [N] of an array type or the [] of a view's, before the element type: N is an expression, highlighted as everywhere else. Brackets inside it pair with each other, so [a[1]]Vec2 ends at the right ']'.",
            "begin": "\\[",
            "end": "\\]",
            "patterns": [
                {
                    "include": "#type-brackets"
                },
                {
                    "include": "$self"
                }
            ]
        },
        "operators": {
            "comment": "The lexer's punctuation but the brackets, longest first, each its own capture group with its scope (tests/unit/test_grammar.cpp's OPERATOR_SCOPES): the first alternative that matches is then the longest, as the lexer reads them, so <<= is one operator, not << and =. --- (a variable left uninitialised on purpose) is here too.",
            "match": "@OPERATORS@",
            "captures": "@OPERATOR_CAPTURES@"
        },
        "invalid": {
            "comment": "Characters the lexer rejects: punctuation Rig doesn't use, and non-ASCII outside strings and comments.",
            "name": "invalid.illegal.character.rig",
            "match": "[@$?'`\\\\]|\\w*[^\\x00-\\x7F]\\w*"
        }
    }
}
