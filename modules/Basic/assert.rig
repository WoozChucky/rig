// Basic's assert: a condition the program holds to be true, checked as it
// runs. A true one does nothing; a false one stops the program with a
// runtime error (spec 8.1), at the place of the assert's call:
//
//     main.rig:7:5: runtime error: assertion failed: n is positive
//
// written to standard error after what the program printed, and the exit
// status 101, as a failing bounds check gives. That place is the caller's,
// #caller_location (spec 7.2), so the line names the program's assert, not
// this file.
//
// It ends with a runtime error, through Preload's __runtime_error, rather
// than writing the line and calling C's exit, for the code a #run runs
// while compiling (spec 7.8): there, exit would end rig itself at once,
// with no word of where the #run is or what else is wrong in the program,
// and a runtime error fails the #run as a failing check does, an error at
// the #run with the calls that led to it, and the build goes on to report
// the rest. Compiled and interpreted, the two would write the same line.
//
// It can't be turned off: an optimised build checks every assert too.
#load "builder.rig";

// Stops the program with a runtime error when condition is false, its
// message "assertion failed", followed by ": " and message when message
// isn't empty: assert(n > 0, "n is positive"). message is written as it
// is, a {} in it included: it is no format, since a parameter with a
// default can't come before a '..' one. When condition is true it does
// nothing and allocates nothing.
//
// The line names loc's place, PATH:LINE:COL: before "runtime error: ", as
// a runtime error there would; a loc with no place, its line 0 or less (a
// zeroed one, which a call through a procedure value, given no default,
// may pass), leaves it out, as the memory debugger leaves out a place it
// doesn't have. The line is
// built on the heap, never on context.allocator, whose arena or memory
// debugger needn't see it, and isn't given back: the program, or the #run,
// ends there. No deferred statement runs, as after any runtime error (spec
// 6.12). Should the heap have no memory for it, the builder stops the
// program with its own runtime error (builder.rig) instead.
assert :: (condition: bool, message: string = "", loc: Source_Code_Location = #caller_location) {
    if condition { return; }
    line : String_Builder;
    builder_init(*line, HEAP_ALLOCATOR);
    if loc.line > 0 {
        append_string(*line, loc.file);
        append_string(*line, ":");
        append_int(*line, loc.line, 10);
        append_string(*line, ":");
        append_int(*line, loc.column, 10);
        append_string(*line, ": ");
    }
    append_string(*line, "runtime error: ");
    // Where the message starts: the interpreter gives what follows, as it
    // gives a failing check's message without its place (spec 10.8).
    message_start := line.count;
    append_string(*line, "assertion failed");
    if message.count > 0 {
        append_string(*line, ": ");
        append_string(*line, message);
    }
    append_string(*line, "\n");
    text : string;
    text.data = line.data;
    text.count = line.count;
    __runtime_error(text, message_start);
}
