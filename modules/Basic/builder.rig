// Basic's string builder: text put together a piece at a time, in memory
// that grows as it fills, and copied out as one string at the end. A string
// is a view of bytes someone else holds, so text made at run time, from
// pieces and numbers, needs memory of its own to be made in: the builder's,
// taken from the allocator it is given, the context's unless another is.
//
// Every append goes through append_string, which is where the memory
// grows. A number is written into a buffer on the stack by numbers.rig and
// appended from there, so nothing but the builder's own memory is
// allocated.
//
// Each procedure here that allocates or frees, the appends,
// builder_to_string and builder_free, takes loc last, the place of the call
// that leaves it out (#caller_location, spec 7.2), and passes it down to the
// helper that calls the allocator (allocators.rig): so an allocator that
// records where it is asked from sees the program's line, not this file's.
// The other appends pass theirs on to append_string.
#load "allocators.rig";
#load "numbers.rig";
#load "memory.rig";

// Text being built: count bytes at data, which has room for capacity bytes,
// from allocator. data is null, and count and capacity 0, until the first
// append that needs room.
String_Builder :: struct {
    allocator: Allocator;
    data: *u8;
    count: int;
    capacity: int;
}

// Makes builder an empty builder whose memory comes from allocator, the
// context's unless given, which the builder keeps. Nothing is taken until
// the first append that needs it. It doesn't give back memory a builder
// already had: builder_free does.
builder_init :: (builder: *String_Builder, allocator: Allocator = context.allocator) {
    builder.allocator = allocator;
    builder.data = null;
    builder.count = 0;
    builder.capacity = 0;
}

// Appends the bytes of s. An empty or zeroed string appends nothing, and so
// takes no memory.
//
// When the bytes don't fit, the capacity becomes the larger of 64 and
// twice the old one, doubled again until they fit, and the memory is moved
// there with resize. Growing by doubling, rather than by what each append
// needs, means n bytes appended one at a time are moved about n times in
// all, not about n * n / 2.
//
// s may be a view of the builder's own text, to append again what it holds
// already. Growing can move that text and give back the memory it was in,
// so the bytes are then copied from where they moved to.
//
// An allocator that has no more memory gives null, and the builder doesn't
// test for it: its data is then null, and the copy below, which takes the
// address of an element of data, stops the program with the language's
// null pointer dereference.
append_string :: (builder: *String_Builder, s: string, loc: Source_Code_Location = #caller_location) {
    LARGEST :: 9223372036854775807; // int's largest value
    HALF :: LARGEST / 2;
    if s.count <= 0 { return; }
    source := s.data;
    if s.count > builder.capacity - builder.count {
        // Whether s starts in the builder's text, and how far into it.
        own := s.data >= builder.data && s.data < builder.data + builder.count;
        offset := s.data - builder.data;

        // Past int's largest, no memory holds the bytes: asking for that
        // many gives null.
        needed := LARGEST;
        if s.count <= LARGEST - builder.count { needed = builder.count + s.count; }
        // Doubling past half of int's largest would wrap, so an old capacity
        // past it becomes int's largest, and one the loop has doubled past
        // it becomes what is needed.
        capacity := 64;
        if builder.capacity > 32 {
            capacity = LARGEST;
            if builder.capacity <= HALF { capacity = builder.capacity * 2; }
        }
        while capacity < needed {
            if capacity > HALF {
                capacity = needed;
            } else {
                capacity *= 2;
            }
        }
        builder.data = cast(*u8) resize(builder.data, builder.capacity, capacity, builder.allocator, loc);
        builder.capacity = capacity;
        if own { source = builder.data + offset; }
    }
    // tests/run/basic_builder_overflow.err, basic_builder_overflow_append.err,
    // basic_builder_overflow_doubling.err and memory_debugger_bad_resize.err
    // name this line.
    copy_memory(*builder.data[builder.count], source, s.count);
    builder.count += s.count;
}

// Appends one byte, as itself: append_byte(builder, 32) appends a space.
append_byte :: (builder: *String_Builder, byte: u8, loc: Source_Code_Location = #caller_location) {
    bytes : [1]u8;
    bytes[0] = byte;
    view : []u8 = bytes;
    append_string(builder, cast(string) view, loc);
}

// Appends value in a base from 2 to 36, as format_int writes it; another
// base appends nothing.
append_int :: (builder: *String_Builder, value: int, base: int, loc: Source_Code_Location = #caller_location) {
    buffer : [INT_TEXT_MAX]u8;
    append_string(builder, format_int(buffer, value, base), loc);
}

// Appends value in a base from 2 to 36, as format_u64 writes it, so a u64
// above int's largest too; another base appends nothing.
append_u64 :: (builder: *String_Builder, value: u64, base: int, loc: Source_Code_Location = #caller_location) {
    buffer : [INT_TEXT_MAX]u8;
    append_string(builder, format_u64(buffer, value, base), loc);
}

// Appends value with decimals digits after the point, from 0 to 9, as
// format_float writes it: "nan", "inf" and "-inf" included.
append_float :: (builder: *String_Builder, value: float64, decimals: int, loc: Source_Code_Location = #caller_location) {
    buffer : [FLOAT_TEXT_MAX]u8;
    append_string(builder, format_float(buffer, value, decimals), loc);
}

// Appends true or false.
append_bool :: (builder: *String_Builder, value: bool, loc: Source_Code_Location = #caller_location) {
    if value {
        append_string(builder, "true", loc);
    } else {
        append_string(builder, "false", loc);
    }
}

// A copy of the builder's text, in memory from allocator, the context's
// unless given (not the builder's, though it may be the same one). The
// caller gives it back with free(s.data, allocator). The copy is the
// caller's own: the builder can be appended to, reset or freed without
// changing it.
//
// An empty builder gives the zeroed string, count 0 and data null, and
// allocates nothing: a literal "" would do as well to read, but its data
// isn't null, and freeing it would give an allocator memory it never gave.
// An allocator that has no memory gives null, and the copy stops the
// program with a null pointer dereference, as append_string's does.
builder_to_string :: (builder: *String_Builder, allocator: Allocator = context.allocator, loc: Source_Code_Location = #caller_location) -> string {
    text : string;
    if builder.count == 0 { return text; }
    text.data = cast(*u8) alloc(builder.count, allocator, loc);
    text.count = builder.count;
    copy_memory(*text.data[0], builder.data, builder.count);
    return text;
}

// Empties builder for reuse: its count goes to 0, and its memory is kept,
// so text of the same length is built again without allocating.
builder_reset :: (builder: *String_Builder) {
    builder.count = 0;
}

// Gives the builder's memory back to its allocator. The builder is empty,
// with data null and count and capacity 0, and keeps its allocator, so it
// can be appended to again.
builder_free :: (builder: *String_Builder, loc: Source_Code_Location = #caller_location) {
    free(builder.data, builder.allocator, loc);
    builder.data = null;
    builder.count = 0;
    builder.capacity = 0;
}
