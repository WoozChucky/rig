// Basic's C layer: the C functions Basic declares, each under a name of its
// own that starts with c_ (#foreign libc "NAME", spec 7.6). Every name
// Basic declares is the program's too, since a program has one top level,
// so if Basic took C's own names, a program that loads it couldn't declare
// putchar or malloc itself. With the c_ names it can, and a program's
// putchar and Basic's c_putchar are the same C function.
//
// Everything else in Basic is written in Rig over these and over Preload's
// heap allocator (spec 2.14).
//
// The ones before the per-system part at the end of this file each link
// and run on Windows (the UCRT) and Linux (glibc's libc and, for <math.h>,
// its libm, which every program links too, spec 10.6), compiled and
// interpreted, with one declaration that serves both: where C's types
// differ (fseek's long offset, fpos_t, struct timespec), the declaration
// and its comment say how Basic stays within what both agree on. On Windows
// the interpreter takes them from the compiler's own copy of the C library,
// so a FILE * that c_fopen gives is one the other calls accept. Some C
// functions that would seem to fit are left out on purpose:
//
// - ftell and a nonzero fseek offset: they take or give C's long, 32 bits
//   on Windows and 64 on Linux, so no one declaration fits both, and on
//   Windows a file past 2 GiB is out of reach. A file's size comes from
//   fgetpos at its end instead, 64 bits on both.
// - _ftelli64 and ftello: one for each system, which the per-system part
//   could declare, but on Windows the interpreter takes _ftelli64 from a
//   second C runtime, whose calls refuse the compiler's own FILE *.
// - time: whole seconds, where timespec_get gives nanoseconds.
// - clock: a different clock on each system, the wall time since the
//   program started on Windows and the processor time on Linux.
//
// The per-system part, at the end, is a top-level #if (spec 4.9) whose two
// branches declare each system's own functions under one c_ name: a
// function only one system has, or one whose types differ between them,
// as c_write's count and result do. A procedure that calls one chooses
// with a statement #if in its body, and the branch it doesn't take is
// never checked. On Windows, interpreted, the functions there whose names
// start with _ come from ucrtbase.dll, a second C runtime with no state in
// common with the compiler's own copy (spec 10.8), so Basic uses them only
// with one another, never with a FILE * that the calls above give or take.

// Writes one byte to standard output, through C's own stdout buffer. It is
// the one call Basic writes to standard output with: it links and runs
// everywhere, compiled and interpreted, with one declaration, and its bytes
// stay in order with the ones a program writes with C's printf. Standard
// error is written with c_write, in the per-system part below.
c_putchar :: (c: s32) -> s32 #foreign libc "putchar";

// C's heap, for a program that imports Basic. Basic itself takes heap
// memory through Preload's heap allocator (HEAP_ALLOCATOR, spec 2.14), and
// Preload declares these three under names of its own, so Basic doesn't
// call them. What C's malloc and realloc give for a size of 0 is left to
// each C library, and Basic's allocator helpers never ask for it.
c_malloc :: (size: u64) -> *void #foreign libc "malloc";
c_realloc :: (memory: *void, size: u64) -> *void #foreign libc "realloc";
c_free :: (memory: *void) #foreign libc "free";

// C's fpos_t, a position in a file, which fgetpos fills and fsetpos goes
// back to. The UCRT's is a long long, 8 bytes, and glibc's a 16-byte
// struct whose first 8 bytes are the offset, so this struct holds either,
// with the offset in position on both. Basic reads position for a file's
// size and never touches reserved, which neither C library's fgetpos
// writes for a byte stream: glibc's fills its state only for a wide stream
// in a stateful encoding, and the UCRT's fpos_t is 8 bytes.
C_Fpos :: struct {
    position: s64;
    reserved: u64;
}

// fseek's origins, the same numbers in both C libraries: from the start of
// the file, and from its end.
C_SEEK_SET :: 0;
C_SEEK_END :: 2;

// Basic's files: opening one with a mode such as "rb" or "wb", which gives
// a C FILE *, or null when it can't be opened, and closing it, which gives
// 0, or EOF (-1) when what was still buffered couldn't be written.
c_fopen :: (path: *u8, mode: *u8) -> *void #foreign libc "fopen";
c_fclose :: (file: *void) -> s32 #foreign libc "fclose";

// Reading and writing count items of size bytes each, which give how many
// whole items were read or written. Basic passes a size of 1, so the count
// is in bytes.
c_fread :: (buffer: *void, size: u64, count: u64, file: *void) -> u64 #foreign libc "fread";
c_fwrite :: (data: *void, size: u64, count: u64, file: *void) -> u64 #foreign libc "fwrite";

// Moves to offset bytes from origin, C_SEEK_SET or C_SEEK_END; 0 when it
// could. The offset is C's long, 32 bits on Windows and 64 on Linux, so
// only an offset of 0 means the same on both, and 0 is all Basic passes:
// it goes to the end of a file to learn its size, and positions within a
// file are moved to with c_fsetpos.
c_fseek :: (file: *void, offset: s64, origin: s32) -> s32 #foreign libc "fseek";

// The position in a file, written to position, and a move back to one
// that c_fgetpos wrote; each gives 0 when it could. Unlike ftell's long,
// fpos_t holds 64 bits on both systems, so a file's size past 2 GiB is
// read right.
c_fgetpos :: (file: *void, position: *C_Fpos) -> s32 #foreign libc "fgetpos";
c_fsetpos :: (file: *void, position: *C_Fpos) -> s32 #foreign libc "fsetpos";

// Whether a read or write on the file has failed: not 0 when one has. A
// read of a directory opened as a file on Linux fails, and Basic tells a
// directory from a file by it.
c_ferror :: (file: *void) -> s32 #foreign libc "ferror";

// Writes out what C holds in a stream's buffer: 0 when it could. Given
// null it flushes every stream, which Basic does before running a command,
// so what the program printed comes out before what the command prints,
// and before writing to standard error, so it comes out before that too.
c_fflush :: (file: *void) -> s32 #foreign libc "fflush";

// Deletes the file at path: 0 when it did, and not 0 when it didn't. On
// Linux it deletes an empty directory too, so Basic checks first that the
// path is a file.
c_remove :: (path: *u8) -> s32 #foreign libc "remove";

// The environment: the value of the variable name, or null when there's
// none. The value is C's, to be read and not written or freed.
c_getenv :: (name: *u8) -> *u8 #foreign libc "getenv";

// Runs command through the system's shell (cmd.exe on Windows, sh on
// Linux) and gives its status: the command's exit code on Windows, and a
// wait status on Linux. Given null it runs nothing and gives whether there
// is a shell, not 0 when there is.
c_system :: (command: *u8) -> s32 #foreign libc "system";

// C's struct timespec, a time as whole seconds and the nanoseconds after
// them, which timespec_get fills. Its tv_sec is a 64-bit time_t on both
// systems, but its tv_nsec is C's long: 4 bytes and then 4 of padding in
// the UCRT, 8 bytes in glibc. The nanoseconds are below 10^9, so on
// glibc's little-endian long they are the low 4 bytes, and the high 4 are
// 0. So this struct, 16 bytes, holds either, and its nanoseconds field
// reads them on both. Basic leaves padding as C wrote it when reading one.
// It also passes one to C, to Linux's nanosleep (c_nanosleep, below), with
// padding 0: then glibc's 8-byte tv_nsec, low 4 bytes and high 4 together,
// is the nanoseconds field's value.
C_Timespec :: struct {
    seconds: s64;
    nanoseconds: s32;
    padding: s32;
}

// timespec_get's base for the wall clock, UTC: the same number in both C
// libraries.
C_TIME_UTC :: 1;

// The time now in base, C_TIME_UTC, written to time as the seconds and
// nanoseconds since 1970-01-01T00:00:00Z; it gives base, or 0 when it
// couldn't. On Windows the UCRT has no timespec_get to link to (its
// <time.h> defines one inline over _timespec64_get), so the compiler links
// this declaration to _timespec64_get there, as a C program's call is
// (issue #161, spec 10.6).
c_timespec_get :: (time: *C_Timespec, base: s32) -> s32 #foreign libc "timespec_get";

// C's <math.h> of a double, each called by math.rig's procedure of the
// same name for float64 (c_sqrt by sqrt_float64). fmod's f only says it
// is for floating point, which _float64 says already, so c_fmod's is
// mod_float64. The results are the C library's: glibc's libm on Linux and
// the UCRT's on Windows, which may differ in the last bit, and on Windows a
// compiled program's (ucrtbase.dll's) may differ in it from an interpreted
// one's (the compiler's own copy, spec 10.8). A domain error, such as the
// square root of -1, gives NaN; C's errno, which would tell it apart,
// isn't reachable.
c_sqrt :: (x: float64) -> float64 #foreign libc "sqrt";
c_cbrt :: (x: float64) -> float64 #foreign libc "cbrt";
c_sin :: (x: float64) -> float64 #foreign libc "sin";
c_cos :: (x: float64) -> float64 #foreign libc "cos";
c_tan :: (x: float64) -> float64 #foreign libc "tan";
c_asin :: (x: float64) -> float64 #foreign libc "asin";
c_acos :: (x: float64) -> float64 #foreign libc "acos";
c_atan :: (x: float64) -> float64 #foreign libc "atan";

// The angle of the point (x, y): y comes first, as in C.
c_atan2 :: (y: float64, x: float64) -> float64 #foreign libc "atan2";

c_exp :: (x: float64) -> float64 #foreign libc "exp";
c_exp2 :: (x: float64) -> float64 #foreign libc "exp2";
c_log :: (x: float64) -> float64 #foreign libc "log";
c_log2 :: (x: float64) -> float64 #foreign libc "log2";
c_log10 :: (x: float64) -> float64 #foreign libc "log10";
c_pow :: (x: float64, y: float64) -> float64 #foreign libc "pow";
c_hypot :: (x: float64, y: float64) -> float64 #foreign libc "hypot";
c_floor :: (x: float64) -> float64 #foreign libc "floor";
c_ceil :: (x: float64) -> float64 #foreign libc "ceil";

// The nearest whole number, halves away from zero (2.5 is 3, -2.5 is -3),
// not to the even one as the processor's own rounding would.
c_round :: (x: float64) -> float64 #foreign libc "round";

c_trunc :: (x: float64) -> float64 #foreign libc "trunc";

// The remainder of x / y with x's sign, whatever y's: fmod(-5.5, 2) is
// -1.5.
c_fmod :: (x: float64, y: float64) -> float64 #foreign libc "fmod";

// C's <math.h> of a float, each called by math.rig's procedure of the same
// name for float32 (c_sqrtf by sqrt_float32, c_fmodf by mod_float32, named
// as mod_float64 is), and each taking and giving a float, rather than the
// double one with its result narrowed. Their results are the C library's,
// as the double ones' above are.
c_sqrtf :: (x: float32) -> float32 #foreign libc "sqrtf";
c_cbrtf :: (x: float32) -> float32 #foreign libc "cbrtf";
c_sinf :: (x: float32) -> float32 #foreign libc "sinf";
c_cosf :: (x: float32) -> float32 #foreign libc "cosf";
c_tanf :: (x: float32) -> float32 #foreign libc "tanf";
c_asinf :: (x: float32) -> float32 #foreign libc "asinf";
c_acosf :: (x: float32) -> float32 #foreign libc "acosf";
c_atanf :: (x: float32) -> float32 #foreign libc "atanf";

// The angle of the point (x, y): y comes first, as in C.
c_atan2f :: (y: float32, x: float32) -> float32 #foreign libc "atan2f";

c_expf :: (x: float32) -> float32 #foreign libc "expf";
c_exp2f :: (x: float32) -> float32 #foreign libc "exp2f";
c_logf :: (x: float32) -> float32 #foreign libc "logf";
c_log2f :: (x: float32) -> float32 #foreign libc "log2f";
c_log10f :: (x: float32) -> float32 #foreign libc "log10f";
c_powf :: (x: float32, y: float32) -> float32 #foreign libc "powf";

// On Windows the UCRT has no hypotf to link to (its <math.h> defines one
// inline over _hypotf), so the compiler links this declaration to _hypotf
// there, as a C program's call is (issue #148, spec 10.6).
c_hypotf :: (x: float32, y: float32) -> float32 #foreign libc "hypotf";

c_floorf :: (x: float32) -> float32 #foreign libc "floorf";
c_ceilf :: (x: float32) -> float32 #foreign libc "ceilf";

// The nearest whole number, halves away from zero, as c_round.
c_roundf :: (x: float32) -> float32 #foreign libc "roundf";

c_truncf :: (x: float32) -> float32 #foreign libc "truncf";

// The remainder of x / y with x's sign, as c_fmod.
c_fmodf :: (x: float32, y: float32) -> float32 #foreign libc "fmodf";

// Each system's own functions (the header says why they're apart). Each
// name is declared in both branches, with that system's signature, unless
// only one system has it.
#if OS == OS_WINDOWS {
    // Writes count bytes of data to the file descriptor, 2 for standard
    // error, at once, with no buffer of C's in between: the bytes it wrote,
    // or -1 when it couldn't. Its count is 32 bits, and so is its result.
    // A descriptor is in text mode unless set otherwise, so each \n is
    // written \r\n, as C's stdout writes it. It is what the runtime writes
    // a runtime error with (spec 10.5).
    c_write :: (descriptor: s32, data: *void, count: u32) -> s32 #foreign libc "_write";

    // Sleeps for about milliseconds: it works in the system's clock ticks,
    // about 15.6 ms apart, so the thread may wake up to a tick early, or
    // later, as its documentation says. Its count is a DWORD, whose
    // largest, 0xFFFFFFFF, is INFINITE, a sleep that never ends. It is
    // kernel32's, which every program links (spec 10.6) and the interpreter
    // looks up in kernel32.dll (spec 10.8).
    c_sleep :: (milliseconds: u32) #foreign libc "Sleep";

    // Basic's directories (directory.rig) go through kernel32's wide
    // calls, which take a path as UTF-16, so a name outside the ANSI code
    // page is reached. Like Sleep, each is kernel32's, which every program
    // links and the interpreter looks up in kernel32.dll (spec 10.6, 10.8),
    // so compiled and interpreted programs call the same functions.

    // WIN32_FIND_DATAW, an entry FindFirstFileW and FindNextFileW fill:
    // 592 bytes, aligned to 4. Basic reads its attributes and its name, up
    // to 259 UTF-16 units and a zero; times holds its three FILETIMEs
    // (made, last read, last written), each two u32s.
    C_Find_Data :: struct {
        attributes: u32;
        times: [6]u32;
        size_high: u32;
        size_low: u32;
        reserved0: u32;
        reserved1: u32;
        name: [260]u16;
        alternate_name: [14]u16;
    }

    // What GetFileAttributesW gives for a path it can't find or read, and
    // its bit for a directory.
    C_INVALID_FILE_ATTRIBUTES :: 4294967295;
    C_FILE_ATTRIBUTE_DIRECTORY :: 16;

    // GetLastError's numbers: FindFirstFileW found nothing to list (as in a
    // drive's root with no entries, which has no . or ..), and
    // FindNextFileW has no entry left.
    C_ERROR_FILE_NOT_FOUND :: 2;
    C_ERROR_NO_MORE_FILES :: 18;

    // The code page of UTF-8, and MultiByteToWideChar's flag that makes it
    // give 0 for bytes that aren't valid UTF-8, rather than turn them into
    // U+FFFD, which would name another path.
    C_CP_UTF8 :: 65001;
    C_MB_ERR_INVALID_CHARS :: 8;

    // Converts byte_count bytes in code_page to UTF-16 in wide, which has
    // room for wide_count units, and gives the units written; given a
    // wide_count of 0 it writes nothing and gives the units needed. 0 for
    // a byte_count of 0, and with C_MB_ERR_INVALID_CHARS for bytes that
    // aren't valid.
    c_multi_byte_to_wide_char :: (code_page: u32, flags: u32, bytes: *u8, byte_count: s32, wide: *u16, wide_count: s32) -> s32 #foreign libc "MultiByteToWideChar";

    // Converts UTF-16 to code_page in bytes, which has room for byte_count
    // of them, and gives the bytes written; a wide_count of -1 converts up
    // to the zero that ends wide, and writes and counts that zero too. In
    // UTF-8 an unpaired surrogate becomes U+FFFD. Preload declares the same
    // function as __wide_char_to_multi_byte, for the command line, and two
    // declarations of one C function are allowed (spec 7.6).
    c_wide_char_to_multi_byte :: (code_page: u32, flags: u32, wide: *u16, wide_count: s32, bytes: *u8, byte_count: s32, default_char: *u8, used_default: *s32) -> s32 #foreign libc "WideCharToMultiByte";

    // The attributes of what is at path, C_INVALID_FILE_ATTRIBUTES when
    // nothing is there or it can't be read.
    c_get_file_attributes_w :: (path: *u16) -> u32 #foreign libc "GetFileAttributesW";

    // Makes the directory path, whose parent must be there; not 0 when it
    // did, and 0 when it didn't, as when anything is at path already.
    // Basic passes null for security, the default.
    c_create_directory_w :: (path: *u16, security: *void) -> s32 #foreign libc "CreateDirectoryW";

    // Deletes the directory path, which must be empty; not 0 when it did.
    c_remove_directory_w :: (path: *u16) -> s32 #foreign libc "RemoveDirectoryW";

    // Starts a listing of the entries pattern matches, a directory's path
    // and \*, and fills data with the first: a handle for the next ones,
    // which c_find_close closes, or INVALID_HANDLE_VALUE (-1, compared as
    // cast(int) handle == -1) with GetLastError saying why.
    c_find_first_file_w :: (pattern: *u16, data: *C_Find_Data) -> *void #foreign libc "FindFirstFileW";

    // Fills data with the listing's next entry: not 0 when it did, and 0
    // at the end (GetLastError C_ERROR_NO_MORE_FILES) or on an error.
    c_find_next_file_w :: (handle: *void, data: *C_Find_Data) -> s32 #foreign libc "FindNextFileW";

    // Closes a listing's handle: not 0 when it did.
    c_find_close :: (handle: *void) -> s32 #foreign libc "FindClose";

    // The error of the last kernel32 call on this thread that failed. Read
    // right after the call, before anything else is called, it is that
    // call's, compiled and interpreted.
    c_get_last_error :: () -> u32 #foreign libc "GetLastError";
} else {
    // Writes count bytes of data to the file descriptor, 2 for standard
    // error, at once, with no buffer of C's in between: the bytes it wrote,
    // which may be fewer, or -1 when it couldn't. It is what the runtime
    // writes a runtime error with (spec 10.5).
    c_write :: (descriptor: s32, data: *void, count: u64) -> s64 #foreign libc "write";

    // Sleeps for the time request holds, at least: 0 when it slept it all,
    // or -1 when a signal woke it first, having written the time still
    // left to remaining. request's nanoseconds must be below 10^9, and its
    // padding 0 (C_Timespec's comment says why).
    c_nanosleep :: (request: *C_Timespec, remaining: *C_Timespec) -> s32 #foreign libc "nanosleep";

    // Basic's directories (directory.rig) go through POSIX's calls, which
    // take a path as bytes, so a UTF-8 path names what it says.

    // glibc's struct stat on x86-64, 144 bytes, which stat fills: Basic
    // reads only mode, st_mode, at offset 24; rest holds the fields after
    // it.
    C_Stat :: struct {
        device: u64;
        inode: u64;
        links: u64;
        mode: u32;
        rest: [116]u8;
    }

    // st_mode's bits for the kind of file, and their value for a directory.
    C_S_IFMT :: 61440;
    C_S_IFDIR :: 16384;

    // Where d_name, the entry's name ended by a zero, is in glibc's struct
    // dirent on x86-64: after d_ino (8 bytes), d_off (8), d_reclen (2) and
    // d_type (1).
    C_DIRENT_NAME_OFFSET :: 19;

    // Fills buffer with what is known of what is at path, following a
    // symbolic link: 0 when it could, -1 when nothing is there or it can't
    // be reached. libc.so.6 exports stat from glibc 2.33 on, older than the
    // 2.34 every program needs already.
    c_stat :: (path: *u8, buffer: *C_Stat) -> s32 #foreign libc "stat";

    // Makes the directory path, whose parent must be there, with the
    // permissions mode less the process's umask: 0 when it did, -1 when it
    // didn't, as when anything is at path already.
    c_mkdir :: (path: *u8, mode: u32) -> s32 #foreign libc "mkdir";

    // Deletes the directory path, which must be empty: 0 when it did.
    c_rmdir :: (path: *u8) -> s32 #foreign libc "rmdir";

    // Opens the directory path for listing: a DIR *, which c_closedir
    // closes, or null when it can't, as for a file or a missing path.
    c_opendir :: (path: *u8) -> *void #foreign libc "opendir";

    // The directory's next entry, the address of a struct dirent that
    // stays the C library's (its name at C_DIRENT_NAME_OFFSET), or null at
    // the end and on an error, which only errno tells apart.
    c_readdir :: (directory: *void) -> *u8 #foreign libc "readdir";

    // Closes a directory c_opendir opened: 0 when it did.
    c_closedir :: (directory: *void) -> s32 #foreign libc "closedir";

    // The address of this thread's errno, which a #foreign declaration
    // can't reach by its name, since in glibc it is a macro over this
    // call.
    c_errno_location :: () -> *s32 #foreign libc "__errno_location";
}
