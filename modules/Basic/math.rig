// Basic's math: the smaller and the larger of two numbers, a number kept
// within a range, a number's magnitude, π, and C's math functions. Rig had
// no overloading or generic procedures when they were written (spec 7.11;
// issue #230 makes Basic generic), so each is written once per type and
// named by it: int and u64 for integers, since every other integer type
// widens to one of them implicitly, and float32 and float64.
//
// The comparisons are written so that their edge cases are plain:
//
// - min and max return their first operand unless the second is strictly
//   smaller or larger. Every comparison with NaN is false, so a NaN first
//   operand comes back from both, and a NaN second one never does:
//   min_float64(nan, 1) is NaN, min_float64(1, nan) is 1. Of two equal
//   operands the first comes back, which matters only for 0.0 and -0.0,
//   the one pair of equal values that differ.
// - clamp tests the low bound first, so with low greater than high it gives
//   low for a value below low and high for any other.
// - abs of an integer is its negation when it is negative, and int's most
//   negative value has no positive int: its negation wraps to itself
//   (spec 5.8). abs of a float clears the sign bit, so -0.0 gives 0.0, and a
//   NaN stays a NaN.
//
// The second half of the file is π and C's math functions. PI and TAU are
// untyped float constants, so each takes either float type where it meets
// one, rounded to it; where it meets none, as in x := PI;, it becomes a
// float32, an untyped float's default (spec 3.12). C's functions of
// <math.h> come one procedure per type too, each only a call of libc.rig's
// c_ declaration and nothing else, so every edge value, -0.0, the
// infinities and NaN, goes to C and comes back as C gives it, and the
// results are the C library's (libc.rig says whose). The float64 ones call
// C's double functions (sqrt), and the float32 ones its float functions
// (sqrtf), each taking and giving a float32, rather than the float64 one
// with its result narrowed.
#load "libc.rig";

// The smaller of a and b; a when they're equal.
min_int :: (a: int, b: int) -> int {
    if b < a { return b; }
    return a;
}

// The larger of a and b; a when they're equal.
max_int :: (a: int, b: int) -> int {
    if b > a { return b; }
    return a;
}

// value, or low when value is below it, or high when value is above it.
clamp_int :: (value: int, low: int, high: int) -> int {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

// The magnitude of value. The most negative int, -9223372036854775808,
// comes back as itself, since its magnitude is one more than the largest
// int and the negation wraps.
abs_int :: (value: int) -> int {
    if value < 0 { return -value; }
    return value;
}

// The smaller of a and b; a when they're equal.
min_u64 :: (a: u64, b: u64) -> u64 {
    if b < a { return b; }
    return a;
}

// The larger of a and b; a when they're equal.
max_u64 :: (a: u64, b: u64) -> u64 {
    if b > a { return b; }
    return a;
}

// value, or low when value is below it, or high when value is above it.
clamp_u64 :: (value: u64, low: u64, high: u64) -> u64 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

// The smaller of a and b; a when they're equal or either is NaN.
min_float32 :: (a: float32, b: float32) -> float32 {
    if b < a { return b; }
    return a;
}

// The larger of a and b; a when they're equal or either is NaN.
max_float32 :: (a: float32, b: float32) -> float32 {
    if b > a { return b; }
    return a;
}

// value, or low when value is below it, or high when value is above it. A
// NaN value is neither, so it comes back as itself.
clamp_float32 :: (value: float32, low: float32, high: float32) -> float32 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

// The magnitude of value: its sign bit, the highest of its 32, cleared.
// So -0.0 gives 0.0, an infinity gives inf, and a NaN stays a NaN, where a
// test of value < 0 would leave -0.0 negative. A parameter has no address
// (spec 7.2), so the bits are reached through a local copy.
abs_float32 :: (value: float32) -> float32 {
    copy := value;
    bits := cast(*u32) *copy;
    bits.* &= 0x7FFF_FFFF;
    return copy;
}

// The smaller of a and b; a when they're equal or either is NaN.
min_float64 :: (a: float64, b: float64) -> float64 {
    if b < a { return b; }
    return a;
}

// The larger of a and b; a when they're equal or either is NaN.
max_float64 :: (a: float64, b: float64) -> float64 {
    if b > a { return b; }
    return a;
}

// value, or low when value is below it, or high when value is above it. A
// NaN value is neither, so it comes back as itself.
clamp_float64 :: (value: float64, low: float64, high: float64) -> float64 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

// The magnitude of value: its sign bit, the highest of its 64, cleared, as
// abs_float32 does.
abs_float64 :: (value: float64) -> float64 {
    copy := value;
    bits := cast(*u64) *copy;
    bits.* &= 0x7FFF_FFFF_FFFF_FFFF;
    return copy;
}

// π, the ratio of a circle's circumference to its diameter, and 2π, a
// whole turn in radians: the float64s nearest them, untyped so that a
// float32 takes them too.
PI :: 3.141592653589793;
TAU :: 6.283185307179586;

// The square root of x: -0.0 for -0.0, inf for inf, and NaN below 0.
sqrt_float64 :: (x: float64) -> float64 {
    return c_sqrt(x);
}

// The cube root of x, negative for a negative x: -2 for -8, and -inf for
// -inf.
cbrt_float64 :: (x: float64) -> float64 {
    return c_cbrt(x);
}

// The sine of an angle x in radians; -0.0 for -0.0, NaN for an infinity.
sin_float64 :: (x: float64) -> float64 {
    return c_sin(x);
}

// The cosine of an angle x in radians; NaN for an infinity.
cos_float64 :: (x: float64) -> float64 {
    return c_cos(x);
}

// The tangent of an angle x in radians; -0.0 for -0.0, NaN for an
// infinity. No float64 is exactly π/2, so it is never infinite.
tan_float64 :: (x: float64) -> float64 {
    return c_tan(x);
}

// The angle in radians whose sine is x, from -π/2 to π/2; -0.0 for -0.0,
// and NaN outside -1 to 1.
asin_float64 :: (x: float64) -> float64 {
    return c_asin(x);
}

// The angle in radians whose cosine is x, from 0 to π; NaN outside -1 to
// 1.
acos_float64 :: (x: float64) -> float64 {
    return c_acos(x);
}

// The angle in radians whose tangent is x, from -π/2 to π/2: -π/2 for
// -inf and π/2 for inf; -0.0 for -0.0.
atan_float64 :: (x: float64) -> float64 {
    return c_atan(x);
}

// The angle of the point (x, y) from the positive x axis, from -π to π, in
// the point's own quadrant, which atan of y / x can't tell: atan2(1, -1)
// is 3π/4. y comes first, as in C. On the axes the zeros' signs choose:
// (0, 0) is 0 and (-0.0, 0) is -0.0, (0, -0.0) is π and (-0.0, -0.0) is
// -π.
atan2_float64 :: (y: float64, x: float64) -> float64 {
    return c_atan2(y, x);
}

// e to the power x: 0 for -inf, and inf past float64's largest.
exp_float64 :: (x: float64) -> float64 {
    return c_exp(x);
}

// 2 to the power x: 0 for -inf, and inf past float64's largest.
exp2_float64 :: (x: float64) -> float64 {
    return c_exp2(x);
}

// The natural logarithm of x, to base e: -inf for 0 or -0.0, and NaN below
// 0.
log_float64 :: (x: float64) -> float64 {
    return c_log(x);
}

// The logarithm of x to base 2: -inf for 0 or -0.0, and NaN below 0.
log2_float64 :: (x: float64) -> float64 {
    return c_log2(x);
}

// The logarithm of x to base 10: -inf for 0 or -0.0, and NaN below 0.
log10_float64 :: (x: float64) -> float64 {
    return c_log10(x);
}

// base to the power exponent. A finite negative base has a real power only
// for a whole exponent, so another finite one gives NaN: pow(-8, 1.0 / 3)
// is NaN, not -2 (cbrt_float64 gives that). 0 and -0.0 to a negative odd
// power are inf and -inf. An exponent of 0, or a base of 1, gives 1, even
// when the other is NaN.
pow_float64 :: (base: float64, exponent: float64) -> float64 {
    return c_pow(base, exponent);
}

// The square root of x² + y², the length of the vector (x, y), without the
// overflow or underflow that squaring would give on the way: only a
// hypotenuse past float64's largest is inf. An infinite x or y gives inf,
// even when the other is NaN.
hypot_float64 :: (x: float64, y: float64) -> float64 {
    return c_hypot(x, y);
}

// The nearest whole number at or below x: -3 for -2.5, -1 for -0.5; -0.0
// for -0.0.
floor_float64 :: (x: float64) -> float64 {
    return c_floor(x);
}

// The nearest whole number at or above x: -2 for -2.5, and -0.0 for any
// value between -1 and 0.
ceil_float64 :: (x: float64) -> float64 {
    return c_ceil(x);
}

// The nearest whole number to x, halves away from zero, as C's round: 2.5
// is 3, -2.5 is -3, and -0.4 is -0.0. It rounds x itself, so the float64
// just below 0.5 gives 0, where the floor of x + 0.5 would give 1.
round_float64 :: (x: float64) -> float64 {
    return c_round(x);
}

// x without its fraction, toward zero: -2 for -2.7, -0.0 for -0.5.
trunc_float64 :: (x: float64) -> float64 {
    return c_trunc(x);
}

// The remainder of a / b, C's fmod: a less the whole multiple of b toward
// zero, so it has a's sign whatever b's (mod_float64(-5.5, 2) is -1.5, and
// mod_float64(-4, 2) is -0.0). NaN for a b of 0 or an infinite a, and a
// itself for an infinite b.
mod_float64 :: (a: float64, b: float64) -> float64 {
    return c_fmod(a, b);
}

// The square root of x, in float32 (C's sqrtf), as sqrt_float64.
sqrt_float32 :: (x: float32) -> float32 {
    return c_sqrtf(x);
}

// The cube root of x, in float32 (C's cbrtf), as cbrt_float64.
cbrt_float32 :: (x: float32) -> float32 {
    return c_cbrtf(x);
}

// The sine of an angle x in radians, in float32 (C's sinf), as sin_float64.
sin_float32 :: (x: float32) -> float32 {
    return c_sinf(x);
}

// The cosine of an angle x in radians, in float32 (C's cosf), as
// cos_float64.
cos_float32 :: (x: float32) -> float32 {
    return c_cosf(x);
}

// The tangent of an angle x in radians, in float32 (C's tanf), as
// tan_float64.
tan_float32 :: (x: float32) -> float32 {
    return c_tanf(x);
}

// The angle in radians whose sine is x, in float32 (C's asinf), as
// asin_float64.
asin_float32 :: (x: float32) -> float32 {
    return c_asinf(x);
}

// The angle in radians whose cosine is x, in float32 (C's acosf), as
// acos_float64.
acos_float32 :: (x: float32) -> float32 {
    return c_acosf(x);
}

// The angle in radians whose tangent is x, in float32 (C's atanf), as
// atan_float64.
atan_float32 :: (x: float32) -> float32 {
    return c_atanf(x);
}

// The angle of the point (x, y) from the positive x axis, y first, in
// float32 (C's atan2f), as atan2_float64.
atan2_float32 :: (y: float32, x: float32) -> float32 {
    return c_atan2f(y, x);
}

// e to the power x, in float32 (C's expf), as exp_float64: inf past
// float32's largest.
exp_float32 :: (x: float32) -> float32 {
    return c_expf(x);
}

// 2 to the power x, in float32 (C's exp2f), as exp2_float64: inf past
// float32's largest.
exp2_float32 :: (x: float32) -> float32 {
    return c_exp2f(x);
}

// The natural logarithm of x, in float32 (C's logf), as log_float64.
log_float32 :: (x: float32) -> float32 {
    return c_logf(x);
}

// The logarithm of x to base 2, in float32 (C's log2f), as log2_float64.
log2_float32 :: (x: float32) -> float32 {
    return c_log2f(x);
}

// The logarithm of x to base 10, in float32 (C's log10f), as
// log10_float64.
log10_float32 :: (x: float32) -> float32 {
    return c_log10f(x);
}

// base to the power exponent, in float32 (C's powf), as pow_float64.
pow_float32 :: (base: float32, exponent: float32) -> float32 {
    return c_powf(base, exponent);
}

// The square root of x² + y², in float32 (C's hypotf, the UCRT's _hypotf
// on Windows), as hypot_float64: only a hypotenuse past float32's largest
// is inf.
hypot_float32 :: (x: float32, y: float32) -> float32 {
    return c_hypotf(x, y);
}

// The nearest whole number at or below x, in float32 (C's floorf), as
// floor_float64.
floor_float32 :: (x: float32) -> float32 {
    return c_floorf(x);
}

// The nearest whole number at or above x, in float32 (C's ceilf), as
// ceil_float64.
ceil_float32 :: (x: float32) -> float32 {
    return c_ceilf(x);
}

// The nearest whole number to x, halves away from zero, in float32 (C's
// roundf), as round_float64: the float32 just below 0.5 gives 0.
round_float32 :: (x: float32) -> float32 {
    return c_roundf(x);
}

// x without its fraction, toward zero, in float32 (C's truncf), as
// trunc_float64.
trunc_float32 :: (x: float32) -> float32 {
    return c_truncf(x);
}

// The remainder of a / b with a's sign, in float32 (C's fmodf), as
// mod_float64.
mod_float32 :: (a: float32, b: float32) -> float32 {
    return c_fmodf(a, b);
}
