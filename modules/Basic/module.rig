// Basic: Rig's first library, written in Rig over a thin layer of C
// (libc.rig). It gathers what most programs need first: for now, the class
// and case of a byte, min, max, clamp and abs, π and C's math functions
// (roots, trigonometry, exponentials and logarithms, powers, rounding),
// copying, setting and comparing bytes in memory, numbers to text and back,
// views and copies of strings and their UTF-8, allocators (an arena and a
// pool, over Preload's heap), the context's temporary storage, a string
// builder, hash tables, sorting and searching, paths, files, directories,
// the clock, the calendar and sleeping, random numbers, the environment's
// variables, commands run by the system's shell, with or without their
// output, and the command-line arguments, formatted printing to standard
// output and standard error, to a string builder and to a string, assert,
// and a memory debugger, an allocator that records what it gives and
// reports what isn't freed. Whatever hands back memory it allocates takes
// it from the context's allocator unless it is given another (spec 7.10);
// talloc and tprint take theirs from the context's temporary storage
// instead. sprint's, print_to_builder's and print_error's scratch builders,
// the file and directory procedures' copies of a path for the system,
// list_directory's gathered names and sorting scratch, and
// run_command_with_output's gathered output come from the heap, and are
// freed before the call returns; the memory debugger's records come from
// the heap too, and stay until memory_debugger_free, and its report's
// sorted copy of them and the scratch it gives sort are the heap's, freed
// before it returns. sort's scratch memory and the environment's C copies
// come from the allocator the call is given, the context's unless another
// is. The command-line arguments are Preload's, saved before main's first
// line, and never freed.
//
// Basic ships with rig, so a program imports all of it through this file
// by the module's name (spec 2.14):
//
//     #import "Basic";
//
// A #load of this file by its path still works (from tests/run that is
// #load "../../modules/Basic/module.rig";), and with an #import too the
// files are read once. Either way every name Basic declares joins the
// program's one top level (spec 2.13): a program that imports Basic can't
// declare a procedure, struct or constant of a name Basic uses. README.md
// lists them.
//
// Each part loads the parts it uses itself, and a file is read once however
// often it is named, so the order here is only the reading order. It is
// README.md's, so the two can be read side by side: print.rig, which loads
// libc.rig, numbers.rig, string.rig and builder.rig, comes after the
// others, then assert.rig, and memory_debugger.rig, which writes through
// print.rig, comes last.
#load "libc.rig";
#load "char.rig";
#load "math.rig";
#load "memory.rig";
#load "numbers.rig";
#load "string.rig";
#load "allocators.rig";
#load "builder.rig";
#load "array.rig";
#load "table.rig";
#load "sort.rig";
#load "path.rig";
#load "wide.rig";
#load "file.rig";
#load "directory.rig";
#load "time.rig";
#load "random.rig";
#load "environment.rig";
#load "print.rig";
#load "assert.rig";
#load "memory_debugger.rig";
