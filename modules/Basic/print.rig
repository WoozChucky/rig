// Basic's print: writing to standard output, to a string builder, to a new
// string, or to standard error. Every byte written to standard output goes
// out through c_putchar, C's putchar (libc.rig), so it passes through C's
// own stdout buffer, and what a program prints with Basic and with C's
// printf comes out in the order it was printed, compiled and interpreted.
//
// A string is bytes, and they're written as they are: no encoding is
// checked or changed, so UTF-8 text prints as UTF-8. print_error and
// print_error_string, at the end, write to standard error instead: C's
// streams flushed, then c_write on descriptor 2, as the runtime writes a
// runtime error (spec 10.5), so what was printed before comes out before
// them even when standard output and standard error go to one place.
//
// Numbers are written into a buffer on the stack by numbers.rig and then
// printed, so printing to standard output never allocates.
//
// print_item writes a value of any type, through its type info (spec
// 3.16): it reads an Any by its description, as the type's kind says, and
// writes a struct's fields, a tagged union's member and an array's, a
// view's or a resizable array's elements each as an Any of its own.
//
// print, print_to_builder, sprint, tprint and print_error write a format
// whose {} placeholders take ..Any arguments, each written by print_item,
// through print_formatted, the one format walk. The helpers under them,
// print_or_append, print_quoted, print_item, print_enum and
// print_formatted, take a string builder (builder.rig) first, and a null
// one means standard output: Rig had no closures or generics when this was
// written (issue #230), so a null builder is how one walk writes to either.
// print passes null; print_to_builder takes a builder and stops the program
// on a null one. Written to standard output, nothing is allocated;
// print_to_builder and print_error write into a builder of their own on the
// heap, then append it to the one given or write it to standard error.
// sprint's string is from context.allocator, copied out of a builder of its
// own on the heap; tprint's is from the temporary storage, with no copy.
#load "libc.rig";
#load "numbers.rig";
#load "string.rig";
#load "builder.rig";

// Writes the bytes of s, and nothing else. An empty string, or a zeroed
// one whose data is null, writes nothing: its count is 0, so no byte is
// read.
print_string :: (s: string) {
    for s { c_putchar(it); }
}

// Writes the byte itself, not its number: print_byte(33) writes "!", and
// print_byte(10) ends a line.
print_byte :: (byte: u8) {
    c_putchar(byte);
}

// Writes true or false.
print_bool :: (value: bool) {
    if value {
        print_string("true");
    } else {
        print_string("false");
    }
}

// Writes value in base 10, with a "-" before a negative value.
print_int :: (value: int) {
    buffer : [INT_TEXT_MAX]u8;
    print_string(format_int(buffer, value, 10));
}

// Writes value with decimals digits after the point, from 0 to 9, as
// format_float does: "nan", "inf" and "-inf" included.
print_float :: (value: float64, decimals: int) {
    buffer : [FLOAT_TEXT_MAX]u8;
    print_string(format_float(buffer, value, decimals));
}

// Writes s and then a line feed, the one byte that ends a line. It is a
// line feed on Windows too: C's stdout there is in text mode and turns it
// into a carriage return and a line feed.
print_line :: (s: string) {
    print_string(s);
    print_byte(10); // line feed
}

// Writes the bytes of s to builder, or to standard output, through
// print_string, when builder is null. The helpers below, print_quoted,
// print_item and print_formatted, write through it, so each writes to
// either; print and print_to_builder each pick one.
print_or_append :: (builder: *String_Builder, s: string) {
    if builder == null {
        print_string(s);
    } else {
        append_string(builder, s);
    }
}

// Writes s in double quotes, as a string literal would hold it (spec
// 2.10): a line feed, a tab, a carriage return, a zero byte, a backslash
// and a double quote as their escapes, \n, \t, \r, \0, \\ and \", and any
// other byte below 32, and 127, as \x and two lowercase hex digits, as
// Rig's messages write a C name (spec 7.6), so no control byte reaches the
// terminal. Rig has no \x escape, but C does. The bytes from 128 are
// written as they are, so UTF-8 text stays readable.
//
// The bytes between two escapes are written as one run, so a builder takes
// one append for them rather than one for each byte. A string with null
// data and a count above 0 stops the program at the for, after the opening
// quote is written, with the language's null pointer dereference (spec 8.4).
print_quoted :: (builder: *String_Builder, s: string) {
    HEX :: "0123456789abcdef";
    print_or_append(builder, "\"");
    start := 0; // where the run not yet written begins
    // tests/run/basic_print_null_string.err names this line.
    for s {
        escape := "";
        if it == 10 { // line feed
            escape = "\\n";
        } else if it == 9 { // tab
            escape = "\\t";
        } else if it == 13 { // carriage return
            escape = "\\r";
        } else if it == 0 { // zero byte
            escape = "\\0";
        } else if it == "\\"[0] {
            escape = "\\\\";
        } else if it == "\""[0] {
            escape = "\\\"";
        }
        hex : [4]u8;
        if escape.count == 0 && (it < 32 || it == 127) { // 127 is delete
            hex[0] = "\\"[0];
            hex[1] = "x"[0];
            hex[2] = HEX[it / 16];
            hex[3] = HEX[it % 16];
            view : []u8 = hex;
            escape = cast(string) view;
        }
        if escape.count > 0 {
            print_or_append(builder, slice(s, start, it_index - start));
            print_or_append(builder, escape);
            start = it_index + 1;
        }
    }
    print_or_append(builder, slice(s, start, s.count - start));
    print_or_append(builder, "\"");
}

// Writes the value item holds, to builder, or to standard output when
// builder is null, by its type's description (spec 3.16), whose tag says
// how to read the bytes at item.value_pointer:
//
//   - An integer, by its size and sign (print_read_integer), in base 10:
//     a signed one by format_int, an unsigned one by format_u64, its 64
//     bits read as a u64, since a u64 above int's largest has no int. A u8
//     is a number, not a byte.
//   - A float, a float32 widened to a float64, with 6 decimals as
//     format_float writes them, and then its trailing zeros cut down to
//     one: 1.5, 3.0, -0.0, nan, inf. So a magnitude below 0.0000005 is 0.0
//     or -0.0.
//   - A bool, true or false.
//   - A string, its bytes; when nested, in quotes, through print_quoted.
//   - A pointer or a procedure value, null or its address in lowercase hex
//     after 0x. A pointer isn't followed, so no cycle of pointers is met,
//     and a *u8 is a pointer, not a C string. Interpreted, a Rig
//     procedure's address is the interpreter's stand-in (spec 10.8).
//   - A struct, {name = value, ...}, its fields in order, and {} for one
//     with none. An Any field is the value it holds, written as the field
//     would be. An anonymous member (spec 3.19) is its value alone, with
//     no name: {kind = 1, union(4 bytes)}, {n = 1, {a = 2, b = 3}}.
//   - A union, by its size alone, union(8 bytes), never its members:
//     which one holds the value is the program's to know.
//   - A tagged union (spec 3.20), by the member its tag says it holds: a
//     dot and the member's name, then its value in parentheses, nested,
//     .circle({r = 2.0}), .text("hi"), or nothing more for a void member,
//     .empty. A tag no member has, as C may write, is (tag 7), the number
//     read by the tag type's sign, and no member is read.
//   - An array, a view or a resizable array, [value, ...]; [] for one with
//     no elements, or a view or resizable array whose count is 0 or less.
//   - An enum, by its members' names, through print_enum: FREE, or
//     VISIBLE | GLOWING for an enum_flags.
//
// nested says the value is inside a struct, a tagged union or an array of
// any kind, or among the arguments a format leaves over, {!EXTRA: ...},
// where a string is quoted so that its bytes can't be mistaken for the
// punctuation around it. Fields, members and elements are written by
// calling print_item again, nested, each made into an Any of its own: a
// field's type at the struct's address plus the field's offset, a tagged
// union's member's type at the union's address plus the member's offset,
// an element's type at its place in the data.
//
// What no conversion to Any makes: a zeroed Any, whose type is null, as a
// zeroed struct's Any field is, writes null, as a zeroed pointer does; a
// description of void, which only an Any made by hand can hold, writes
// void; and a tag that isn't one of the eleven writes nothing.
//
// A pointer isn't followed, but a view's data (a resizable array's too)
// and an Any's value_pointer are, so a view or an Any that reaches a value
// it is part of makes a cycle: a struct whose view field views an array
// holding it (nodes[0].kids = nodes;), the struct an Any is a field of
// (h.a = h;), the array it is an element of (arr[0] = arr;), or anything
// that contains it deeper down. Writing that one recurses until the stack
// runs out, as recursion that never ends does.
print_item :: (builder: *String_Builder, item: Any, nested: bool) {
    t := item.type;
    p := item.value_pointer;
    if t == null {
        print_or_append(builder, "null");
    } else if t.tag == .INTEGER {
        signed := (cast(*Type_Info_Integer) t).signed;
        value := print_read_integer(p, t.size, signed);
        buffer : [INT_TEXT_MAX]u8;
        if signed {
            print_or_append(builder, format_int(buffer, value, 10));
        } else {
            print_or_append(builder, format_u64(buffer, cast,trunc(u64) value, 10));
        }
    } else if t.tag == .FLOAT {
        value : float64 = 0;
        if t.size == 4 {
            value = (cast(*float32) p).*;
        } else {
            value = (cast(*float64) p).*;
        }
        buffer : [FLOAT_TEXT_MAX]u8;
        text := format_float(buffer, value, 6);
        // nan, inf and -inf have no point, and so no decimals to cut. A
        // number has a digit on each side of its point, so the last of
        // the zeros cut is the one right after the point, which stays.
        if find_byte(text, "."[0]) >= 0 {
            while text[text.count - 1] == "0"[0] && text[text.count - 2] != "."[0] {
                text.count -= 1;
            }
        }
        print_or_append(builder, text);
    } else if t.tag == .BOOL {
        if (cast(*bool) p).* {
            print_or_append(builder, "true");
        } else {
            print_or_append(builder, "false");
        }
    } else if t.tag == .STRING {
        s := (cast(*string) p).*;
        if nested {
            print_quoted(builder, s);
        } else {
            print_or_append(builder, s);
        }
    } else if t.tag == .POINTER || t.tag == .PROCEDURE {
        // Both are an address, 8 bytes, read as a u64 to be written.
        address := (cast(*u64) p).*;
        if address == 0 {
            print_or_append(builder, "null");
        } else {
            buffer : [INT_TEXT_MAX]u8;
            print_or_append(builder, "0x");
            print_or_append(builder, format_u64(buffer, address, 16));
        }
    } else if t.tag == .VOID {
        print_or_append(builder, "void");
    } else if t.tag == .STRUCT {
        // An Any is a struct too, but it's written as the value it holds:
        // one description per type, so its description's address says
        // it's an Any.
        if t == type_info(Any) {
            print_item(builder, (cast(*Any) p).*, nested);
            return;
        }
        s := cast(*Type_Info_Struct) t;
        // A union is written by its size alone: which member holds the
        // value is the program's to know (spec 3.19), and writing another
        // would read its bytes as what they aren't: a string's or a view's
        // data pointer may be an integer's bits, null or pointing nowhere.
        if s.is_union {
            buffer : [INT_TEXT_MAX]u8;
            print_or_append(builder, "union(");
            print_or_append(builder, format_int(buffer, t.size, 10));
            print_or_append(builder, " bytes)");
            return;
        }
        print_or_append(builder, "{");
        for s.members {
            if it_index > 0 { print_or_append(builder, ", "); }
            // An anonymous member has no name to write: just its value.
            if it.name.count > 0 {
                print_or_append(builder, it.name);
                print_or_append(builder, " = ");
            }
            print_item(builder, Any.{it.type, cast(*u8) p + it.offset}, true);
        }
        print_or_append(builder, "}");
    } else if t.tag == .TAGGED_UNION {
        // Only the member the tag names is read: another's bytes may be
        // what it isn't, as a union's are. A tag of none is a number,
        // written as an integer is.
        u := cast(*Type_Info_Tagged_Union) t;
        tag := cast(*u8) p + u.tag_offset;
        signed := (cast(*Type_Info_Integer) u.tag_type).signed;
        index := print_read_integer(tag, u.tag_type.size, signed);
        if index < 0 || index >= u.members.count {
            print_or_append(builder, "(tag ");
            print_item(builder, Any.{u.tag_type, tag}, false);
            print_or_append(builder, ")");
            return;
        }
        member := u.members[index];
        print_or_append(builder, ".");
        print_or_append(builder, member.name);
        if member.type.tag != .VOID {
            print_or_append(builder, "(");
            print_item(builder, Any.{member.type, cast(*u8) p + member.offset}, true);
            print_or_append(builder, ")");
        }
    } else if t.tag == .ARRAY {
        a := cast(*Type_Info_Array) t;
        data := cast(*u8) p;
        count := a.count;
        if a.array_kind != .FIXED {
            // A view, or a resizable array, which starts as a view does, is
            // a count and a data pointer, whatever its elements, so it's
            // read as a []u8. When its count says it has elements, its
            // first is reached before any of it is written, so null data
            // stops the program here, with the language's null pointer
            // dereference (spec 8.4), as indexing it would, not after "[".
            view := (cast(*[]u8) p).*;
            count = view.count;
            // tests/run/basic_print_null_view.err names this line.
            if count > 0 { first := *view[0]; }
            data = view.data;
        }
        print_or_append(builder, "[");
        for 0..count - 1 {
            if it > 0 { print_or_append(builder, ", "); }
            print_item(builder, Any.{a.element_type, data + it * a.element_type.size}, true);
        }
        print_or_append(builder, "]");
    } else if t.tag == .ENUM {
        print_enum(builder, cast(*Type_Info_Enum) t, p);
    }
}

// Writes the enum value at p, described by e (spec 3.16, 3.18), to
// builder, or to standard output when builder is null. The value is read
// at its integer type's size and sign into the 64 bits a member's value
// has in e.values (print_read_integer), and written:
//
//   - When a member has it, as the name of the first that does, in
//     declaration order: of two members of one value, the first.
//   - In an enum_flags, when none has it, as the members it's made of, in
//     order, joined by " | ": each member that isn't 0 and whose bits are
//     all among the value's bits not yet written, which it then writes.
//     Any bits left come last, as a number read as unsigned at the type's
//     width, and so is a value no member's bits are in, alone: cast(Look) 9
//     is VISIBLE | 8, and in an enum_flags s8 of A and B, cast(F) -1 is
//     A | B | 252 and cast(F) -128 is 128. A value of no bits, when no
//     member is 0, is 0.
//   - In an enum, as its number in base 10, by its integer type's sign, as
//     an integer is: a value no member has is allowed (cast(Mode) 7 is 7).
print_enum :: (builder: *String_Builder, e: *Type_Info_Enum, p: *void) {
    signed := (cast(*Type_Info_Integer) e.underlying).signed;
    size := e.size;
    value := print_read_integer(p, size, signed);
    for e.values {
        if it == value {
            print_or_append(builder, e.names[it_index]);
            return;
        }
    }
    left := value; // the bits no member's name has written yet
    if e.is_flags {
        wrote := false;
        for e.values {
            if it != 0 && (left & it) == it {
                if wrote { print_or_append(builder, " | "); }
                print_or_append(builder, e.names[it_index]);
                left &= ~it;
                wrote = true;
            }
        }
        if wrote && left == 0 { return; }
        if wrote { print_or_append(builder, " | "); }
        // The bits left, all of them when no member's name was written,
        // are bits, not a number with a sign: unsigned, at the type's
        // width.
        bits := cast,trunc(u64) left;
        if size < 8 { bits &= (cast(u64) 1 << (size * 8)) - 1; }
        buffer : [INT_TEXT_MAX]u8;
        print_or_append(builder, format_u64(buffer, bits, 10));
        return;
    }
    print_item(builder, Any.{e.underlying, p}, false);
}

// The integer at p of size bytes (1, 2, 4 or 8), signed or not, as 64 bits:
// sign-extended from a signed one, zero-extended from an unsigned one, and
// 8 bytes as they are, so a u64 above s64's largest reads negative, as a
// member's value in a Type_Info_Enum's values does. print_item reads an
// integer through it, and print_enum an enum's value. Its name starts with
// print_, as the other helpers here do, so it leaves a program that imports
// Basic its own read_integer (tests/run/basic_print_own_names.rig).
print_read_integer :: (p: *void, size: int, signed: bool) -> s64 {
    if size == 8 { return (cast(*s64) p).*; }
    if signed {
        if size == 1 { return (cast(*s8) p).*; }
        if size == 2 { return (cast(*s16) p).*; }
        return (cast(*s32) p).*;
    }
    if size == 1 { return (cast(*u8) p).*; }
    if size == 2 { return (cast(*u16) p).*; }
    return (cast(*u32) p).*;
}

// Writes format to builder, or to standard output when builder is null,
// with each {} in it replaced by the next of args, written as print_item
// writes it at the top, so a string is its bytes. The format is read left
// to right:
//
//   - {} takes the next argument, or writes {!MISSING} when none is left.
//   - {{ writes {, and }} writes }.
//   - Any other { begins a placeholder this version doesn't know, {x} or
//     {:x}: the bytes from it to the next }, or to the format's end when
//     there's none, are written as {!BAD}, and take no argument. So
//     {a{b} is one {!BAD}, and a { at the format's very end is {!BAD} too.
//   - A } on its own is written as it is, so }}} is }}, and {{} is { and
//     then a lone }.
//   - Every other byte is written as it is, a run of them, up to the next
//     brace, at once.
//
// The arguments left over once the format ends are written after it, a
// space and then {!EXTRA: 4, "x"}: each nested, as inside a struct, so a
// string is quoted, with a comma and a space between them. The format is a
// value the compiler doesn't read, as C's isn't (spec 7.6), so a count that
// doesn't match writes a marker rather than stopping the program. An
// argument's own braces are its bytes, not a format, written as they are.
print_formatted :: (builder: *String_Builder, format: string, args: []Any) {
    OPEN :: "{";
    CLOSE :: "}";
    next := 0; // the argument the next {} takes
    i := 0;
    while i < format.count {
        // The byte after this one, or 0 at the format's last byte, which
        // no brace is.
        after : u8 = 0;
        if i + 1 < format.count { after = format[i + 1]; }
        if format[i] == OPEN[0] && after == OPEN[0] {
            print_or_append(builder, OPEN);
            i += 2;
        } else if format[i] == OPEN[0] && after == CLOSE[0] {
            if next < args.count {
                print_item(builder, args[next], false);
                next += 1;
            } else {
                print_or_append(builder, "{!MISSING}");
            }
            i += 2;
        } else if format[i] == OPEN[0] {
            print_or_append(builder, "{!BAD}");
            i += 1;
            while i < format.count && format[i] != CLOSE[0] { i += 1; }
            i += 1; // past the }, or past the end, which ends the loop
        } else if format[i] == CLOSE[0] && after == CLOSE[0] {
            print_or_append(builder, CLOSE);
            i += 2;
        } else if format[i] == CLOSE[0] {
            print_or_append(builder, CLOSE);
            i += 1;
        } else {
            start := i;
            while i < format.count && format[i] != OPEN[0] && format[i] != CLOSE[0] { i += 1; }
            print_or_append(builder, slice(format, start, i - start));
        }
    }
    if next < args.count {
        print_or_append(builder, " {!EXTRA: ");
        for next..args.count - 1 {
            if it > next { print_or_append(builder, ", "); }
            print_item(builder, args[it], true);
        }
        print_or_append(builder, "}");
    }
}

// Writes format to standard output with its {}s replaced by args, as
// print_formatted says: print("{} is {}\n", name, age). Each argument is
// any value, gathered as an Any (spec 5.10, 3.16), and a []Any already
// made is forwarded with .., as in print(format, ..args); passed without
// it, it is one argument, a view. Like all this file writes to standard
// output, it writes as it goes, through c_putchar, and allocates nothing.
print :: (format: string, args: ..Any) {
    print_formatted(null, format, args);
}

// Appends what print would write to builder (builder.rig), whose memory
// grows as append_string's does, and writes nothing to standard output.
//
// The format and the arguments may view the builder's own text, as
// append_string's s may: all is written into a builder of its own first,
// on the heap, and then appended at once, so nothing of builder moves
// while it is read. The heap's memory is freed before it returns.
//
// Like append_string, it takes loc, after its '..' arguments, where only
// its default ever fills it (spec 7.2): the caller's place, which it passes
// to the append_string call below, so the place builder's allocator sees
// is the caller's, not this file's line. The helpers above that write into
// a builder they are given take none, so theirs is print_or_append's
// append_string call.
print_to_builder :: (builder: *String_Builder, format: string, args: ..Any, loc: Source_Code_Location = #caller_location) {
    // A null builder is standard output to print_formatted, so it's read
    // here first, whatever the format, to stop the program with a null
    // pointer dereference (spec 8.4) rather than print to standard output.
    // tests/run/basic_print_null_builder.err names this line.
    count := builder.count;
    scratch : String_Builder;
    builder_init(*scratch, HEAP_ALLOCATOR);
    print_formatted(*scratch, format, args);
    text : string;
    text.data = scratch.data;
    text.count = scratch.count;
    append_string(builder, text, loc);
    builder_free(*scratch);
}

// What print would write, as a string in memory from context.allocator,
// which the caller gives back with free(s.data): sprint("{}-{}", "a", 7) is
// "a-7". It is written into a builder of its own on the heap first, as
// print_to_builder's is, and then copied out by builder_to_string, so the
// context's allocator gives one allocation, the size of the text, and the
// heap's memory is freed before it returns. Nothing written gives the
// zeroed string, count 0 and data null, and allocates nothing.
//
// Like print_to_builder, it takes loc after its '..' arguments and passes
// it to builder_to_string: the context's allocator sees the caller's place.
sprint :: (format: string, args: ..Any, loc: Source_Code_Location = #caller_location) -> string {
    scratch : String_Builder;
    builder_init(*scratch, HEAP_ALLOCATOR);
    print_formatted(*scratch, format, args);
    text := builder_to_string(*scratch, context.allocator, loc);
    builder_free(*scratch);
    return text;
}

// What print would write, as a string in the context's temporary storage
// (TEMPORARY_ALLOCATOR), which goes back with the rest of it at the next
// reset, or when the storage goes back to a mark taken before it
// (allocators.rig): print_line(tprint("{} + {} = {}", 1, 2, 3)). It is
// written into a builder on the temporary storage, whose text is returned as
// it is, with no copy: while the builder's memory is the storage's last
// allocation, it grows in place. Nothing written gives the zeroed string,
// count 0 and data null, and allocates nothing.
tprint :: (format: string, args: ..Any) -> string {
    builder : String_Builder;
    builder_init(*builder, TEMPORARY_ALLOCATOR);
    print_formatted(*builder, format, args);
    text : string;
    text.data = builder.data;
    text.count = builder.count;
    return text;
}

// Writes the bytes of s to standard error, as they are, and nothing else.
// What was printed to standard output before, by Basic or by C's printf,
// comes out first: standard output into a pipe or a file is buffered and
// standard error isn't, so C's streams are flushed first, as the runtime
// flushes them before a runtime error (spec 8.1). Then the bytes go to
// descriptor 2 with c_write (libc.rig), the call the runtime writes a
// runtime error with (spec 10.5), on both systems. Not through C's stderr:
// on Windows it is a call, __acrt_iob_func(2), but in glibc a data symbol,
// which #foreign can't declare, and a second stream over descriptor 2
// (fdopen's) would have a buffer of its own to keep and flush.
//
// The bytes go in calls of at most 2^30 bytes, since Windows' count and
// result are 32 bits, each going on from where the last stopped, as a call
// may write fewer bytes than it was given. When one writes none or fails,
// the rest is dropped: there's nowhere left to say so. On Linux a call a
// signal stopped before it wrote anything (C_EINTR) is made again, and
// isn't a failure. An empty string, or a zeroed one, writes nothing,
// though C's streams are flushed all the same.
print_error_string :: (s: string) {
    c_fflush(null);
    MOST :: 1 << 30; // the most bytes one call is given
    written := 0;
    while written < s.count {
        count := s.count - written;
        if count > MOST { count = MOST; }
        wrote := 0;
        #if OS == .WINDOWS {
            wrote = cast(int) c_write(2, s.data + written, cast(u32) count);
        } else {
            wrote = cast(int) c_write(2, s.data + written, cast(u64) count);
            if wrote < 0 && c_errno_location().* == C_EINTR { continue; }
        }
        if wrote <= 0 { return; }
        written += wrote;
    }
}

// Writes to standard error what print would write to standard output:
// print_error("can't read {}\n", path). The text is formatted into a
// builder of its own on the heap first, and then given to
// print_error_string whole, so a line goes out in one call rather than a
// piece at a time, and comes out after what was printed before it, as
// print_error_string says. The heap's memory is freed before it returns.
//
// It takes its memory from the heap only, never from context.allocator, so
// an arena or a memory debugger the program set sees nothing of an error
// message, and it takes no loc: no allocator it is given would see one.
print_error :: (format: string, args: ..Any) {
    scratch : String_Builder;
    builder_init(*scratch, HEAP_ALLOCATOR);
    defer builder_free(*scratch);
    print_formatted(*scratch, format, args);
    text : string;
    text.data = scratch.data;
    text.count = scratch.count;
    print_error_string(text);
}
