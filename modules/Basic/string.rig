// Basic's strings: comparing, finding, trimming, slicing and splitting, the
// copy C reads, ended by a zero, and the copies made by joining, replacing,
// repeating and changing case.
//
// A string is a view, a count and a pointer to bytes (spec 3.8), so the
// procedures that cut strings up return views into the string they were
// given: they copy nothing and allocate nothing, and each view lives as
// long as the bytes it views. The procedures that copy, to_c_string, join,
// replace, repeat, to_upper_copy and to_lower_copy, take their memory from
// the allocator they are given, and the caller gives it back there. Indexes
// and counts are in bytes, and the bytes are compared as they are,
// unsigned, with no knowledge of UTF-8, so a search for an ASCII byte never
// lands inside a UTF-8 character, whose bytes are all from 128 up.
//
// A zeroed string, with count 0 and data null, is the empty string
// everywhere here: its count of 0 stops every loop before a byte is read,
// and a view of it starts at offset 0, so its null data is never moved.
//
// Every view returned is the string given or a view cut out of it by
// slice, which clamps what it is asked for to the string it is given, so no
// procedure here can return a view that reaches outside its string.
//
// The strings that join, replace, repeat and the case copies give are
// always copies, even when nothing in them changed, so the caller can
// always free them. Each one's size is worked out first, so the allocator
// is asked once, and an empty result is the zeroed string, which asks it
// nothing, as builder_to_string's empty text does: freeing it gives the
// allocator nothing it didn't give. A size past int's largest, which would
// wrap, asks for nothing either, since no memory holds that many bytes, and
// neither it nor an allocator with no memory to give is told apart from an
// empty result: each gives the zeroed string.
#load "char.rig";
#load "memory.rig";
#load "allocators.rig";

// Whether a and b hold the same bytes, as a == b: the same count, and the
// same byte at every index. It is here as a named procedure, so that a
// procedure value of type (string, string) -> bool can name it.
strings_equal :: (a: string, b: string) -> bool {
    return a == b;
}

// Compares a and b byte by byte: -1 when a sorts first, 1 when b does, and
// 0 when they're equal. The first byte that differs decides, compared
// unsigned, so "é" (0xC3 0xA9) sorts after "z" (0x7A). When one is a prefix
// of the other, no byte differs, and the shorter sorts first.
compare_strings :: (a: string, b: string) -> int {
    shorter := a.count;
    if b.count < shorter { shorter = b.count; }
    order := compare_memory(a.data, b.data, shorter);
    if order != 0 { return order; }
    if a.count < b.count { return -1; }
    if a.count > b.count { return 1; }
    return 0;
}

// The index of the first byte of s equal to byte, or -1 when there's none.
find_byte :: (s: string, byte: u8) -> int {
    for s {
        if it == byte { return it_index; }
    }
    return -1;
}

// The index of the last byte of s equal to byte, or -1 when there's none.
find_byte_from_end :: (s: string, byte: u8) -> int {
    i := s.count;
    while i > 0 {
        i -= 1;
        if s[i] == byte { return i; }
    }
    return -1;
}

// The index at which needle first occurs in s, or -1 when it doesn't. The
// empty needle occurs everywhere, so it is found at 0, in the empty string
// too. Each place needle could start, from 0 to the last that leaves room
// for all of it, is compared with it in turn.
find_string :: (s: string, needle: string) -> int {
    if needle.count > s.count { return -1; }
    for i: 0..s.count - needle.count {
        if compare_memory(s.data + i, needle.data, needle.count) == 0 { return i; }
    }
    return -1;
}

// The index at which needle last occurs in s, or -1 when it doesn't. The
// empty needle is found at s.count, past the last byte, as the last of the
// places it occurs. The places are tried from the last down, so the first
// match is the answer.
find_string_from_end :: (s: string, needle: string) -> int {
    if needle.count > s.count { return -1; }
    i := s.count - needle.count;
    while i >= 0 {
        if compare_memory(s.data + i, needle.data, needle.count) == 0 { return i; }
        i -= 1;
    }
    return -1;
}

// Whether s begins with prefix. Every string begins with "".
starts_with :: (s: string, prefix: string) -> bool {
    if prefix.count > s.count { return false; }
    return compare_memory(s.data, prefix.data, prefix.count) == 0;
}

// Whether s ends with suffix. Every string ends with "".
ends_with :: (s: string, suffix: string) -> bool {
    if suffix.count > s.count { return false; }
    return compare_memory(s.data + (s.count - suffix.count), suffix.data, suffix.count) == 0;
}

// s without the white space (is_space) at its start. A string of nothing
// but white space gives an empty view at its end.
trim_left :: (s: string) -> string {
    start := 0;
    while start < s.count && is_space(s[start]) { start += 1; }
    return advance(s, start);
}

// s without the white space (is_space) at its end.
trim_right :: (s: string) -> string {
    count := s.count;
    while count > 0 && is_space(s[count - 1]) { count -= 1; }
    return slice(s, 0, count);
}

// s without the white space (is_space) at either end.
trim :: (s: string) -> string {
    return trim_right(trim_left(s));
}

// The count bytes of s from index start on, clamped so the view never
// leaves s: start is clamped to 0..s.count, and then count to
// 0..s.count - start, what is left from start. So slice("hello", 3, 10) is
// "lo", and a start past the end or a negative count gives an empty view.
//
// The start is clamped before the count, so neither limit can overflow:
// first, the start clamped, ends within 0..s.count, so s.count - first
// can't wrap. A zeroed string's start is clamped to 0, and its null data is
// moved by nothing.
slice :: (s: string, start: int, count: int) -> string {
    first := start;
    if first < 0 { first = 0; }
    if first > s.count { first = s.count; }
    length := count;
    if length < 0 { length = 0; }
    if length > s.count - first { length = s.count - first; }

    view := s;
    view.data = s.data + first;
    view.count = length;
    return view;
}

// s without its first amount bytes, clamped as slice is: an amount past the
// end gives an empty view, and a negative one gives s.
advance :: (s: string, amount: int) -> string {
    return slice(s, amount, s.count);
}

// Splits s at each byte equal to separator, writing the pieces between them
// into parts in order, and returns how many it wrote. Separators side by
// side, or at either end, make empty pieces: "a,,b" is "a", "" and "b", and
// "" is one empty piece. When parts runs out, its last element holds the
// rest of s, separators and all, as Go's SplitN does, so no byte is lost:
// "a,b,c" into two parts is "a" and "b,c". An empty parts gets nothing, and
// 0 comes back.
split :: (s: string, separator: u8, parts: []string) -> int {
    if parts.count <= 0 { return 0; }
    written := 0;
    rest := s;
    while written < parts.count - 1 {
        at := find_byte(rest, separator);
        if at < 0 { break; }
        parts[written] = slice(rest, 0, at);
        written += 1;
        rest = advance(rest, at + 1);
    }
    parts[written] = rest;
    return written + 1;
}

// Splits s at the first byte equal to separator: whether there is one, the
// bytes before it and the bytes after it, without it. Without a separator,
// it is false, s and an empty view at the end of s, so that every result is
// a view into s. So "key=value=x" at "=" is true, "key" and "value=x".
split_from_left :: (s: string, separator: u8) -> bool, string, string {
    at := find_byte(s, separator);
    if at < 0 { return false, s, advance(s, s.count); }
    return true, slice(s, 0, at), advance(s, at + 1);
}

// A copy of s that C can read: s.count + 1 bytes from allocator, the bytes
// of s and then a zero, which is where C finds a string's end. A Rig string
// need not have a zero after its bytes: a literal does (spec 3.8), but a
// view of part of a string has the rest of the string there, and other
// strings have whatever follows them, so one bound for C is copied first.
// The caller gives the copy back with free(p, allocator) once C is done
// with it.
//
// It is null when the allocator has no memory to give. A zeroed string
// gives a lone zero, C's empty string, and no byte is read through its
// null data. A zero inside s is copied as it is, so C sees the string end
// there. A caller handing C a name, such as a file's, refuses a string
// with a zero in it first (find_byte(s, 0) >= 0), rather than have C use a
// shorter name, another file's.
to_c_string :: (s: string, allocator: Allocator) -> *u8 {
    c := cast(*u8) alloc(s.count + 1, allocator);
    if c == null { return null; }
    copy_memory(c, s.data, s.count);
    c[s.count] = 0;
    return c;
}

// Whether sub occurs in s. Every string contains "", the empty and the
// zeroed string too, as find_string finds it at 0.
contains :: (s: string, sub: string) -> bool {
    return find_string(s, sub) >= 0;
}

// How many times sub occurs in s, counted from the left without overlap,
// as replace replaces them: each search starts after the last match, so
// count_of("aaaa", "aa") is 2, not 3. The empty sub would match at every
// place, and between each byte, so it is taken to match nothing, and gives
// 0.
count_of :: (s: string, sub: string) -> int {
    if sub.count == 0 { return 0; }
    count := 0;
    rest := s;
    at := find_string(rest, sub);
    while at >= 0 {
        count += 1;
        rest = advance(rest, at + sub.count);
        at = find_string(rest, sub);
    }
    return count;
}

// The parts one after another, with separator between each two, in memory
// from allocator, which the caller gives back with
// free(result.data, allocator). An empty part still has its separators, so
// "" and "" joined by "-" give "-", and a part alone has none.
//
// The result is always a copy, even of one part alone, so the caller can
// always free it. An empty result, of no parts or of empty parts and an
// empty separator, is the zeroed string, count 0 and data null, which
// allocates nothing, as builder_to_string's empty text does, and freeing
// it gives the allocator nothing. When the allocator has no memory to give,
// the result is the zeroed string too.
//
// The size is worked out first, so the memory is asked for once. Counts
// added up past int's largest would wrap to a smaller size than the bytes
// copied into it, and no memory holds that many bytes anyway, so then
// nothing is asked for, and the result is the zeroed string.
join :: (parts: []string, separator: string, allocator: Allocator) -> string {
    LARGEST :: 9223372036854775807; // int's largest value
    joined : string;
    if parts.count <= 0 { return joined; }

    count := 0;
    for parts {
        if it.count > LARGEST - count { return joined; }
        count += it.count;
    }
    // parts.count - 1 separators, checked by division so the product can't
    // wrap.
    gaps := parts.count - 1;
    if gaps > 0 && separator.count > (LARGEST - count) / gaps { return joined; }
    count += separator.count * gaps;
    if count == 0 { return joined; }
    data := cast(*u8) alloc(count, allocator);
    if data == null { return joined; }

    at := 0;
    for parts {
        if it_index > 0 {
            copy_memory(data + at, separator.data, separator.count);
            at += separator.count;
        }
        copy_memory(data + at, it.data, it.count);
        at += it.count;
    }
    joined.data = data;
    joined.count = count;
    return joined;
}

// A copy of s with every occurrence of old replaced by new, in memory from
// allocator, which the caller gives back with free(result.data, allocator).
// The occurrences are taken from the left without overlap, as count_of
// counts them, and what replaces one is never searched again, so "aaaa"
// with "aa" replaced by "a" gives "aa", and "aaa" with "a" replaced by "bb"
// gives "bbbbbb". An empty old matches nothing, as in count_of, so the
// result is a copy of s.
//
// The result is always a copy, even when nothing was replaced, so the
// caller can always free it. An empty result is the zeroed string, which
// allocates nothing, and so is the result when the allocator has no memory
// to give, or when its size would pass int's largest.
//
// The matches are counted first, so the size is known and the memory asked
// for once; then they are found again as the copy is filled.
replace :: (s: string, old: string, new: string, allocator: Allocator) -> string {
    LARGEST :: 9223372036854775807; // int's largest value
    replaced : string;
    matches := count_of(s, old);

    // Each match changes the count by new.count - old.count. Shrinking
    // can't take it below 0, since the matches are within s; growing is
    // checked by division so the product can't wrap.
    count := s.count;
    if new.count > old.count {
        growth := new.count - old.count;
        if matches > 0 && growth > (LARGEST - count) / matches { return replaced; }
        count += growth * matches;
    } else {
        count -= (old.count - new.count) * matches;
    }
    if count == 0 { return replaced; }
    data := cast(*u8) alloc(count, allocator);
    if data == null { return replaced; }

    // As many matches as were counted are found again, each in the rest of
    // s after the last; the bytes before each are copied, then new. With
    // none, as for an empty old, the loop doesn't run, and all of s is the
    // rest.
    at := 0;
    rest := s;
    done := 0;
    while done < matches {
        found := find_string(rest, old);
        copy_memory(data + at, rest.data, found);
        at += found;
        copy_memory(data + at, new.data, new.count);
        at += new.count;
        rest = advance(rest, found + old.count);
        done += 1;
    }
    copy_memory(data + at, rest.data, rest.count);
    replaced.data = data;
    replaced.count = count;
    return replaced;
}

// s n times over, in memory from allocator, which the caller gives back with
// free(result.data, allocator). An n of 0 or less, or an empty s, gives the
// zeroed string, which allocates nothing, and so does an allocator with no
// memory to give, or a size that would pass int's largest. Otherwise the
// result is a copy, even for an n of 1.
repeat :: (s: string, n: int, allocator: Allocator) -> string {
    LARGEST :: 9223372036854775807; // int's largest value
    repeated : string;
    if n <= 0 || s.count == 0 { return repeated; }
    // Checked by division, so the product can't wrap.
    if s.count > LARGEST / n { return repeated; }
    count := s.count * n;
    data := cast(*u8) alloc(count, allocator);
    if data == null { return repeated; }

    for i: 0..n - 1 { copy_memory(data + i * s.count, s.data, s.count); }
    repeated.data = data;
    repeated.count = count;
    return repeated;
}

// A copy of s with every ASCII letter in uppercase, as to_upper changes
// them, and every other byte as it is, so UTF-8's bytes, all from 128 up,
// pass through unharmed. The memory is from allocator, and the caller gives
// it back with free(result.data, allocator). An empty s gives the zeroed
// string, which allocates nothing, and so does an allocator with no memory
// to give.
to_upper_copy :: (s: string, allocator: Allocator) -> string {
    upper : string;
    if s.count == 0 { return upper; }
    data := cast(*u8) alloc(s.count, allocator);
    if data == null { return upper; }

    for s { data[it_index] = to_upper(it); }
    upper.data = data;
    upper.count = s.count;
    return upper;
}

// A copy of s with every ASCII letter in lowercase, as to_lower changes
// them, and every other byte as it is, as to_upper_copy does.
to_lower_copy :: (s: string, allocator: Allocator) -> string {
    lower : string;
    if s.count == 0 { return lower; }
    data := cast(*u8) alloc(s.count, allocator);
    if data == null { return lower; }

    for s { data[it_index] = to_lower(it); }
    lower.data = data;
    lower.count = s.count;
    return lower;
}
