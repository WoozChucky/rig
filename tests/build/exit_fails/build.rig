// exit(n) in a build program's #run (spec 7.9) ends rig there, with n as
// its status: the workspace made before it is never built, so no .build
// and no executable appear. What the run printed comes out first.
#import "Compiler";

exit :: (status: s32) #foreign libc;
puts :: (s: *u8) -> s32 #foreign libc;

#run {
    w := create_workspace("never");
    add_build_file(w, "main.rig");
    puts("the assets are missing");
    exit(1);
}
