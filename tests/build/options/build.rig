// Build options (spec 7.9): one file built as two programs, plain
// (unoptimised, as rig build of a file is) and fast (optimize: LLVM's O2
// pipeline, spec 10.2), which must print the same; fast's main file,
// fast.rig, #loads it, so each has an object of its own. And a program
// built with bounds_checks false, whose index past the end isn't checked,
// and one built with the default options, whose index past the end is
// (checked_workspace_test). The unchecked and checked workspaces'
// executables take their files' names, past_the_end and checked.
#import "Compiler";

#run {
    plain := create_workspace("plain");
    o := get_build_options(plain);
    o.output_name = "plain";
    set_build_options(plain, o);
    add_build_file(plain, "sums.rig");

    fast := create_workspace("fast");
    o = get_build_options(fast);
    o.output_name = "fast";
    o.optimize = true;
    set_build_options(fast, o);
    add_build_file(fast, "fast.rig");

    unchecked := create_workspace("unchecked");
    o = get_build_options(unchecked);
    o.bounds_checks = false;
    set_build_options(unchecked, o);
    add_build_file(unchecked, "past_the_end.rig");

    checked := create_workspace("checked");
    add_build_file(checked, "checked.rig");
}
