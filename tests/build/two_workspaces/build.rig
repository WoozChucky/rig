// Two workspaces (spec 7.9), each built as a program of its own, in the
// order they were made. Both programs declare main and label, and each
// prints its own label from its own top-level #run while compiling: two
// compilations in one rig share nothing, neither names nor globals nor
// #runs. The greeter's executable is named hello by its build options; the
// counter's takes its file's name, as rig build of that file would give it.
// The build program and the greeter's each use Preload's heap, which every
// program has without an #import (spec 2.14).
#import "Compiler";

printf :: (format: *u8, ..) -> s32 #foreign libc;

// The build program's Preload: its heap, while compiling.
#run {
    text := "the build program";
    copy := cast(*u8) HEAP_ALLOCATOR.proc(ALLOCATE, text.count, 0, null, HEAP_ALLOCATOR.data);
    for i: 0..text.count - 1 { copy[i] = text.data[i]; }
    printf("%.*s, from the heap\n", cast(s32) text.count, copy);
    HEAP_ALLOCATOR.proc(FREE, 0, 0, copy, HEAP_ALLOCATOR.data);
}

#run {
    greeter := create_workspace("greeter");
    o := get_build_options(greeter);
    o.output_name = "hello";
    set_build_options(greeter, o);
    add_build_file(greeter, "greeter.rig");

    counter := create_workspace("counter");
    add_build_file(counter, "src/counter.rig");
}
