// The greeter workspace's program (build.rig). Its label and its top-level
// #run are its own, though the counter's program declares the same names.
printf :: (format: *u8, ..) -> s32 #foreign libc;

label := "the greeter";

#run printf("compiling %.*s\n", cast(s32) label.count, label.data);

main :: () {
    printf("hello from %.*s\n", cast(s32) label.count, label.data);

    // A workspace's Preload: its heap, at run time.
    copy := cast(*u8) HEAP_ALLOCATOR.proc(.ALLOCATE, label.count, 0, null, HEAP_ALLOCATOR.data);
    for i: 0..label.count - 1 { copy[i] = label.data[i]; }
    printf("%.*s, from the heap\n", cast(s32) label.count, copy);
    HEAP_ALLOCATOR.proc(.FREE, 0, 0, copy, HEAP_ALLOCATOR.data);
}
