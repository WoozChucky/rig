// A workspace whose program has errors (spec 7.9) fails alone: its errors
// are printed when its compilation ends, naming its files as the build
// program added them, before the next workspace is compiled, and the
// workspaces after it are still built. So is a workspace with no files: its
// error, the build program's, comes first, before any workspace is built.
// And so is a workspace whose top-level #run fails. rig exits 1, since
// something failed, and the broken and failing workspaces leave neither an
// object nor a program.
#import "Compiler";

#run {
    broken := create_workspace("broken");
    add_build_file(broken, "src/broken.rig");

    create_workspace("empty");

    failing := create_workspace("failing");
    add_build_file(failing, "failing.rig");

    fine := create_workspace("fine");
    add_build_file(fine, "fine.rig");
}
