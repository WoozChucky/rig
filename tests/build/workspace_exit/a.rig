// The a workspace's program (build.rig): its first top-level #run fails,
// and its second prints a line and ends rig with exit(3).
puts :: (s: *u8) -> s32 #foreign libc;
exit :: (status: s32) #foreign libc;

#run { a : [1]int; i := 2; a[i] = 0; }
#run { puts("a ends rig"); exit(3); }

main :: () { }
