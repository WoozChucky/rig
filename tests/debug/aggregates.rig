// A debugger's view of procedures that take and return aggregates
// (bin/run-tests runs it under gdb with aggregates.gdb and under cdb with
// aggregates.cdb). Rig passes an aggregate by a pointer to the caller's copy
// and returns one through a hidden pointer (spec 10.4). In DWARF a struct, a
// view and a string are types passed by reference: gdb shows the parameter
// p as the struct, calls sum(q) with q's address and make(7) with a result
// pointer of its own, and shows the value `finish` returns, even for a
// struct of 8 bytes, which C returns in registers. An array's hidden pointer
// is a parameter, result$, as every aggregate result's is in CodeView: gdb
// calls both(&b, 4), cdb make(&q, 9). cdb's aggregate parameters are
// pointers: sum(&q). A procedure of scalars, both call as they show it.
Pair :: struct { a: int; b: int; }
Small :: struct { a: s32; b: s32; }

make :: (n: int) -> Pair {
    p := Pair.{n, n + 1};
    return p;
}

little :: (n: s32) -> Small {
    s := Small.{n, n + 2};
    return s;
}

name :: (n: int) -> string {
    if n == 1 { return "one"; }
    return "other";
}

both :: (n: int) -> [2]int {
    a : [2]int = .[n, n * 2];
    return a;
}

sum :: (p: Pair) -> int {
    s := p.a + p.b;
    return s;
}

twice :: (n: int) -> int {
    t := n * 2;
    return t;
}

main :: () {
    q := make(5);
    l := little(7);
    w := name(1);
    b := both(3);
    s := sum(q);
    d := twice(s);
}
