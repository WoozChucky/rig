// A debugger's steps out of an if chain (bin/run-tests runs it under gdb
// with chain.gdb and under cdb with chain.cdb): from the end of the arm
// that ran, the next line is the one after the chain, never the `}` of an
// arm that didn't run.
putchar :: (c: s32) -> s32 #foreign libc;

main :: () {
    n := 1;
    if n == 0 {
        putchar(48);
    } else if n == 1 {
        putchar(49);
    } else {
        putchar(50);
    }
    putchar(10);
}
