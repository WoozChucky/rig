// A debugger's view of leaving through deferred code at a return and a
// break (bin/run-tests runs it under gdb with defer_jumps.gdb and under cdb
// with defer_jumps.cdb): stepping stops at the keyword, at each deferred
// line in the order they run, at the keyword again, and then goes on where
// the way out leads. A break, and a return of a constant, take no code
// before the deferred lines, so no stop at the keyword first (spec 10.7).
putchar :: (c: s32) -> s32 #foreign libc;

f :: (n: int) -> int {
    defer putchar(97);
    k := n;
    if k == 1 {
        return k;
    }
    for 1..3 {
        defer putchar(98);
        if it == 2 {
            putchar(99);
            break;
        }
    }
    return 0;
}

main :: () {
    f(1);
    f(2);
    putchar(10);
}
