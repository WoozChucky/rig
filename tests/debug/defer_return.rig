// A debugger's view of blocks a return leaves through deferred code
// (bin/run-tests runs it under gdb with defer_return.gdb and under cdb
// with defer_return.cdb): the copy of main's deferred statement at the
// return is in main's block, not in the blocks the return leaves, whose
// code is then in pieces around it. gdb shows y in its own block only,
// not in the copy; cdb, as CodeView describes no block in pieces, in
// main's block too, as <value unavailable> before its own (spec 10.7).
// The block's LIMIT, a number with no storage, has no range to be
// unavailable outside, so cdb shows it as 99 over main's block, where it
// hides the top-level LIMIT gdb shows as 12.
putchar :: (c: s32) -> s32 #foreign libc;

LIMIT :: 12;

main :: () {
    a := 1;
    defer putchar(97);
    putchar(10);
    {
        y := 5;
        LIMIT :: 99;
        if y == 5 { return; }
        putchar(98);
    }
}
