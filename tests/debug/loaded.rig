// A debugger's view of a program of several files (bin/run-tests runs it
// under gdb with loaded.gdb and under cdb with loaded.cdb): a breakpoint
// on a line of a file it #loads, load/helper.rig, the stack through both
// files, each frame in its own, and a local of the loaded file's
// procedure.
#load "load/helper.rig";

putchar :: (c: s32) -> s32 #foreign libc;

main :: () {
    n := helper(21);
    putchar(cast(s32) n);
    putchar(10);
}
