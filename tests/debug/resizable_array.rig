// A debugger's view of a resizable array (bin/run-tests runs it under gdb
// with resizable_array.gdb and under cdb with resizable_array.cdb; issue
// #158, spec 10.7): a struct [..]T of its count, data, allocated and
// allocator, its elements reached through data.
Point :: struct { x: int; y: int; }

main :: () {
    numbers : [..]int;
    array_add(*numbers, 3);
    array_add(*numbers, 5);
    array_add(*numbers, 8);
    points : [..]Point;
    array_add(*points, Point.{1, 2});
    count := numbers.count;
    passed := count_of(numbers);
    array_free(*numbers);
    array_free(*points);
}

// A [..]T parameter is described as what's passed, a pointer to the
// caller's copy, as any aggregate parameter is: a debugger shows its
// address and reads its fields through it (gdb's a->count, cdb's ?? a->count).
count_of :: (a: [..]int) -> int {
    n := a.count;
    return n;
}
