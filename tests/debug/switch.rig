// A debugger's steps through a switch (bin/run-tests runs it under gdb
// with switch.gdb and under cdb with switch.cdb; issue #222, spec 10.7):
// from the `if`, the next line is the case that runs, never another
// case's; a #through goes on into the next case; from a case's end the
// next line is the switch's '}', then the code after it.
putchar :: (c: s32) -> s32 #foreign libc;

main :: () {
    n := 2;
    if n == {
        case 1;
            putchar(49);
        case 2;
            twice := n * 2;
            putchar(50);
            #through;
        case 3;
            putchar(51);
        case;
            putchar(48);
    }
    putchar(10);
}
