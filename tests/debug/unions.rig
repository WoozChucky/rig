// A debugger's view of unions and anonymous members (bin/run-tests runs it
// under gdb with unions.gdb and under cdb with unions.cdb; issue #223, spec
// 10.7): a union shown with every member over the same bytes, all at offset
// 0, a struct's anonymous union shown as a member with no name whose fields
// are reached as the struct's own (e.key.code), and a union's anonymous
// struct the same (w.hi), each as the debugger shows C's. gdb prints an
// anonymous member as a value with no name among the outer one's; cdb's
// `??` lists its fields in the outer type instead, at their offsets (key and
// mouse at +0x004), as CodeView describes them, and writes a u16 in decimal
// without 0n (w.hi's `unsigned short 2`).
putchar :: (c: s32) -> s32 #foreign libc;

Value :: union { i: s64; f: float64; p: *void; }
Key :: struct { code: s32; }
Mouse :: struct { x: s16; y: s16; }
Event :: struct { kind: s32; union { key: Key; mouse: Mouse; }; }
Word :: union { struct { lo: u16; hi: u16; }; all: u32; }

main :: () {
    v: Value;
    v.f = 1.5;
    e: Event;
    e.kind = 2;
    e.key.code = 65;
    w: Word;
    w.all = 0x00020001;
    putchar(10);
}
