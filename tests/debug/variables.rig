// A debugger's view of variables (bin/run-tests runs it under gdb with
// variables.gdb and under cdb with variables.cdb): a local of each kind of
// type, a global, and a string parameter and a bool one shown after their
// procedure has called something.
putchar :: (c: s32) -> s32 #foreign libc;

Node :: struct {
    value: int;
    next: *Node;
}

Tree :: struct {
    label: int;
    children: []Tree;
}

Empty :: struct {}

Point :: struct { x: int; y: int; }

counter := 7;

say :: (s: string) {
    for s { putchar(it); }
}

greet :: (s: string, loud: bool) -> int {
    say(s);
    n := s.count;
    return n;
}

main :: () {
    x := 3;
    c : s8 = -3;
    u : u16 = 65000;
    flag := true;
    ratio : float32 = 1.5;
    precise : float64 = 2.25;
    s := "hi";
    point := Point.{1, 2};
    numbers := int.[5, 3, 9, 1, 7];
    view : []int = numbers;
    node: Node;
    node.value = 42;
    node.next = *node;
    tree: Tree;
    tree.label = 9;
    empty: Empty;
    none: [0]int;
    big: [65536]u8;
    nothing : *void = null;
    counter += 1;
    putchar(10);
    greet(s, true);
    putchar(10);
}
