// Basic's assert (issue #157) failing in a #run: an error at the #run, as
// a failing runtime check there is (spec 7.8), with the calls that led to
// it, the innermost assert's own call of Preload's __runtime_error, then
// the assert's call in count_of_things. rig doesn't stop there: the build
// goes on, and reports the error after it too. COUNT has no value, and
// nothing more is said of it.
#import "Basic";

count_of_things :: () -> int {
    n := 0;
    assert(n > 0, "the count is positive");
    return n;
}

COUNT :: #run count_of_things();

main :: () {
    a : [COUNT]int;
}

wrong : int = "x";
