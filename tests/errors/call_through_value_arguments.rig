// A call through a procedure value is checked as a direct call is: as many
// arguments as the type has parameters, each converting to its parameter's
// type. A value that's no name is named by its type.
add :: (a: int, b: int) -> int { return a + b; }

Op :: struct { run: (int, int) -> int; }

main :: () {
    f := add;
    f(1);
    f(1, true);
    op := Op.{add};
    op.run(1, 2, 3);
    op.run("one", 2);
}
