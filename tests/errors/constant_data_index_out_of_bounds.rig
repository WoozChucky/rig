// A constant index into constant data is checked while compiling (spec 5.11):
// an array's against its count, a string's against its bytes (none when a
// literal leaves it out).
Named :: struct { name: string; n: int; }
NAME :: "rig";
PRIMES :: int.[2, 3, 5, 7, 11];
EMPTY :: Named.{n = 1};
N :: PRIMES[9];
main :: () {
    c := NAME[5];
    d := "x"[1];
    e := NAME[-1];
    f := EMPTY.name[0];
}
