// No part of a constant is a place (spec 5.1): not its fields, its elements
// nor a string constant's bytes, to assign to or to take the address of.
Vec2 :: struct { x: int; y: int; }
NAME :: "rig";
ORIGIN :: Vec2.{1, 2};
PRIMES :: int.[2, 3, 5, 7, 11];
main :: () {
    PRIMES[0] = 1;
    ORIGIN.x = 1;
    NAME[0] = 65;
    p := *PRIMES[0];
    for * NAME { }
}
