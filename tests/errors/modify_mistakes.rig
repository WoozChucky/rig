// #modify blocks' own mistakes (issue #228, spec 7.12): a block is checked
// once, as its generic's own code, with no chain, whether a call asks for
// an instance or not. In it a type parameter is a variable of type Type:
// no type to write, no address, no Any, and only an #if that is known
// while compiling; a Type local needs a value, and only a variable's whole
// type is Type. It returns a bool, and may add a message, on every path.
// The procedure's other parameters aren't in it, no call's arguments
// existing when it runs, and it can't call main. A local can't take a
// variable's name. No instance takes a Type value, so none binds a type
// parameter, and a #run in the block is code of its own, where a type is
// no value. What it calls is checked as anywhere, and must have no
// mistakes; neither it nor what it calls can use its own generic. A
// generic struct's block is checked as a procedure's, used or not. A
// generic whose block has a mistake makes no instance: main's uses say
// nothing more.

decided :: (v: $T) #modify { #if T == int { } return true; } { }
as_type :: (v: $T) #modify { x: T; return true; } { }
sized :: (v: $T) #modify { s := size_of(T); return true; } { }
addressed :: (v: $T) #modify { p := *T; return true; } { }
as_any :: (v: $T) #modify { a: Any = T; return true; } { }
no_value :: (v: $T) #modify { t: Type; return true; } { }
left_alone :: (v: $T) #modify { t: Type = ---; return true; } { }
viewed :: (v: $T) #modify { a: []Type; return true; } { }
returns_nothing :: (v: $T) #modify { return; } { }
returns_three :: (v: $T) #modify { return true, "a", 1; } { }
returns_a_type :: (v: $T) #modify { return int, "a", 1; } { }
runs_off :: (v: $T) #modify { x := 1; } { }
counts :: (values: []$T) #modify { return values.count > 0; } { }
set_to_five :: (v: $T) #modify { T = 5; return true; } { }
starts :: (v: $T) #modify { main(); return true; } { }
redeclared :: (v: $T) #modify { T := 1; return true; } { }
added :: (v: $T) #modify { x := T + 1; return true; } { }
runs_a_type :: (v: $T) #modify { t := #run int; return true; } { }
passes_a_type :: (v: $T) #modify { n := takes(T); return true; } { }
bakes_a_variable :: (v: $T) #modify { n := bakes(T); return true; } { }
calls_a_mistake :: (v: $T) #modify { n := names_a_type(); return true; } { }
uses_itself :: (v: $T) #modify { uses_itself(1); return true; } { }
Box :: struct (T: Type) #modify { x: T; return true; } { v: T; }
Ring :: struct (T: Type, N: int) #modify { s: string = N; return true; } { items: [N]T; }

takes :: (v: $U) -> int { return 1; }
bakes :: ($U: Type) -> int { return 1; }
names_a_type :: () -> int { t := int; return 1; }

main :: () {
    decided(1);
    as_type(1);
    sized(1);
    addressed(1);
    as_any(1);
    no_value(1);
    left_alone(1);
    viewed(1);
    returns_nothing(1);
    returns_three(1);
    returns_a_type(1);
    runs_off(1);
    values: []int;
    counts(values);
    set_to_five(1);
    starts(1);
    redeclared(1);
    added(1);
    runs_a_type(1);
    passes_a_type(1);
    bakes_a_variable(1);
    calls_a_mistake(1);
    uses_itself(1);
    b: Box(int);
}
