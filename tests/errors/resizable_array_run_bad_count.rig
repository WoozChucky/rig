// #runs whose code calls a resizable array's built-ins on an array whose
// count was set by hand to one its memory can't have (issue #158, spec
// 3.17, 7.8, 8.1): below 0, which the built-ins place and find elements
// from, and past allocated in an array that owns memory, where array_pop
// and the removes would read. Each #run fails at the built-in's name,
// rather than the interpreter reading or writing outside the array's
// memory: in #no_abc too, where no bounds check fails the count first.
add :: () -> int { a : [..]int; a.count = -3; array_add(*a, 1); return 0; }
resize :: () -> int { a : [..]int; a.count = -1; array_resize(*a, 2); return 0; }
pop :: () -> int #no_abc { a : [..]int; a.count = -1; return array_pop(*a); }
past :: () -> int {
    a : [..]int;
    array_add(*a, 7);
    a.count = a.allocated + 1;
    array_remove_ordered(*a, 0);
    return 0;
}

A :: #run add();
R :: #run resize();
P :: #run pop();
X :: #run past();

main :: () { }
