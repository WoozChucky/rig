// #runs whose code calls a resizable array's built-ins on an array whose
// count or allocated says there is memory but whose data is null (issue
// #158, spec 3.17, 7.8, 8.4): each of the seven built-ins that keep the
// array's elements checks its data as a view's is, so each #run fails at
// the built-in's name, rather than the interpreter going through null.
null_array :: () -> [..]int {
    a : [..]int;
    a.count = 2;
    return a;
}

pop :: () -> int { a := null_array(); return array_pop(*a); }
add :: () -> int { a := null_array(); array_add(*a, 1); return 0; }
insert :: () -> int { a := null_array(); array_insert(*a, 1, 5); return 0; }
ordered :: () -> int { a := null_array(); array_remove_ordered(*a, 0); return 0; }
unordered :: () -> int { a := null_array(); array_remove_unordered(*a, 0); return 0; }
reserve :: () -> int { a := null_array(); array_reserve(*a, 0); return 0; }
resize :: () -> int { a := null_array(); array_resize(*a, 1); return 0; }
room :: () -> int { a : [..]int; a.allocated = 4; array_add(*a, 1); return 0; }

P :: #run pop();
A :: #run add();
I :: #run insert();
O :: #run ordered();
U :: #run unordered();
S :: #run reserve();
R :: #run resize();
M :: #run room();

main :: () { }
