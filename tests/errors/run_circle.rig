// A #run needs the bodies it reaches checked before it runs (spec 4.8 and
// 7.8): a body that runs itself is defined in terms of itself, and so is a
// constant whose #run reaches a body that needs the constant's value.
f :: () -> int {
    x := #run f();
    return x;
}

M :: #run k();
k :: () -> int { return M; }

main :: () { }
