// A switch and the end of a procedure that returns a value (issue #222,
// spec 6.11, 6.14): it gets past a switch when a value may find no case
// (no case; and no #complete that names every value; a bool's two values
// are no exception) or a case that doesn't end with #through reaches its
// end, the last case or any other; a #through goes on into the next
// case, which is judged in its turn; and a break in a case leaves the
// loop around the switch. A switch whose message was said (on a float,
// #complete refused, missing a member or with a case's error) is taken
// not to get past, so that message is the only one.
Mode :: enum { A; B; }

no_default :: (n: int) -> int {
    if n == {
        case 1; return 1;
        case 2; return 2;
    }
}

default_reaches :: (n: int) -> int {
    if n == {
        case 1; return 1;
        case;
    }
}

through_to_a_return :: (n: int) -> int {
    if n == {
        case 1; #through;
        case;   return 0;
    }
}

complete :: (m: Mode) -> int {
    if #complete m == {
        case .A; return 1;
        case .B; return 2;
    }
}

bool_both :: (b: bool) -> int {
    if b == {
        case true;  return 1;
        case false; return 0;
    }
}

loop_break :: (n: int) -> int {
    while true {
        if n == {
            case 1; break;
            case;   return 0;
        }
    }
}

middle_reaches :: (n: int) -> int {
    if n == {
        case 1;
        case;   return 0;
    }
}

on_a_float :: (f: float64) -> int {
    if f == {
        case 1; return 1;
    }
}

incomplete :: (m: Mode) -> int {
    if #complete m == {
        case .A; return 1;
    }
}

case_error :: (m: Mode) -> int {
    if #complete m == {
        case .A; return 1;
        case .C; return 2;
    }
}

complete_on_an_int :: (n: int) -> int {
    if #complete n == {
        case 1; return 1;
    }
}

complete_on_flags :: (f: Look) -> int {
    if #complete f == {
        case .X; return 1;
        case .Y; return 2;
    }
}

main :: () {}

Look :: enum_flags { X; Y; }
