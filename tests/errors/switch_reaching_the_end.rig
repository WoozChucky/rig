// A switch and the end of a procedure that returns a value (issue #222,
// spec 6.11, 6.14): it gets past a switch when a value may find no case
// (no case; and no #complete that names every value; a bool's two values
// are no exception) or a case that doesn't end with #through reaches its
// end; a #through goes on into the next case, which is judged in its
// turn; and a break in a case leaves the loop around the switch.
Mode :: enum { A; B; }

no_default :: (n: int) -> int {
    if n == {
        case 1; return 1;
        case 2; return 2;
    }
}

default_reaches :: (n: int) -> int {
    if n == {
        case 1; return 1;
        case;
    }
}

through_to_a_return :: (n: int) -> int {
    if n == {
        case 1; #through;
        case;   return 0;
    }
}

complete :: (m: Mode) -> int {
    if #complete m == {
        case .A; return 1;
        case .B; return 2;
    }
}

bool_both :: (b: bool) -> int {
    if b == {
        case true;  return 1;
        case false; return 0;
    }
}

loop_break :: (n: int) -> int {
    while true {
        if n == {
            case 1; break;
            case;   return 0;
        }
    }
}

main :: () {}
