// A tagged union's uses' mistakes (issue #224, spec 3.20), one a line: a
// member read or written outside a switch, directly, through a pointer and
// through an element, each message showing the switch to write, and a
// name the union doesn't have, said as that; Shape.empty, which is no
// place, assigned to, its address taken, and switched on with its it
// written; a literal in order, with no member, giving two members, or one
// twice, or a value to a void member, or a member it doesn't have; a
// member it doesn't have, or one that isn't void, written as a value; ==
// and != with anything but a member's name, and <; a tag test naming a
// member it doesn't have, or another tagged union's member, on either
// side; a void member's name meeting no type; two of them in an operator
// meeting the union; a member read with spaces around its '.', in
// parentheses, over two lines or with spaces inside its operand, whose
// switch shows the operand as written, without the spaces around the '.',
// or as s; a void member read or written, which holds nothing, its
// message the tag test to write; and a tag test and a switch's case
// naming a member beside a pointer, whose message adds the .* to write.
Circle :: struct { r: float; }
Rect :: struct { w: float; h: float; }
Shape :: union #tagged { circle: Circle; rect: Rect; empty: void; }
Other :: union #tagged { circle: Circle; none: void; }

main :: () {
    s: Shape;
    p := *s;
    shapes: [2]Shape;
    t: Shape;
    x := s.circle;
    s.circle.r = 1;
    y := p.rect;
    z := *shapes[0].circle;
    w := s.nope;
    Shape.empty = s;
    q := *Shape.empty;
    if Shape.empty == { case .circle; it.r = 1; case; }
    a := Shape.{Circle.{1}};
    b := Shape.{};
    c := Shape.{circle = .{1}, rect = .{1, 2}};
    d := Shape.{circle = .{1}, circle = .{2}};
    e := Shape.{empty = 1};
    f := Shape.{z = 1};
    g := Shape.z;
    h := Shape.circle;
    i : Shape = .circle;
    j := s == t;
    k := s != 1;
    l := s < t;
    m := s == .nope;
    m2 := s == Other.none;
    m3 := Other.none != s;
    n := .empty;
    o : Shape = .empty | .empty;
    x2 := s . circle;
    x3 := (s).circle;
    x4 := shapes[
        0].circle;
    x5 := shapes[ 1 ].circle;
    v := s.empty;
    p.empty = 1;
    u := p == .circle;
    u2 := .rect != p;
    if p == { case .circle; case; }
}
