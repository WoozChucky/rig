// A tagged union's uses' mistakes (issue #224, spec 3.20), one a line: a
// member read or written outside a switch, directly, through a pointer and
// through an element, each message showing the switch to write; a literal
// in order, with no member, giving two members, or one twice, or a value
// to a void member, or a member it doesn't have; a member it doesn't have,
// or one that isn't void, written as a value; == and != with anything but
// a member's name, and <; a tag test naming a member it doesn't have; and a
// void member's name meeting no type.
Circle :: struct { r: float; }
Rect :: struct { w: float; h: float; }
Shape :: union #tagged { circle: Circle; rect: Rect; empty: void; }

main :: () {
    s: Shape;
    p := *s;
    shapes: [2]Shape;
    t: Shape;
    x := s.circle;
    s.circle.r = 1;
    y := p.rect;
    z := *shapes[0].circle;
    a := Shape.{Circle.{1}};
    b := Shape.{};
    c := Shape.{circle = .{1}, rect = .{1, 2}};
    d := Shape.{circle = .{1}, circle = .{2}};
    e := Shape.{empty = 1};
    f := Shape.{z = 1};
    g := Shape.z;
    h := Shape.circle;
    i : Shape = .circle;
    j := s == t;
    k := s != 1;
    l := s < t;
    m := s == .nope;
    n := .empty;
}
