// Pointer conversions through using fields that aren't (issue #225, spec
// 3.21), one a line: a struct holding two at one depth, implicitly then in
// a cast; through a pointer using field; by value; back from the field's
// struct to the outer one; and inside another type, a pointer to a pointer
// and a view.
Vec2 :: struct { x: float; y: float; }
Entity :: struct { id: int; position: Vec2; }
Player :: struct { name: string; using entity: Entity; health: int; }
Twice :: struct { using a: Entity; using b: Entity; }
Transform :: struct { x: float; y: float; }
Sprite :: struct { using transform: *Transform; frame: int; }

main :: () {
    t: Twice;
    p: Player;
    s: Sprite;
    pp := *p;
    ps: []Player;
    a : *Entity = *t;
    b := cast(*Entity) *t;
    c : *Transform = *s;
    d : Entity = p;
    e : *Player = *p.entity;
    f : **Entity = *pp;
    g : []Entity = ps;
}
