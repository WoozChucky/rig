// What C's '...' can't take: a struct, an array, a view or a string. Each
// is reported once, at the argument, saying what to pass instead.
printf :: (format: *u8, ..) -> s32 #foreign libc;

Vec2 :: struct { x: float; y: float; }

main :: () {
    v := Vec2.{1, 2};
    buffer : [8]u8;
    bytes : []u8 = buffer;
    s := "hello";
    printf("%f %s %s %s\n", v, buffer, bytes, s);
    printf();
}
