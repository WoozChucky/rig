// Where a '..T' parameter can't be (issue #150, spec 7.2, 7.6), and what
// follows one (issue #197): C passes no view, so neither a foreign nor a
// #c_call procedure, nor a #c_call procedure type, takes it; a #compiler
// one doesn't, for now; C's bare '..' is a foreign procedure's alone.
c_sum :: (count: int, values: ..int) -> int #foreign libc;
callback :: (values: ..int) #c_call { }
Handler :: struct { run: (..int) #c_call; }
c_like :: (count: int, ..) -> int { return count; }
compiled :: (values: ..int) #compiler;
// A parameter after a '..T' one takes only its default, so it needs one.
trailing :: (values: ..int, count: int) { }
main :: () { }
