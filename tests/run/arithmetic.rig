// Integer arithmetic: parameters, locals, untyped constants taking their
// types, narrow types wrapping, and a shift amount masked to the width.
putchar :: (c: s32) -> s32 #foreign libc;
square :: (x: s32) -> s32 { return x * x; }
main :: () {
    b : s32 = 6;
    c := square(b) + 29;   // 65
    putchar(c);            // A
    putchar(c + 1);        // B
    small : u8 = 200;
    small += 100;          // wraps to 44
    putchar(small);        // ,
    one : s32 = 1;
    putchar(64 + (one << 33));   // the amount is masked to 1: B
    n : s32 = -3;
    putchar(n * -22);      // B
    putchar(10);
}
