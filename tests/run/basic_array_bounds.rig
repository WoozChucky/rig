// Basic's growable array (issue #134) given an index out of bounds: the
// program stops with the language's own message, index I is out of bounds
// (count C), at check_index in array.rig, whose line and column
// basic_array_bounds.err names. Edit one, edit the other.
#import "Basic";

main :: () {
    a : Array;
    array_init(*a, size_of(int), HEAP_ALLOCATOR);
    for 1..3 {
        value := it;
        array_add(*a, *value);
    }
    print_line("before");
    x := array_get(a, 3);
    print_line("after");
}
