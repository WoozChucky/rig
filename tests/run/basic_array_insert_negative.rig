// Basic's growable array (issue #134) given an insert below its first
// element: an insert may be at any index from 0 to the count, and -1 stops
// the program with the language's own message, as if the count were one
// more, at check_index in array.rig, whose line and column
// basic_array_insert_negative.err names. Edit one, edit the other.
#import "Basic";

main :: () {
    a : Array;
    array_init(*a, size_of(int), HEAP_ALLOCATOR);
    for 1..3 {
        value := it;
        array_add(*a, *value);
    }
    value := 0;
    array_insert(*a, 0, *value);
    print_line("inserted at 0");
    array_insert(*a, -1, *value);
    print_line("not reached");
}
