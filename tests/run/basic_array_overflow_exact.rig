// Basic's growable array (issue #134) grown to a capacity whose bytes are
// exactly the most that int's largest value holds of them: the array asks
// for exactly those bytes, not int's largest value, which it asks for only
// past them. No allocator has that many, and given null the array stops
// the program where it next reaches an element, with the language's null
// pointer dereference, at the line of array.rig this .err names.
#import "Basic";

// 3 bytes, which int's largest value isn't a multiple of.
Rgb :: struct { r: u8; g: u8; b: u8; }

// Prints the size of each allocation asked for, and gives none.
refusing_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    if mode == ALLOCATE || mode == RESIZE {
        print_string("asked for ");
        print_int(size);
        print_byte(10);
    }
    return null;
}

main :: () {
    // An array can't be this full, so its fields are set as if it were:
    // 1537228672809129301 Rgbs in room for as many. Its data stays null:
    // the add stops before reaching it.
    a : Array;
    array_init(*a, size_of(Rgb), Allocator.{refusing_allocator_proc, null});
    a.capacity = 1537228672809129301;
    a.count = a.capacity;

    // One more doubles the capacity to 3074457345618258602 Rgbs, int's
    // largest value divided by 3, whose bytes, 9223372036854775806, an int
    // just holds.
    color := Rgb.{1, 2, 3};
    array_add(*a, *color);
    print_string("not reached");
}
