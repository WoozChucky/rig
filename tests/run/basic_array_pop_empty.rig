// Basic's growable array (issue #134) popped when it is empty: there is no
// last element, index -1 of a count of 0, and the program stops with the
// language's own message for it, at check_index in array.rig, whose line
// and column basic_array_pop_empty.err names. Edit one, edit the other.
#import "Basic";

main :: () {
    a : Array;
    array_init(*a, size_of(int), HEAP_ALLOCATOR);
    value := 1;
    array_add(*a, *value);
    array_pop(*a, *value);
    print_line("popped the one element");
    array_pop(*a, *value);
    print_line("not reached");
}
