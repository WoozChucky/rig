// Basic's string builder (issue #134): appends of each kind, how its memory
// grows, copies out that the builder's later changes don't touch, a builder
// with nothing in it, which allocates nothing, the builder's own text
// appended to itself, and memory that comes from the builder's allocator
// and goes back to it.
#import "Basic";

// int's most negative value.
INT_SMALLEST :: -9223372036854775808;

// What a counting allocator was asked to do: how many allocations, resizes
// and frees, and how many bytes the last allocation was for.
Counter :: struct { allocations: int; resizes: int; frees: int; last_size: int; }

// Passes allocations and frees on to the heap, counting them. A resize is
// counted too, and always moves the bytes: they are copied into new memory,
// and the old ones written over with '#' before the heap has them back, so
// a view left pointing at them doesn't read the text.
counting_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE {
        counter.allocations += 1;
        counter.last_size = size;
    }
    if mode == RESIZE {
        counter.resizes += 1;
        memory := alloc(size, HEAP_ALLOCATOR);
        if memory == null { return null; }
        copy_memory(memory, old_memory, min_int(old_size, size));
        set_memory(old_memory, "#"[0], old_size);
        free(old_memory, HEAP_ALLOCATOR);
        return memory;
    }
    if mode == FREE { counter.frees += 1; }
    return HEAP_ALLOCATOR.proc(mode, size, old_size, old_memory, HEAP_ALLOCATOR.data);
}

// Prints a builder's count and capacity, separated by a space.
show_sizes :: (builder: String_Builder) {
    print_int(builder.count);
    print_byte(32);
    print_int(builder.capacity);
}

main :: () {
    b : String_Builder;
    builder_init(*b, HEAP_ALLOCATOR);
    append_string(*b, "count: ");
    append_int(*b, 42, 10);
    append_byte(*b, 32);
    append_int(*b, -255, 16);
    append_byte(*b, 32);
    append_float(*b, 3.14159, 2);
    append_byte(*b, 32);
    append_bool(*b, true);
    append_byte(*b, 32);
    append_bool(*b, false);
    s := builder_to_string(*b, HEAP_ALLOCATOR);
    print_line(s);
    free(s.data, HEAP_ALLOCATOR);

    // The first append that needed room took 64 bytes, the least a builder
    // grows to, and everything after it fit.
    print_int(b.capacity);
    print_byte(10);

    // A reset keeps the memory.
    builder_reset(*b);
    print_string("after reset: ");
    show_sizes(b);
    print_byte(10);

    // 300 bytes, three at a time: the capacity doubles from 64 as it fills,
    // to 128, 256 and 512.
    for 1..100 { append_string(*b, "abc"); }
    print_string("grown: ");
    show_sizes(b);
    print_byte(10);

    // A copy out is the builder's bytes as they were: a later change to the
    // builder doesn't reach it.
    t := builder_to_string(*b, HEAP_ALLOCATOR);
    b.data[0] = "x"[0];
    print_string("copied out: ");
    print_bool(t.count == 300 && t[0] == "a"[0] && ends_with(t, "bcabc"));
    print_byte(10);
    free(t.data, HEAP_ALLOCATOR);

    // An append bigger than 64 bytes doubles 64 until it fits.
    c : String_Builder;
    builder_init(*c, HEAP_ALLOCATOR);
    hundred : [100]u8;
    set_memory(hundred.data, "y"[0], 100);
    hundred_view : []u8 = hundred;
    append_string(*c, cast(string) hundred_view);
    print_string("one big append: ");
    show_sizes(c);
    print_byte(10);
    builder_free(*c);

    builder_free(*b);
    print_string("freed: ");
    show_sizes(b);
    print_byte(32);
    print_bool(b.data == null);
    print_byte(10);

    // A builder with nothing in it gives the zeroed string, and allocates
    // nothing for it.
    counter : Counter;
    counting := Allocator.{counting_allocator_proc, *counter};
    e : String_Builder;
    builder_init(*e, HEAP_ALLOCATOR);
    empty := builder_to_string(*e, counting);
    print_string("empty: ");
    print_int(empty.count);
    print_byte(32);
    print_bool(empty.data == null);
    print_string(", allocations ");
    print_int(counter.allocations);
    print_byte(10);

    // A freed builder keeps its allocator, so it can be used again.
    append_string(*b, "again");
    print_string("used again after free: ");
    show_sizes(b);
    print_byte(10);
    builder_free(*b);

    // builder_init makes a builder that held something empty. It doesn't
    // give back the memory, so this one is set as if it held 5 of hundred's
    // 100 bytes, which aren't the heap's to have back.
    h : String_Builder;
    h.data = hundred.data;
    h.count = 5;
    h.capacity = 100;
    builder_init(*h, HEAP_ALLOCATOR);
    print_string("init again: ");
    show_sizes(h);
    print_byte(32);
    print_bool(h.data == null);
    print_byte(10);

    // A builder isn't grown by an append that fills the room it has left
    // exactly, only by one byte more: 32 bytes take 64, and 32 more fill
    // them.
    d : String_Builder;
    builder_init(*d, HEAP_ALLOCATOR);
    thirty_two := hundred_view;
    thirty_two.count = 32;
    append_string(*d, cast(string) thirty_two);
    append_string(*d, cast(string) thirty_two);
    print_string("exact fit: ");
    show_sizes(d);
    append_byte(*d, "z"[0]);
    print_string(", one more: ");
    show_sizes(d);
    print_byte(10);

    // A copy out comes from the allocator given, not the builder's.
    u := builder_to_string(*d, counting);
    print_string("copied out of another allocator: ");
    print_int(counter.allocations);
    print_byte(32);
    print_int(counter.last_size);
    print_byte(32);
    print_bool(u[63] == "y"[0] && u[64] == "z"[0]);
    free(u.data, counting);
    print_string(", frees ");
    print_int(counter.frees);
    print_byte(10);
    builder_free(*d);

    // Appends of nothing take no memory: an empty literal, a zeroed string
    // and a number in a base format_int doesn't write. Nor do a reset and a
    // free of a builder that has none.
    zeroed : string;
    append_string(*e, "");
    append_string(*e, zeroed);
    append_int(*e, 7, 99);
    print_string("empty appends: ");
    show_sizes(e);
    print_byte(32);
    print_bool(e.data == null);
    builder_reset(*e);
    builder_free(*e);
    print_string(", reset and freed: ");
    show_sizes(e);
    print_byte(32);
    print_bool(e.data == null);
    print_byte(10);

    // A builder's memory comes from its own allocator and goes back to it.
    // 90 bytes: 40, a number of each kind, which is written on the stack
    // and allocates nothing, and 40 more. The first append takes 64 bytes,
    // and the last grows them to 128 with a resize.
    own_counter : Counter;
    g : String_Builder;
    builder_init(*g, Allocator.{counting_allocator_proc, *own_counter});
    forty := hundred_view;
    forty.count = 40;
    append_string(*g, cast(string) forty);
    append_int(*g, 12345, 10);
    append_float(*g, 2.5, 3);
    append_string(*g, cast(string) forty);

    // A view of the builder's own text, its last 50 bytes from the number
    // on, appended to it grows it to 256, and the counting allocator's
    // resize moves the bytes: they are read where they moved to, as far
    // into the text as they were, not where they were.
    text : string;
    text.data = g.data;
    text.count = g.count;
    append_string(*g, slice(text, 40, 50));
    text.data = g.data;
    text.count = g.count;
    print_string("own text appended: ");
    show_sizes(g);
    print_byte(32);
    print_bool(slice(text, 90, 50) == slice(text, 40, 50));
    print_byte(32);
    print_line(slice(text, 90, 10));

    // A reset keeps the memory, so text that fits takes none; builder_free
    // gives it back, with one free.
    builder_reset(*g);
    append_string(*g, "again");
    print_string("own allocator: allocations ");
    print_int(own_counter.allocations);
    print_string(" of ");
    print_int(own_counter.last_size);
    print_string(", resizes ");
    print_int(own_counter.resizes);
    print_string(", frees ");
    print_int(own_counter.frees);
    builder_free(*g);
    print_string(", after builder_free ");
    print_int(own_counter.frees);
    print_byte(10);

    // Numbers at their longest, which fill append_int's and append_float's
    // buffers: int's most negative value in base 2, INT_TEXT_MAX bytes, and
    // float64's most negative finite value with 9 decimals, FLOAT_TEXT_MAX
    // bytes. Each is what format_int or format_float writes.
    f : String_Builder;
    builder_init(*f, HEAP_ALLOCATOR);
    int_buffer : [INT_TEXT_MAX]u8;
    float_buffer : [FLOAT_TEXT_MAX]u8;
    longest : string;
    append_int(*f, INT_SMALLEST, 2);
    longest.data = f.data;
    longest.count = f.count;
    print_string("longest: ");
    print_int(f.count);
    print_byte(32);
    print_bool(longest == format_int(int_buffer, INT_SMALLEST, 2));
    builder_reset(*f);
    append_float(*f, -1.7976931348623157e308, 9);
    longest.data = f.data;
    longest.count = f.count;
    print_byte(32);
    print_int(f.count);
    print_byte(32);
    print_bool(longest == format_float(float_buffer, -1.7976931348623157e308, 9));
    print_byte(10);

    // Numbers in other bases.
    builder_reset(*f);
    append_int(*f, INT_SMALLEST, 10);
    append_byte(*f, 32);
    append_int(*f, 35, 36);
    append_byte(*f, 32);
    append_int(*f, 255, 2);
    append_byte(*f, 32);
    append_float(*f, -0.5, 0);
    numbers := builder_to_string(*f, HEAP_ALLOCATOR);
    print_line(numbers);
    free(numbers.data, HEAP_ALLOCATOR);
    builder_free(*f);

    // u64s (issue #154): u64's largest in bases 10 and 2, 255 in base 16,
    // and a base outside 2 to 36, which appends nothing.
    w : String_Builder;
    builder_init(*w, HEAP_ALLOCATOR);
    append_u64(*w, 18446744073709551615, 10);
    append_byte(*w, 32);
    append_u64(*w, 255, 16);
    append_string(*w, " [");
    append_u64(*w, 7, 99);
    append_string(*w, "] ");
    append_u64(*w, 18446744073709551615, 2);
    unsigned := builder_to_string(*w, HEAP_ALLOCATOR);
    print_line(unsigned);
    free(unsigned.data, HEAP_ALLOCATOR);
    builder_free(*w);
}
