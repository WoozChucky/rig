// Every procedure of Basic that allocates or frees through an allocator
// names its caller's place, not Basic's own line (issue #194): each takes
// loc: Source_Code_Location = #caller_location last (spec 7.2) and passes
// it down to the helper that calls the allocator, which puts it in
// context.allocation_location for the allocator to read (spec 7.10).
// Under a pushed context whose allocator keeps the last place it was
// given, each is called on a line of its own, and its name and that place
// are printed: the callee's name in the call on that line. What each gave
// is freed with Basic's helpers, the context's, on a line of its own after
// the print. Not print_to_builder nor sprint, which take a '..' parameter
// and so no default value, for now: their allocations name print.rig's own
// line, an absolute path.
#import "Basic";

// The file read_entire_file reads, under .build/tests/, which the runner
// makes before any test; written before the push and deleted at the end.
PATH :: ".build/tests/basic_caller_locations.txt";

// The place the recording allocator was last asked from.
last : Source_Code_Location;

// The heap, keeping context.allocation_location in last for every mode.
recording_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    last = context.allocation_location;
    return heap_allocator_proc(mode, size, old_size, old_memory, null);
}

main :: () {
    recording := context;
    recording.allocator = Allocator.{recording_proc, null};
    // Writing the file takes no allocator: its path's copy for C is the
    // heap's, whatever the context is.
    write_entire_file(PATH, "data");
    push_context recording {
        p := alloc(8);
        print("{} {}:{}\n", "alloc", last.line, last.column);
        p = resize(p, 8, 16);
        print("{} {}:{}\n", "resize", last.line, last.column);
        free(p);
        print("{} {}:{}\n", "free", last.line, last.column);
        free_all();
        print("{} {}:{}\n", "free_all", last.line, last.column);

        // Each append is into an empty builder, so each grows it.
        b : String_Builder;
        builder_init(*b);
        append_string(*b, "text");
        print("{} {}:{}\n", "append_string", last.line, last.column);
        builder_free(*b);
        append_byte(*b, 32);
        print("{} {}:{}\n", "append_byte", last.line, last.column);
        builder_free(*b);
        append_int(*b, 7, 10);
        print("{} {}:{}\n", "append_int", last.line, last.column);
        builder_free(*b);
        append_u64(*b, 7, 10);
        print("{} {}:{}\n", "append_u64", last.line, last.column);
        builder_free(*b);
        append_float(*b, 1.5, 1);
        print("{} {}:{}\n", "append_float", last.line, last.column);
        builder_free(*b);
        append_bool(*b, true);
        print("{} {}:{}\n", "append_bool", last.line, last.column);
        s := builder_to_string(*b);
        print("{} {}:{}\n", "builder_to_string", last.line, last.column);
        free(s.data);
        builder_free(*b);
        print("{} {}:{}\n", "builder_free", last.line, last.column);

        c := to_c_string("abc");
        print("{} {}:{}\n", "to_c_string", last.line, last.column);
        free(c);
        s = join(string.["a", "b"], ", ");
        print("{} {}:{}\n", "join", last.line, last.column);
        free(s.data);
        s = replace("aba", "a", "c");
        print("{} {}:{}\n", "replace", last.line, last.column);
        free(s.data);
        s = repeat("ab", 2);
        print("{} {}:{}\n", "repeat", last.line, last.column);
        free(s.data);
        s = to_upper_copy("ab");
        print("{} {}:{}\n", "to_upper_copy", last.line, last.column);
        free(s.data);
        s = to_lower_copy("AB");
        print("{} {}:{}\n", "to_lower_copy", last.line, last.column);
        free(s.data);
        s = path_join("a", "b");
        print("{} {}:{}\n", "path_join", last.line, last.column);
        free(s.data);

        ok : bool;
        s, ok = read_entire_file(PATH);
        print("{} {}:{}\n", "read_entire_file", last.line, last.column);
        free(s.data);
        s, ok = get_environment("RIG_BASIC_TEST");
        print("{} {}:{}\n", "get_environment", last.line, last.column);
        free(s.data);
        run_command("exit 0");
        print("{} {}:{}\n", "run_command", last.line, last.column);
        // More than SORT_INSERTION_MAX, so the sort asks for its scratch
        // memory.
        values := int.[7, 6, 5, 4, 3, 2, 1];
        sort(values.data, 7, size_of(int), less_int);
        print("{} {}:{}\n", "sort", last.line, last.column);

        n := 7;
        t : Table;
        table_init(*t, size_of(int));
        table_set(*t, "k", *n);
        print("{} {}:{}\n", "table_set", last.line, last.column);
        table_remove(*t, "k");
        print("{} {}:{}\n", "table_remove", last.line, last.column);
        table_free(*t);
        print("{} {}:{}\n", "table_free", last.line, last.column);
        u : Int_Table;
        int_table_init(*u, size_of(int));
        int_table_set(*u, 1, *n);
        print("{} {}:{}\n", "int_table_set", last.line, last.column);
        int_table_free(*u);
        print("{} {}:{}\n", "int_table_free", last.line, last.column);
    }
    delete_file(PATH);
}
