// Basic's run_command_with_output (issue #157): a command's standard
// output captured, its bytes in memory from the allocator the call is
// given, and its status; a command that writes only to standard error,
// whose line is the program's own standard error, not captured; a failing
// command; an empty one; a file of more than 4096 bytes written out by
// the shell, which comes back byte for byte, read in several pieces with
// its \r\n line endings unchanged; a file named outside the ANSI code
// page, read and then deleted by commands that name it, which on Windows
// reach the system as UTF-16 (issue #209); the largest exit code each
// shell has, given as each system's status, not refused; and the commands
// refused before they run (a zero byte, no memory for the command's copy,
// and on Windows a command that isn't valid UTF-8), and one whose output
// finds no memory. cmd.exe and sh differ in their line endings and their
// statuses, so only what both agree on is printed: an output with its line
// ending trimmed, whether it ended with one, and exit 3's status as either
// system's. The files are written under .build/tests and deleted, and what
// a stopped run left of them is deleted first.
#import "Basic";

FILE :: ".build/tests/basic_command_output.txt";
NIHON :: ".build/tests/basic_command_日本.txt";

// Prints s between brackets, so an empty string shows as [].
show_text :: (s: string) {
    print_string("[");
    print_string(s);
    print_string("]");
}

// Prints a space, then value.
show_bool :: (value: bool) {
    print_string(" ");
    print_bool(value);
}

// Prints a space, then value.
show_int :: (value: int) {
    print_string(" ");
    print_int(value);
}

// How many allocations an allocator was asked for, and how many frees.
Counter :: struct {
    allocations: int;
    frees: int;
}

// Prints a space and counter's allocations, then a space and its frees,
// and sets both back to 0 for the next call.
show_counts :: (counter: *Counter) {
    show_int(counter.allocations);
    show_int(counter.frees);
    counter.allocations = 0;
    counter.frees = 0;
}

// Passes every call on to the heap, counting the allocations and the
// frees.
counting_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE { counter.allocations += 1; }
    if mode == FREE { counter.frees += 1; }
    return HEAP_ALLOCATOR.proc(mode, size, old_size, old_memory, HEAP_ALLOCATOR.data);
}

// Counts as counting_allocator_proc does, but gives memory for the first
// allocation only, as an allocator that runs out after it would.
first_only_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE {
        counter.allocations += 1;
        if counter.allocations > 1 { return null; }
    }
    if mode == FREE { counter.frees += 1; }
    return HEAP_ALLOCATOR.proc(mode, size, old_size, old_memory, HEAP_ALLOCATOR.data);
}

// Gives no memory, as an allocator that has run out would.
failing_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    return null;
}

main :: () {
    delete_file(FILE);
    delete_file(NIHON);

    counter : Counter;
    counting := Allocator.{counting_allocator_proc, *counter};

    // The command's output is captured, not printed: echo's line comes
    // back as cmd.exe or sh wrote it, ended by \r\n or \n, which both end
    // with a line feed. Two allocations, the command's copy for the system
    // (UTF-16 on Windows, ended by a zero on Linux) and the output; the
    // copy is given back by the call, and the output by the test.
    print_line("before the command");
    output, status := run_command_with_output("echo hello", counting);
    print_string("echo: ");
    show_text(trim_right(output));
    show_int(status);
    show_bool(ends_with(output, "\n"));
    free(output.data, counting);
    show_counts(*counter);
    print_line("");

    // Only standard output is captured: the command's standard error is
    // the program's, where its line goes, so nothing comes back.
    output, status = run_command_with_output("1>&2 echo to standard error", HEAP_ALLOCATOR);
    print_string("standard error: ");
    show_text(output);
    show_int(status);
    print_line("");

    // cmd.exe gives exit 3's code, 3; sh's wait status holds it times 256.
    // No output is the zeroed string, allocating nothing: one allocation,
    // the command's copy, given back by the call.
    output, status = run_command_with_output("exit 3", counting);
    print_string("exit 3: ");
    show_text(output);
    show_bool(status == 3 || status == 768);
    show_bool(output.data == null);
    show_counts(*counter);
    print_line("");

    // An empty command runs the shell with nothing to do.
    output, status = run_command_with_output("", HEAP_ALLOCATOR);
    print_string("empty: ");
    show_text(output);
    show_int(status);
    print_line("");

    // A file of 9022 bytes, more than one read of 4096 takes, written out
    // by the shell's own command, comes back as its bytes, every one, each
    // \r\n still a \r\n: neither system's pipes have a text mode, so the
    // bytes come back as the command wrote them. cmd.exe's type needs the
    // path with \, and sh's cat takes it with /.
    contents : String_Builder;
    builder_init(*contents, HEAP_ALLOCATOR);
    append_string(*contents, "line one\r\nline two\r\n");
    for i: 0..8999 { append_byte(*contents, "x"[0]); }
    append_string(*contents, "\r\n");
    text : string;
    text.data = contents.data;
    text.count = contents.count;
    write_entire_file(FILE, text);
    #if OS == OS_WINDOWS {
        output, status = run_command_with_output("type .build\\tests\\basic_command_output.txt", HEAP_ALLOCATOR);
    } else {
        output, status = run_command_with_output("cat .build/tests/basic_command_output.txt", HEAP_ALLOCATOR);
    }
    print_string("exact:");
    show_bool(output == text);
    show_int(output.count);
    show_int(status);
    print_line("");
    free(output.data, HEAP_ALLOCATOR);
    builder_free(*contents);
    delete_file(FILE);

    // A file named outside the ANSI code page, written by Basic, then read
    // by the shell's own command, which names it: on Windows the command
    // reaches the system as UTF-16, so cmd.exe finds the file by its UTF-8
    // name, as sh does on Linux. type and cat write the file's bytes as
    // they are, so the output is the text written. Two allocations, the
    // command's copy and the output, both given back.
    write_entire_file(NIHON, "日本 café\n");
    #if OS == OS_WINDOWS {
        output, status = run_command_with_output("type .build\\tests\\basic_command_日本.txt", counting);
    } else {
        output, status = run_command_with_output("cat .build/tests/basic_command_日本.txt", counting);
    }
    print_string("utf-8 path:");
    show_bool(output == "日本 café\n");
    show_int(status);
    free(output.data, counting);
    show_counts(*counter);
    print_line("");

    // A command that names the file deletes it.
    #if OS == OS_WINDOWS {
        status = run_command("del .build\\tests\\basic_command_日本.txt", HEAP_ALLOCATOR);
    } else {
        status = run_command("rm .build/tests/basic_command_日本.txt", HEAP_ALLOCATOR);
    }
    print_string("deleted by a command:");
    show_int(status);
    show_bool(file_exists(NIHON));
    print_line("");
    delete_file(NIHON);

    // The largest exit code is given as each system's status, not refused.
    // cmd.exe's exit -1 is the code 0xFFFFFFFF, which run_command gives as
    // -1, read as a signed 32-bit number, as C's system did; sh (dash)
    // refuses exit -1, and its exit 255 is the wait status 65280.
    top := false;
    #if OS == OS_WINDOWS {
        top = run_command("exit -1", HEAP_ALLOCATOR) == -1;
    } else {
        top = run_command("exit 255", HEAP_ALLOCATOR) == 65280;
    }
    print_string("top exit code:");
    show_bool(top);
    print_line("");

    // A command of echo and the byte 255, which is never valid UTF-8,
    // joined from a view of the byte since a string literal can't hold it.
    // Windows refuses it, as it can't be converted to UTF-16 as it is:
    // nothing runs and the allocator is asked for nothing. Linux's sh takes
    // it as bytes and echoes them. The results differ, so one check of
    // them is printed, the same line on both systems.
    byte : [1]u8;
    byte[0] = 255;
    byte_view : []u8 = byte;
    bad_command := sprint("echo {}", cast(string) byte_view);
    output, status = run_command_with_output(bad_command, counting);
    expected := false;
    #if OS == OS_WINDOWS {
        expected = status == -1 && output.count == 0 && counter.allocations == 0;
    } else {
        expected = status == 0;
    }
    print_string("invalid UTF-8:");
    show_bool(expected);
    print_line("");
    free(output.data, counting);
    free(bad_command.data);
    counter.allocations = 0;
    counter.frees = 0;

    // A command with a zero byte would run as "echo a", so it is refused
    // before its copy is made: the allocator is asked for nothing.
    output, status = run_command_with_output("echo a\0b", counting);
    print_string("zero byte: ");
    show_text(output);
    show_int(status);
    show_counts(*counter);
    print_line("");

    // With no memory for the command's copy, nothing runs.
    output, status = run_command_with_output("echo from a command with no memory", Allocator.{failing_allocator_proc, null});
    print_string("no memory: ");
    show_text(output);
    show_int(status);
    print_line("");

    // With memory for the command's copy but not for the output, the
    // command runs, and its output is lost: the zeroed string, and still
    // its status. Two allocations asked for, the output's refused, and the
    // copy given back.
    first_only : Counter;
    output, status = run_command_with_output("echo hello", Allocator.{first_only_allocator_proc, *first_only});
    print_string("no memory for the output: ");
    show_text(output);
    show_int(status);
    show_bool(output.data == null);
    show_counts(*first_only);
    print_line("");
}
