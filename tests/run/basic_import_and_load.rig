// #import and #load of one module read it once, under the first name (spec
// 2.14): the #import finds Basic's module.rig in the modules directory
// above rig, the repository's, and the #load names the same file by its
// path from here, so it loads nothing more, and no name Basic declares is
// declared twice.
#import "Basic";
#load "../../modules/Basic/module.rig";

main :: () {
    print_line("read once");
}
