// Basic's numbers (issue #134): integers to text in any base and back,
// with int's extremes and overflow; floats to text with a number of
// decimals, their rounding, -0, infinities and NaN, and back.
#load "../../modules/Basic/module.rig";

show_int :: (value: int, base: int) {
    buffer : [INT_TEXT_MAX]u8;
    print_line(format_int(buffer, value, base));
}

show_parse_int :: (s: string, base: int) {
    value, ok := parse_int(s, base);
    print_byte("["[0]);
    print_string(s);
    print_string("] ");
    print_int(base);
    print_string(" -> ");
    print_int(value);
    print_byte(32);
    print_bool(ok);
    print_byte(10);
}

show_float :: (value: float64, decimals: int) {
    buffer : [FLOAT_TEXT_MAX]u8;
    print_line(format_float(buffer, value, decimals));
}

show_parse_float :: (s: string) {
    value, ok := parse_float(s);
    print_byte("["[0]);
    print_string(s);
    print_string("] -> ");
    print_float(value, 3);
    print_byte(32);
    print_bool(ok);
    print_byte(10);
}

main :: () {
    show_int(0, 10);
    show_int(42, 10);
    show_int(-9223372036854775808, 10);
    show_int(9223372036854775807, 10);
    show_int(9223372036854775807, 2);
    show_int(-1, 2);
    show_int(-255, 16);
    show_int(35, 36);
    show_int(36, 36);
    show_int(5, 1);
    show_int(5, 37);
    print_int(-12345);
    print_byte(10);

    show_parse_int("123", 10);
    show_parse_int("-9223372036854775808", 10);
    show_parse_int("9223372036854775807", 10);
    show_parse_int("9223372036854775808", 10);
    show_parse_int("-9223372036854775809", 10);
    show_parse_int("99999999999999999999999", 10);
    show_parse_int("", 10);
    show_parse_int("-", 10);
    show_parse_int("+7", 10);
    show_parse_int("12a", 10);
    show_parse_int(" 12", 10);
    show_parse_int("ff", 16);
    show_parse_int("FF", 16);
    show_parse_int("zz", 36);
    show_parse_int("101", 2);
    show_parse_int("2", 2);
    show_parse_int("7fffffffffffffff", 16);
    show_parse_int("-8000000000000000", 16);
    show_parse_int("1", 1);
    show_parse_int("1", 37);

    show_float(3.14159, 2);
    show_float(3.14159, 3);
    show_float(2.675, 2);
    show_float(0.125, 2);
    show_float(0.5, 0);
    show_float(2.5, 0);
    show_float(0.999, 2);
    show_float(-0.001, 2);
    show_float(-0.0, 2);
    show_float(1.5, -1);
    show_float(100.0, 20);
    show_float(0.1, 9);
    show_float(1.0 / 3.0, 9);
    show_float(123.456, 1);
    show_float(9007199254740993.0, 1);
    show_float(1e18, 1);
    show_float(123456789012345678901234567890.0, 0);
    show_float(1.7976931348623157e308, 0);
    zero : float64 = 0;
    show_float(1.0 / zero, 2);
    show_float(-1.0 / zero, 2);
    show_float(zero / zero, 2);
    small : float32 = 0.1;
    show_float(small, 9);
    print_float(-2.5, 1);
    print_byte(10);

    show_parse_float("3.14");
    show_parse_float("-0.5e2");
    show_parse_float("+.5");
    show_parse_float("5.");
    show_parse_float("12.5e-3");
    show_parse_float("1e400");
    show_parse_float("1e-400");
    show_parse_float("");
    show_parse_float(".");
    show_parse_float("1e");
    show_parse_float("1.5x");
    show_parse_float("abc");
    show_parse_float("-");
    a, ok_a := parse_float("3.14");
    b, ok_b := parse_float("123456789.125");
    c, ok_c := parse_float("0.1");
    print_string("exact: ");
    print_bool(a == 3.14);
    print_byte(32);
    print_bool(b == 123456789.125);
    print_byte(32);
    print_bool(c == 0.1);
    print_byte(10);
    d, ok_d := parse_float("12345678901234567890123");
    print_string("long: ");
    print_bool(ok_d && d > 1.2345678901e22 && d < 1.2345678902e22);
    print_byte(10);
}
