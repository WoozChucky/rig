// Basic's print (issue #134): bytes go to standard output through C's
// putchar, so they come out in order with C's own printf, compiled and
// interpreted. Basic declares putchar as c_putchar (issue #135), so this
// program can declare C's putchar under its own name too.
#load "../../modules/Basic/module.rig";

printf :: (format: *u8, ..) -> s32 #foreign libc;
putchar :: (c: s32) -> s32 #foreign libc;

main :: () {
    print_string("Hello, ");
    print_string("Basic");
    print_byte(33);
    print_byte(10);
    print_line("a line");
    print_line("");
    print_bool(true);
    print_byte(32);
    print_bool(false);
    print_byte(10);
    empty : string;
    print_string(empty);
    print_string("");
    printf("printf, in order\n");
    for "putchar, in order\n" { putchar(cast(s32) it); }
    print_line("tab:\t|\\|\"|");
    print_line("Olá");
}
