// Basic's random numbers (issue #145): PCG32's published vectors, the first
// round pcg-random.org's pcg32-demo prints for its fixed seed (seed 42,
// stream 54), reproduced through Basic's own procedures: six 32-bit
// numbers, 65 coins, 33 rolls of a die and a shuffled deck of 52 cards.
// Then 64-bit numbers and floats from the same seed, random_int at int's
// extremes, across 2^32 values and one more, with its bounds swapped and
// equal, shuffles of bytes and of nothing, every value of a small range
// seen and none outside it, and a generator seeded from the clock, of
// which it prints only what can't vary from run to run.
#import "Basic";

MIN :: -9223372036854775808;
MAX :: 9223372036854775807;

// Prints a space, then value.
show_int :: (value: int) {
    print_string(" ");
    print_int(value);
}

// Prints a space, then value.
show_bool :: (value: bool) {
    print_string(" ");
    print_bool(value);
}

main :: () {
    // The demo's round, from pcg32-demo.c in imneme/pcg-c-basic: six
    // numbers in hexadecimal, then coins, rolls and cards, all from one
    // generator, in that order.
    r : Random;
    random_seed(*r, 42, 54);
    print_string("32bit:");
    for 1..6 {
        buffer : [INT_TEXT_MAX]u8;
        print_string(" 0x");
        print_string(format_int(buffer, random_u32(*r), 16));
    }
    print_line("");

    print_string("Coins: ");
    for 1..65 {
        if random_bool(*r) {
            print_string("H");
        } else {
            print_string("T");
        }
    }
    print_line("");

    print_string("Rolls:");
    for 1..33 { show_int(random_int(*r, 1, 6)); }
    print_line("");

    // Card c is the rank c / 4 and the suit c % 4.
    cards : [52]int;
    for 0..51 { cards[it] = it; }
    random_shuffle(*r, cards.data, 52, size_of(int));
    print_string("Cards:");
    for cards {
        print_string(" ");
        print_byte("A23456789TJQK"[it / 4]);
        print_byte("hcds"[it % 4]);
    }
    print_line("");

    // A 64-bit number is two 32-bit ones, the first the high half: the
    // demo's first two.
    random_seed(*r, 42, 54);
    print_string("u64:");
    show_bool(random_u64(*r) == 0xa15c02b77b47f409);
    print_line("");

    // A float is the top 53 bits of a 64-bit number over 2^53, so scaling
    // it back gives those bits exactly: 0xa15c02b77b47f409 >> 11.
    random_seed(*r, 42, 54);
    f := random_float64(*r);
    print_string("float64:");
    show_bool(cast(u64) (f * 9007199254740992.0) == 0x142b8056ef68fe);
    show_bool(f >= 0.0 && f < 1.0);
    print_line("");

    // Ranges from one generator, without reseeding: a small one, the same
    // with its bounds the wrong way round, all of int, exactly 2^32 values
    // (a 32-bit number added to the low bound), 2^32 + 1 values (the 64-bit
    // path), two values at int's most negative end, and one value, which
    // still draws.
    random_seed(*r, 1, 1);
    print_string("-3..3:");
    for 1..20 { show_int(random_int(*r, -3, 3)); }
    print_line("");
    print_string("3..-3:");
    for 1..5 { show_int(random_int(*r, 3, -3)); }
    print_line("");
    print_string("full range:");
    for 1..2 { show_int(random_int(*r, MIN, MAX)); }
    print_line("");
    print_string("2^32 values:");
    for 1..2 { show_int(random_int(*r, 0, 4294967295)); }
    print_line("");
    print_string("2^32 + 1 values:");
    for 1..2 { show_int(random_int(*r, 0, 4294967296)); }
    print_line("");
    print_string("MIN..MIN + 1:");
    for 1..2 { show_int(random_int(*r, MIN, MIN + 1)); }
    print_line("");
    print_string("7..7:");
    show_int(random_int(*r, 7, 7));
    print_line("");

    // A shuffle of one-byte elements.
    random_seed(*r, 9, 9);
    letters := u8.["a"[0], "b"[0], "c"[0], "d"[0], "e"[0], "f"[0], "g"[0], "h"[0], "i"[0], "j"[0]];
    random_shuffle(*r, letters.data, 10, 1);
    view : []u8 = letters;
    print_string("shuffle: ");
    print_line(cast(string) view);

    // Shuffles of no elements, of one, and of elements of no size draw
    // nothing and touch nothing: the generator gives next what it gave
    // first after the same seed.
    random_seed(*r, 5, 0);
    first := random_u32(*r);
    random_seed(*r, 5, 0);
    one := 1;
    random_shuffle(*r, null, 0, 8);
    random_shuffle(*r, *one, 1, 8);
    random_shuffle(*r, *one, 5, 0);
    print_string("shuffle of 0 and 1:");
    show_bool(random_u32(*r) == first && one == 1);
    print_line("");

    // Many draws from a small range: every value is in it, and each is
    // seen.
    random_seed(*r, 2, 3);
    seen : [11]bool;
    inside := true;
    for 1..100000 {
        v := random_int(*r, -5, 5);
        if v < -5 || v > 5 {
            inside = false;
        } else {
            seen[v + 5] = true;
        }
    }
    for seen {
        if !it { inside = false; }
    }
    print_string("-5..5 all seen, none outside:");
    show_bool(inside);
    print_line("");

    // Many floats, each in [0, 1).
    in_range := true;
    for 1..100000 {
        x := random_float64(*r);
        if x < 0.0 || x >= 1.0 { in_range = false; }
    }
    print_string("float64 in [0, 1):");
    show_bool(in_range);
    print_line("");

    // A generator seeded from the clock: what it gives varies, but not the
    // range it gives it in.
    t := random_from_time();
    v := random_int(*t, 10, 20);
    print_string("from time:");
    show_bool(v >= 10 && v <= 20);
    print_line("");
}
