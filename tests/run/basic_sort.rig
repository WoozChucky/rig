// Basic's sorting and searching (issue #145): a stable merge sort through
// procedure values, of ints at int's extremes, of pairs with equal keys
// (seven, and a thousand), of strings and of floats with NaNs and
// infinities, of zeros of either sign; the comparisons, none of which
// takes equal values for less; the scratch memory it asks for and gives
// back; no elements, one, elements of no size and four elements, which ask
// for nothing, five, which ask for scratch, elements too large for it and
// ones whose scratch is exactly int's largest number of bytes;
// sort_by_merging and sort_by_insertion checking their own arguments; a
// thousand ints scrambled, in order and the other way round, and the
// comparisons each takes; the same sort without memory, still stable; and
// a less that is no order, which loses no element and touches nothing
// around them. Then binary search, a lower bound, before the first
// element, among equal ones, between two and after the last, of nothing
// and of elements of no size or a negative one, and of strings; the
// elements it hands compare, and when it calls it not at all; and
// compare_int at int's extremes.
#import "Basic";

// What a counting allocator was asked to do: how many allocations and
// frees, and how many bytes the last allocation was for.
Counter :: struct { allocations: int; frees: int; last_size: int; }

// Passes every call on to the heap, counting allocations and frees.
counting_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE {
        counter.allocations += 1;
        counter.last_size = size;
    }
    if mode == FREE { counter.frees += 1; }
    return HEAP_ALLOCATOR.proc(mode, size, old_size, old_memory, HEAP_ALLOCATOR.data);
}

// Gives no memory, as an allocator that has run out would.
null_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    return null;
}

// Counts allocations and frees as counting_allocator_proc does, but gives
// no memory, so a request of any size can be made of it.
counting_null_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE {
        counter.allocations += 1;
        counter.last_size = size;
    }
    if mode == FREE { counter.frees += 1; }
    return null;
}

// A key to sort by, and the order the pair had before the sort, which a
// stable sort keeps among equal keys.
Pair :: struct { key: int; order: int; }

// Whether a's key is below b's, the order left out, so that pairs of one
// key are equal to the sort.
less_key :: (a: *void, b: *void) -> bool {
    return (cast(*Pair) a).key < (cast(*Pair) b).key;
}

// How many comparisons less_counted, never_less, always_less and
// alternating_less have made.
comparisons : int;

// less_int, counting each call.
less_counted :: (a: *void, b: *void) -> bool {
    comparisons += 1;
    return less_int(a, b);
}

// Says of no element that it goes before another, counting each call, and
// looks at neither, so it can be handed elements that aren't there.
never_less :: (a: *void, b: *void) -> bool {
    comparisons += 1;
    return false;
}

// Says of every element that it goes before any other, itself included,
// counting each call: no strict weak order, since nothing may be less than
// itself.
always_less :: (a: *void, b: *void) -> bool {
    comparisons += 1;
    return true;
}

// Says no and yes in turn, whatever the elements, counting each call: no
// order at all.
alternating_less :: (a: *void, b: *void) -> bool {
    comparisons += 1;
    return comparisons % 2 == 0;
}

// The bytes binary_search is searching, from search_start up to
// search_end, whether compare_checked has been given an element outside
// them, and how many times it has been called.
search_start : *u8;
search_end : *u8;
outside : bool;
compare_calls : int;

// compare_int, counting each call and noting an element outside
// search_start..search_end, which it then doesn't read.
compare_checked :: (key: *void, element: *void) -> int {
    compare_calls += 1;
    at := cast(*u8) element;
    if at < search_start || at >= search_end {
        outside = true;
        return 0;
    }
    return compare_int(key, element);
}

// Prints a space, then index/found.
show_search :: (index: int, found: bool) {
    print_string(" ");
    print_int(index);
    print_string("/");
    print_bool(found);
}

// Prints a space, then value.
show_int :: (value: int) {
    print_string(" ");
    print_int(value);
}

// Prints a space, then value.
show_bool :: (value: bool) {
    print_string(" ");
    print_bool(value);
}

// Prints a space, then each pair as key/order.
show_pairs :: (pairs: []Pair) {
    for pairs {
        print_string(" ");
        print_int(it.key);
        print_string("/");
        print_int(it.order);
    }
}

// Whether the count ints at data run from 0 up by one.
counts_up :: (data: *int, count: int) -> bool {
    for 0..count - 1 {
        if data[it] != it { return false; }
    }
    return true;
}

// Fills the thousand ints between guarded's first and last, two sentinels
// of -1, with 0 to 999 in a scrambled order, sorts them by less with
// allocator, and prints whether the sentinels are still -1 and whether
// each of 0 to 999 is still there once, which sorting the thousand again
// by less_int shows.
show_unordered_sort :: (guarded: *int, less: (a: *void, b: *void) -> bool, allocator: Allocator) {
    guarded[0] = -1;
    guarded[1001] = -1;
    for 0..999 { guarded[it + 1] = (it * 7919) % 1000; }
    comparisons = 0;
    sort(*guarded[1], 1000, size_of(int), less, allocator);
    print_string(" sentinels");
    show_bool(guarded[0] == -1 && guarded[1001] == -1);
    sort(*guarded[1], 1000, size_of(int), less_int, HEAP_ALLOCATOR);
    print_string(", each once");
    show_bool(counts_up(*guarded[1], 1000));
}

// Whether the pairs are in order of key and, among equal keys, in the
// order they had.
in_stable_order :: (pairs: []Pair) -> bool {
    for 1..pairs.count - 1 {
        before := pairs[it - 1];
        after := pairs[it];
        if after.key < before.key { return false; }
        if after.key == before.key && after.order < before.order { return false; }
    }
    return true;
}

main :: () {
    // Ints, int's extremes and two equal ones among them, sorted with
    // scratch memory from an allocator that counts: one allocation, given
    // back, for the first half of the ints, 5 of 8 bytes each.
    counter : Counter;
    counting := Allocator.{counting_allocator_proc, *counter};
    numbers := int.[5, -3, 9, 0, -3, 7, 2, 9223372036854775807, -9223372036854775808, 1];
    sort(numbers.data, 10, size_of(int), less_int, counting);
    print_string("ints:");
    for numbers { show_int(it); }
    print_line("");
    print_string("allocations: ");
    print_int(counter.allocations);
    print_string(", frees: ");
    print_int(counter.frees);
    print_line("");
    print_string("scratch bytes:");
    show_int(counter.last_size);
    print_line("");

    // Pairs with equal keys keep the order they had.
    pairs : [7]Pair;
    keys := int.[3, 1, 2, 1, 3, 2, 1];
    for 0..6 { pairs[it] = Pair.{keys[it], it}; }
    sort(pairs.data, 7, size_of(Pair), less_key, HEAP_ALLOCATOR);
    print_string("stable:");
    show_pairs(pairs);
    print_line("");

    // A thousand pairs of ten keys, so that the equal keys meet in merges
    // of long runs.
    many : [1000]Pair;
    for 0..999 { many[it] = Pair.{(it * 7919) % 10, it}; }
    sort(many.data, 1000, size_of(Pair), less_key, HEAP_ALLOCATOR);
    print_string("1000 stable:");
    show_bool(in_stable_order(many));
    print_line("");

    // Strings, by their bytes: the empty one first, a capital before a
    // small letter, and a prefix before the longer string.
    words := string.["pear", "apple", "fig", "", "apple pie", "Apple"];
    sort(words.data, 6, size_of(string), less_string, HEAP_ALLOCATOR);
    print_string("strings:");
    for words {
        print_string(" [");
        print_string(it);
        print_string("]");
    }
    print_line("");

    // Floats, NaNs and infinities among them, worked out at run time: the
    // NaNs go last.
    zero : float64 = 0;
    nan := zero / zero;
    floats := float64.[3.5, nan, -1, 1 / zero, -1 / zero, 0, nan, 2.25];
    sort(floats.data, 8, size_of(float64), less_float64, HEAP_ALLOCATOR);
    print_string("floats:");
    for floats {
        print_string(" ");
        print_float(it, 2);
    }
    print_line("");

    // Zeros of either sign are equal, and keep their order.
    negative_zero := -zero;
    zeros := float64.[0, negative_zero, 1, negative_zero, 0];
    sort(zeros.data, 5, size_of(float64), less_float64, HEAP_ALLOCATOR);
    print_string("zeros:");
    for zeros {
        print_string(" ");
        print_float(it, 2);
    }
    print_line("");

    // Nothing is less than itself or an equal value, or the sort wouldn't
    // be stable: an int, a string, two NaNs, and -0.0 and 0.0 either way.
    seven := 7;
    fig := "fig";
    print_string("equal not less:");
    show_bool(less_int(*seven, *seven));
    show_bool(less_string(*fig, *fig));
    show_bool(less_float64(*nan, *nan));
    show_bool(less_float64(*negative_zero, *zero));
    show_bool(less_float64(*zero, *negative_zero));
    print_line("");

    // No elements, one, and elements of no size or a negative one ask for
    // no memory and change nothing.
    fresh : Counter;
    counting = Allocator.{counting_allocator_proc, *fresh};
    sort(null, 0, 8, less_int, counting);
    single := int.[42];
    sort(single.data, 1, 8, less_int, counting);
    sort(single.data, 5, 0, less_int, counting);
    sort(single.data, 5, -8, less_int, counting);
    print_string("none and one: [");
    print_int(single[0]);
    print_string("] allocations ");
    print_int(fresh.allocations);
    print_line("");

    // Up to four elements are sorted by insertion, asking for no memory;
    // five are merged, with scratch for two of them.
    four := int.[4, 2, 3, 1];
    sort(four.data, 4, size_of(int), less_int, counting);
    print_string("four:");
    for four { show_int(it); }
    print_string(", allocations ");
    print_int(fresh.allocations);
    print_line("");
    five := int.[4, 5, 2, 3, 1];
    sort(five.data, 5, size_of(int), less_int, counting);
    print_string("five:");
    for five { show_int(it); }
    print_string(", allocations ");
    print_int(fresh.allocations);
    print_string(", scratch bytes ");
    print_int(fresh.last_size);
    print_line("");

    // Eight elements so large that the scratch for four of them, 4 times
    // 4611686018427387905 bytes, would wrap past int's largest to 4 bytes
    // without sort's guard: sort asks for no memory and sorts by insertion
    // instead. never_less looks at no element, so none is read or written,
    // with the guard or without it.
    huge : Counter;
    counting = Allocator.{counting_allocator_proc, *huge};
    lone := 0;
    sort(*lone, 8, 4611686018427387905, never_less, counting);
    print_string("too large for scratch: allocations ");
    print_int(huge.allocations);
    print_line("");

    // Fourteen elements of 1317624576693539401 bytes, int's largest over 7:
    // the scratch for seven of them is exactly int's largest number of
    // bytes, which an int can count, so sort asks for it. The allocator has
    // none, and the elements are sorted by insertion, 13 comparisons for
    // never_less, which looks at no element.
    largest : Counter;
    counting = Allocator.{counting_null_allocator_proc, *largest};
    comparisons = 0;
    sort(*lone, 14, 1317624576693539401, never_less, counting);
    print_string("largest scratch: allocations ");
    print_int(largest.allocations);
    print_string(", size ");
    print_int(largest.last_size);
    print_string(", comparisons ");
    print_int(comparisons);
    print_line("");

    // sort_by_merging and sort_by_insertion check their own arguments:
    // elements of no size, or a negative one, and a single element, are not
    // compared.
    comparisons = 0;
    six := int.[6, 5, 4, 3, 2, 1];
    spare := int.[0, 0, 0];
    sort_by_merging(six.data, spare.data, 6, 0, never_less);
    sort_by_merging(six.data, spare.data, 6, -8, never_less);
    print_string("merging no size: comparisons ");
    print_int(comparisons);
    print_line("");
    sort_by_insertion(six.data, 6, 0, never_less);
    sort_by_insertion(six.data, 6, -8, never_less);
    sort_by_insertion(null, 1, 8, never_less);
    print_string("insertion no size: comparisons ");
    print_int(comparisons);
    print_line("");

    // A thousand ints, every one of 0 to 999 once, in a scrambled order (7919
    // is prime, so it * 7919 % 1000 meets each once), then already in order,
    // then the other way round. Any order takes at most about n log2 n
    // comparisons, under 1000 * 10; elements in order take n - 1, one for
    // each neighbour in the insertion runs and one where each merge finds
    // its halves in order already.
    big : [1000]int;
    for 0..999 { big[it] = (it * 7919) % 1000; }
    comparisons = 0;
    sort(big.data, 1000, size_of(int), less_counted, HEAP_ALLOCATOR);
    print_string("1000 scrambled:");
    show_bool(counts_up(big.data, 1000));
    print_string(", comparisons at most 10000:");
    show_bool(comparisons <= 1000 * 10);
    print_line("");
    comparisons = 0;
    sort(big.data, 1000, size_of(int), less_counted, HEAP_ALLOCATOR);
    print_string("1000 in order:");
    show_bool(counts_up(big.data, 1000));
    print_string(", comparisons");
    show_int(comparisons);
    print_line("");
    for 0..999 { big[it] = 999 - it; }
    comparisons = 0;
    sort(big.data, 1000, size_of(int), less_counted, HEAP_ALLOCATOR);
    print_string("1000 reversed:");
    show_bool(counts_up(big.data, 1000));
    print_string(", comparisons at most 10000:");
    show_bool(comparisons <= 1000 * 10);
    print_line("");

    // Without memory the sort is done in place, and is still stable.
    none := Allocator.{null_allocator_proc, null};
    few := int.[5, 3, 1, 4, 2];
    sort(few.data, 5, size_of(int), less_int, none);
    print_string("without memory:");
    for few { show_int(it); }
    print_line("");
    for 0..6 { pairs[it] = Pair.{keys[it], it}; }
    sort(pairs.data, 7, size_of(Pair), less_key, none);
    print_string("stable without memory:");
    show_pairs(pairs);
    print_line("");

    // A less that is no strict weak order, one that says every element
    // goes first and one that says no and yes in turn, with scratch memory
    // and without: the thousand ints between two sentinels come out in some
    // order, each still there once, and the sentinels are untouched.
    guarded : [1002]int;
    print_string("always less:");
    show_unordered_sort(guarded.data, always_less, HEAP_ALLOCATOR);
    print_string(";");
    show_unordered_sort(guarded.data, always_less, none);
    print_line("");
    print_string("alternating less:");
    show_unordered_sort(guarded.data, alternating_less, HEAP_ALLOCATOR);
    print_string(";");
    show_unordered_sort(guarded.data, alternating_less, none);
    print_line("");

    // The first index whose element isn't below the key, and whether the
    // key is there: before the first element, at it, the first of three
    // equal ones, between two, the last, and after it.
    sorted := int.[1, 3, 3, 3, 5, 7];
    print_string("search:");
    for int.[0, 1, 3, 4, 7, 8] {
        wanted := it;
        index, found := binary_search(sorted.data, 6, size_of(int), *wanted, compare_int);
        show_search(index, found);
    }
    print_line("");

    // Nothing to search, and elements of no size or a negative one, find
    // nothing at 0.
    key := 3;
    index, found := binary_search(null, 0, 8, *key, compare_int);
    print_string("search empty:");
    show_search(index, found);
    print_line("");
    index, found = binary_search(sorted.data, 6, 0, *key, compare_int);
    print_string("search no size:");
    show_search(index, found);
    index, found = binary_search(sorted.data, 6, -8, *key, compare_int);
    show_search(index, found);
    print_line("");

    // The sorted words, searched with compare_string, which takes pointers
    // to two strings.
    print_string("search strings:");
    for string.["fig", "zz", ""] {
        word := it;
        index, found = binary_search(words.data, 6, size_of(string), *word, compare_string);
        show_search(index, found);
    }
    print_line("");

    // binary_search hands compare only elements among the ones it is
    // given: for keys before them, among them and after the last, where it
    // doesn't look past the end. Nothing to search, and elements of no size
    // or a negative one, call compare not at all.
    search_start = cast(*u8) sorted.data;
    search_end = search_start + 6 * size_of(int);
    for int.[0, 1, 3, 4, 7, 8] {
        wanted := it;
        index, found = binary_search(sorted.data, 6, size_of(int), *wanted, compare_checked);
    }
    print_string("search inside: outside");
    show_bool(outside);
    compare_calls = 0;
    index, found = binary_search(null, 0, 8, *key, compare_checked);
    index, found = binary_search(sorted.data, 6, 0, *key, compare_checked);
    index, found = binary_search(sorted.data, 6, -8, *key, compare_checked);
    print_string(", calls for none");
    show_int(compare_calls);
    print_line("");

    // compare_int gives -1, 0 or 1, at int's extremes too, where the
    // difference of the two would overflow; and a search among the
    // extremes finds them, and 1 between them.
    one := 1;
    three := 3;
    smallest : int = -9223372036854775808;
    largest_int : int = 9223372036854775807;
    print_string("compare_int:");
    show_int(compare_int(*one, *three));
    show_int(compare_int(*three, *three));
    show_int(compare_int(*three, *one));
    show_int(compare_int(*smallest, *largest_int));
    show_int(compare_int(*largest_int, *smallest));
    print_line("");
    extremes := int.[-9223372036854775808, 9223372036854775807];
    print_string("search extremes:");
    for int.[-9223372036854775808, 1, 9223372036854775807] {
        wanted := it;
        index, found = binary_search(extremes.data, 2, size_of(int), *wanted, compare_int);
        show_search(index, found);
    }
    print_line("");
}
