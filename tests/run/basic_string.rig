// Basic's string views (issue #134): comparing, finding, trimming, slicing
// and splitting, with empty strings, zeroed strings (count 0, data null)
// and the clamps that keep a slice inside its string.
#import "Basic";

// int's largest and most negative values, for the clamps.
MAX :: 9223372036854775807;
MIN :: -9223372036854775808;

// Prints the count of s, then s between brackets, so an empty string shows
// as 0 [], and a line feed. The count is printed too because print_string
// writes nothing for a negative count, so a view clamped wrongly would
// otherwise show as [] like an empty one.
show :: (s: string) {
    print_int(s.count);
    print_byte(32);
    print_byte("["[0]);
    print_string(s);
    print_byte("]"[0]);
    print_byte(10);
}

// Prints count, then each of the first count parts between brackets, and a
// line feed.
show_parts :: (count: int, parts: []string) {
    print_int(count);
    for i: 0..count - 1 {
        print_byte(32);
        print_byte("["[0]);
        print_string(parts[i]);
        print_byte("]"[0]);
    }
    print_byte(10);
}

main :: () {
    empty : string;
    parts : [8]string;
    two : []string = parts;
    two.count = 2;
    one : []string = parts;
    one.count = 1;
    none : []string;

    print_bool(strings_equal("abc", "abc"));
    print_byte(32);
    print_bool(strings_equal("abc", "abd"));
    print_byte(32);
    print_bool(strings_equal("", empty));
    print_byte(32);
    print_bool(strings_equal("ab", "abc"));
    print_byte(32);
    // strings_equal as a procedure value, which is what it is there for.
    equal : (string, string) -> bool = strings_equal;
    print_bool(equal("abc", "abc"));
    print_byte(32);
    print_bool(equal("abc", "abd"));
    print_byte(10);

    // A prefix sorts first, by -1 or 1 however much shorter it is, and bytes
    // compare unsigned: "é" starts with 0xC3, above "z".
    print_int(compare_strings("abc", "abd"));
    print_byte(32);
    print_int(compare_strings("abd", "abc"));
    print_byte(32);
    print_int(compare_strings("abc", "abc"));
    print_byte(32);
    print_int(compare_strings("ab", "abc"));
    print_byte(32);
    print_int(compare_strings("abc", "ab"));
    print_byte(32);
    print_int(compare_strings("", ""));
    print_byte(32);
    print_int(compare_strings("é", "z"));
    print_byte(32);
    print_int(compare_strings("a", "abcd"));
    print_byte(32);
    print_int(compare_strings("abcd", "a"));
    print_byte(10);

    // Each search also finds a match at the edge of the places it tries:
    // index 0 when searching from the end, and the last place a needle fits
    // when searching from the start.
    print_int(find_byte("hello", "l"[0]));
    print_byte(32);
    print_int(find_byte_from_end("hello", "l"[0]));
    print_byte(32);
    print_int(find_byte("hello", "z"[0]));
    print_byte(32);
    print_int(find_byte(empty, "a"[0]));
    print_byte(32);
    print_int(find_byte_from_end("hello", "h"[0]));
    print_byte(32);
    print_int(find_byte_from_end("hello", "z"[0]));
    print_byte(32);
    print_int(find_byte("hello", "o"[0]));
    print_byte(10);

    print_int(find_string("hello world", "o w"));
    print_byte(32);
    print_int(find_string("hello", ""));
    print_byte(32);
    print_int(find_string("hello", "hello!"));
    print_byte(32);
    print_int(find_string("aaa", "aa"));
    print_byte(32);
    print_int(find_string(empty, "a"));
    print_byte(32);
    print_int(find_string(empty, ""));
    print_byte(32);
    print_int(find_string("hello", "lo"));
    print_byte(32);
    print_int(find_string("hello", "hello"));
    print_byte(10);

    print_int(find_string_from_end("aaa", "aa"));
    print_byte(32);
    print_int(find_string_from_end("hello", ""));
    print_byte(32);
    print_int(find_string_from_end("abcabc", "abc"));
    print_byte(32);
    print_int(find_string_from_end("abc", "abcd"));
    print_byte(32);
    print_int(find_string_from_end("abc", "abc"));
    print_byte(32);
    print_int(find_string_from_end("abcab", "ab"));
    print_byte(32);
    print_int(find_string_from_end("abcd", "ab"));
    print_byte(10);

    print_bool(starts_with("hello", "he"));
    print_byte(32);
    print_bool(starts_with("hello", ""));
    print_byte(32);
    print_bool(starts_with("he", "hello"));
    print_byte(32);
    print_bool(starts_with("hello", "hex"));
    print_byte(32);
    print_bool(ends_with("hello", "lo"));
    print_byte(32);
    print_bool(ends_with("hello", "he"));
    print_byte(32);
    print_bool(ends_with(empty, ""));
    print_byte(10);

    show(trim("  \t hi there \n"));
    show(trim_left("  x  "));
    show(trim_right("  x  "));
    show(trim("   "));
    show(trim_left("   "));
    show(trim_right("   "));
    show(trim(empty));

    // A slice is clamped to its string: start to 0..count, then count to
    // what is left after start.
    show(slice("hello", 1, 3));
    show(slice("hello", 3, 10));
    show(slice("hello", -2, 2));
    show(slice("hello", 9, 1));
    show(slice("hello", 2, -1));

    show(advance("hello", 2));
    show(advance("hello", 9));
    show(advance("hello", -1));

    // Empty pieces count, and when parts runs out its last one holds the
    // rest, unsplit.
    show_parts(split("a,b,,c", ","[0], parts), parts);
    show_parts(split("", ","[0], parts), parts);
    show_parts(split("a,b,c", ","[0], two), two);
    show_parts(split(",", ","[0], parts), parts);
    show_parts(split("a,b", ","[0], one), one);
    show_parts(split("a,b", ","[0], none), none);

    found, before, after := split_from_left("key=value=x", "="[0]);
    print_bool(found);
    print_string(" [");
    print_string(before);
    print_string("] [");
    print_string(after);
    print_line("]");

    found, before, after = split_from_left("novalue", "="[0]);
    print_bool(found);
    print_string(" [");
    print_string(before);
    print_string("] [");
    print_string(after);
    print_line("]");

    // A separator at either end leaves an empty piece on that side.
    found, before, after = split_from_left("=x", "="[0]);
    print_bool(found);
    print_string(" [");
    print_string(before);
    print_string("] [");
    print_string(after);
    print_line("]");

    found, before, after = split_from_left("k=", "="[0]);
    print_bool(found);
    print_string(" [");
    print_string(before);
    print_string("] [");
    print_string(after);
    print_line("]");

    // A slice views its string's own bytes: nothing is copied. A start past
    // the end gives an empty view at the string's end, and so does
    // split_from_left for the bytes after a separator it doesn't find.
    s := "hello";
    part := slice(s, 1, 3);
    print_bool(part.data == s.data + 1);
    print_byte(32);
    part = slice(s, 9, 1);
    print_bool(part.data == s.data + s.count);
    print_byte(32);
    part = slice(s, MAX, MAX);
    print_bool(part.data == s.data + s.count);
    print_byte(32);
    found, before, after = split_from_left(s, "="[0]);
    print_bool(after.data == s.data + s.count);
    print_byte(10);

    // A zeroed string through the procedures not yet given one, and as the
    // needle, prefix and suffix: it is the empty string, and nothing reads
    // through its null data.
    print_int(compare_strings(empty, ""));
    print_byte(32);
    print_int(compare_strings(empty, "a"));
    print_byte(32);
    print_int(compare_strings("a", empty));
    print_byte(32);
    print_int(find_byte_from_end(empty, "a"[0]));
    print_byte(32);
    print_int(find_string_from_end(empty, ""));
    print_byte(32);
    print_int(find_string_from_end(empty, "a"));
    print_byte(32);
    print_bool(starts_with(empty, ""));
    print_byte(32);
    print_bool(starts_with(empty, "a"));
    print_byte(32);
    print_bool(ends_with(empty, "a"));
    print_byte(10);
    print_int(find_string("hello", empty));
    print_byte(32);
    print_int(find_string_from_end("hello", empty));
    print_byte(32);
    print_bool(starts_with("hello", empty));
    print_byte(32);
    print_bool(ends_with("hello", empty));
    print_byte(10);
    show(trim_left(empty));
    show(trim_right(empty));
    show(slice(empty, 0, 1));
    show(advance(empty, 1));
    show_parts(split(empty, ","[0], parts), parts);
    found, before, after = split_from_left(empty, "="[0]);
    print_bool(found);
    print_string(" [");
    print_string(before);
    print_string("] [");
    print_string(after);
    print_line("]");

    // int's extremes are clamped like any other number, and nothing in the
    // clamps overflows.
    show(slice("hello", 1, MAX));
    show(slice("hello", MIN, 2));
    show(slice("hello", MAX, MAX));
    show(slice("hello", 2, MIN));
    show(advance("hello", MIN));
    show(advance("hello", MAX));
}
