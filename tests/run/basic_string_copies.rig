// Basic's string copies (issue #145): contains and count_of, then join,
// replace, repeat, to_upper_copy and to_lower_copy, which copy into memory
// from the allocator they are given, with empty parts, empty matches and
// overlapping ones, and views of part of a string. Every copy is a copy,
// even when nothing changed; an empty result allocates nothing; the rest
// ask for their exact size once, and give the zeroed string when the
// allocator has no memory, or when the size would pass int's largest.
#import "Basic";

// int's largest value.
LARGEST :: 9223372036854775807;

// Prints s between brackets, so an empty string shows as [], and a line
// feed, then gives its memory back to the heap.
show :: (s: string) {
    print_string("[");
    print_string(s);
    print_line("]");
    free(s.data, HEAP_ALLOCATOR);
}

// Prints result between brackets and whether it is a copy, at another
// address than original's, then gives its memory back to the heap.
show_copied :: (result: string, original: string) {
    print_string("[");
    print_string(result);
    print_string("] copied:");
    show_bool(result.data != original.data);
    print_line("");
    free(result.data, HEAP_ALLOCATOR);
}

// Prints a space, then value.
show_bool :: (value: bool) {
    print_string(" ");
    print_bool(value);
}

// Prints a space, then value.
show_int :: (value: int) {
    print_string(" ");
    print_int(value);
}

// Prints a space, then whether s is the zeroed string, count 0 and data
// null.
show_zeroed :: (s: string) {
    show_bool(s.count == 0 && s.data == null);
}

// How many allocations an allocator was asked for, and the size of the
// last.
Counter :: struct {
    allocations: int;
    last_size: int;
}

// Passes every call on to the heap, counting the allocations and keeping
// the size of the last.
counting_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE {
        counter.allocations += 1;
        counter.last_size = size;
    }
    return HEAP_ALLOCATOR.proc(mode, size, old_size, old_memory, HEAP_ALLOCATOR.data);
}

// Counts the allocations it is asked for, as counting_allocator_proc does,
// and gives no memory, as an allocator that has run out would.
refusing_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE {
        counter.allocations += 1;
        counter.last_size = size;
    }
    return null;
}

main :: () {
    counter : Counter;
    counting := Allocator.{counting_allocator_proc, *counter};
    empty : string;
    none : []string;

    // Every string contains "", the empty and the zeroed string too, as
    // find_string finds it at 0.
    print_bool(contains("hello world", "o w"));
    show_bool(contains("hello", ""));
    show_bool(contains("", "a"));
    show_bool(contains(empty, ""));
    show_bool(contains("abc", "abcd"));
    print_line("");

    // Matches are counted left to right without overlap, and "" matches
    // nothing.
    print_int(count_of("banana", "an"));
    show_int(count_of("aaaa", "aa"));
    show_int(count_of("abc", ""));
    show_int(count_of(empty, "a"));
    show_int(count_of("abcabc", "abc"));
    print_line("");

    // A separator goes between each two parts, empty parts included, and
    // not around one part alone. No parts join to the empty string.
    show(join(string.["a", "b", "c"], ", ", HEAP_ALLOCATOR));
    show(join(none, ", ", HEAP_ALLOCATOR));
    show(join(string.["", ""], "-", HEAP_ALLOCATOR));
    x := "x";
    show_copied(join(string.[x], "--", HEAP_ALLOCATOR), x);

    // Matches are replaced left to right without overlap, and what replaces
    // one is never searched again.
    show(replace("a-b-c", "-", "+", HEAP_ALLOCATOR));
    show(replace("aaa", "a", "bb", HEAP_ALLOCATOR));
    show(replace("abab", "ab", "ba", HEAP_ALLOCATOR));
    show(replace("aaaa", "aa", "a", HEAP_ALLOCATOR));
    show(replace("hello", "z", "y", HEAP_ALLOCATOR));

    // An empty old matches nothing, and the result is still a copy.
    h := "hello";
    show_copied(replace(h, "", "x", HEAP_ALLOCATOR), h);

    show(replace("abc", "abc", "", HEAP_ALLOCATOR));

    // Repeating nothing, or anything no times or fewer, is empty.
    show(repeat("ab", 3, HEAP_ALLOCATOR));
    show(repeat("ab", 0, HEAP_ALLOCATOR));
    show(repeat("ab", -1, HEAP_ALLOCATOR));
    show(repeat("", 5, HEAP_ALLOCATOR));
    // Once is still a copy.
    show_copied(repeat(h, 1, HEAP_ALLOCATOR), h);

    // ASCII letters change case; every other byte, UTF-8's included, stays.
    show(to_upper_copy("Hello, Wörld! 09", HEAP_ALLOCATOR));
    show(to_lower_copy("ÀBC Def", HEAP_ALLOCATOR));
    show(to_upper_copy(empty, HEAP_ALLOCATOR));
    // A copy that changes no byte is still a copy.
    capitals := "ABC";
    show_copied(to_upper_copy(capitals, HEAP_ALLOCATOR), capitals);
    digits := "09";
    show_copied(to_lower_copy(digits, HEAP_ALLOCATOR), digits);

    // An empty result is the zeroed string, which asks the allocator for
    // nothing.
    join(string.["", ""], "", counting);
    replace("abc", "abc", "", counting);
    repeat("", 9, counting);
    to_lower_copy("", counting);
    print_string("empty results allocate:");
    show_int(counter.allocations);
    print_line("");

    // Any other result is one allocation.
    j := join(string.["a", "b"], "+", counting);
    print_string("one allocation:");
    show_int(counter.allocations);
    print_line("");
    free(j.data, counting);

    // A view of part of a string is read only as far as the view goes: the
    // bytes after it would make another match.
    print_string("views:");
    show_int(count_of(slice("aaaa", 0, 3), "aa"));
    show_bool(contains(slice("abcd", 0, 3), "cd"));
    print_string(" ");
    show(replace(slice("a-b-c", 0, 3), "-", "+", HEAP_ALLOCATOR));

    // Each copy asks for its exact size, worked out before it is filled,
    // and an allocator with no memory gives the zeroed string.
    refused : Counter;
    refusing := Allocator.{refusing_allocator_proc, *refused};
    print_string("no memory:");
    joined := join(string.["a", "b", "c"], ", ", refusing);
    show_int(refused.last_size);
    show_zeroed(joined);
    replaced := replace("a-b", "-", "--", refusing);
    show_int(refused.last_size);
    show_zeroed(replaced);
    repeated := repeat("abc", 2, refusing);
    show_int(refused.last_size);
    show_zeroed(repeated);
    upper := to_upper_copy("hello", refusing);
    show_int(refused.last_size);
    show_zeroed(upper);
    lower := to_lower_copy("ABC", refusing);
    show_int(refused.last_size);
    show_zeroed(lower);
    print_line("");

    // Sizes up to int's largest are asked for. The halves here, and wide
    // below, claim more bytes than they have, which is safe only because
    // the allocator gives nothing, so no byte is copied.
    half : string;
    half.data = "x".data;
    half.count = LARGEST / 2;
    print_string("int's largest:");
    show_zeroed(join(string.[half, half], "-", refusing));
    show_int(refused.last_size);
    show_zeroed(repeat("ab", LARGEST / 2, refusing));
    show_int(refused.last_size);
    print_line("");

    // Past it, each size below, worked out unchecked, would wrap round to a
    // small size above 0, which an allocator could give, and the copy would
    // write far past it. So each call must give the zeroed string and leave
    // the allocator unasked: five halves joined, five parts joined by a
    // separator of 2^62 bytes (4 gaps make 2^64, which wraps to 0), five
    // bytes each replaced by a half, and 4 bytes repeated 2^62 + 1 times.
    wide : string;
    wide.data = "x".data;
    wide.count = LARGEST / 2 + 1;
    asked := refused.allocations;
    print_string("past it:");
    show_zeroed(join(string.[half, half, half, half, half], "", refusing));
    show_bool(refused.allocations == asked);
    show_zeroed(join(string.["a", "b", "c", "d", "e"], wide, refusing));
    show_bool(refused.allocations == asked);
    show_zeroed(replace("aaaaa", "a", half, refusing));
    show_bool(refused.allocations == asked);
    show_zeroed(repeat("abcd", LARGEST / 2 + 2, refusing));
    show_bool(refused.allocations == asked);
    print_line("");
}
