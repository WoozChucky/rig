// Basic's hash tables (issue #134): both kinds of key, strings and ints,
// how the entries grow, removal across a collision chain, going over the
// entries, and values whose size isn't a multiple of 8. It also shows the
// empty-string key, a key that is a prefix of another, int's extreme
// values as keys, a rehash that only clears removed entries, and memory
// that comes from the table's allocator and goes back to it, keys included.
#load "../../modules/Basic/module.rig";

WORDS :: string.["apple", "banana", "cherry", "date", "elderberry", "fig", "grape", "honeydew", "kiwi", "lemon", "mango", "nectarine", "orange", "papaya", "quince", "raspberry", "strawberry", "tangerine", "ugli", "vanilla"];

// What a counting allocator was asked to do.
Counter :: struct { allocations: int; frees: int; }

// Passes everything on to the heap, counting allocations and frees.
counting_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    counter := cast(*Counter) data;
    if mode == ALLOCATE { counter.allocations += 1; }
    if mode == FREE { counter.frees += 1; }
    return HEAP_ALLOCATOR.proc(mode, size, old_size, old_memory, HEAP_ALLOCATOR.data);
}

// Takes memory from the heap with 8 bytes more in front, which hold its
// size, so that a free can set every byte to 255 before the heap has them
// back: an address left pointing at freed memory doesn't read what was
// there. Given a Counter as its data, it counts allocations and frees too.
spoiling_allocator_proc :: (mode: int, size: int, old_size: int, old_memory: *void, data: *void) -> *void {
    if data != null {
        counter := cast(*Counter) data;
        if mode == ALLOCATE { counter.allocations += 1; }
        if mode == FREE { counter.frees += 1; }
    }
    if mode == ALLOCATE {
        memory := cast(*int) alloc(size + 8, HEAP_ALLOCATOR);
        memory.* = size;
        return memory + 1;
    }
    if mode == FREE {
        memory := cast(*int) old_memory - 1;
        set_memory(old_memory, 255, memory.*);
        free(memory, HEAP_ALLOCATOR);
    }
    return null;
}

// The first key k from start on whose hash starts its probe at the same
// entry as key's, in a table of 16 entries: the two then share a chain.
same_slot_after :: (key: int, start: int) -> int {
    k := start;
    while (hash_int(k) & 15) != (hash_int(key) & 15) { k += 1; }
    return k;
}

// The int at value, an int table's value that is there.
int_value :: (value: *void) -> int {
    return (cast(*int) value).*;
}

// Whether value is there and holds the int expected.
holds_int :: (value: *void, expected: int) -> bool {
    return value != null && (cast(*int) value).* == expected;
}

// Whether table_same_key says entry holds key. A parameter has no address,
// so both are passed as copies.
same_string_key :: (entry: Table_Entry, key: string) -> bool {
    held := entry;
    wanted := key;
    return table_same_key(cast(*u8) *held, *wanted);
}

// Whether int_table_same_key says entry holds key.
same_int_key :: (entry: Int_Table_Entry, key: int) -> bool {
    held := entry;
    wanted := key;
    return int_table_same_key(cast(*u8) *held, *wanted);
}

// Prints a table's count and capacity, separated by a space.
show_sizes :: (count: int, capacity: int) {
    print_int(count);
    print_byte(32);
    print_int(capacity);
}

main :: () {
    t : Table;
    table_init(*t, size_of(int), HEAP_ALLOCATOR);

    // A table with no entries yet is found in without touching any.
    print_string("empty table: ");
    print_bool(table_find(t, "apple") == null);
    print_byte(10);

    // 20 keys: the capacity went from 16 to 32 at the 13th.
    for WORDS {
        value := it_index;
        table_set(*t, it, *value);
    }
    print_string("count ");
    print_int(t.count);
    print_string(", capacity ");
    print_int(t.capacity);
    print_byte(10);

    all := true;
    for WORDS {
        if !holds_int(table_find(t, it), it_index) { all = false; }
    }
    print_string("all 20 found: ");
    print_bool(all);
    print_byte(10);

    // A key that is longer than one there, the empty key and a prefix of
    // one there are each another key.
    print_string("missing: ");
    print_bool(table_find(t, "cherry2") == null);
    print_byte(32);
    print_bool(table_find(t, "") == null);
    print_byte(32);
    print_bool(table_find(t, "app") == null);
    print_byte(10);

    // A probe compares keys only when their hashes are equal, and no two
    // keys here share one, so the comparison is asked directly: the same
    // count and the same bytes. A prefix, a longer key, one that differs in
    // its last byte, the empty key and the zeroed string are each another
    // key than "apple", and the empty key's entry holds both of the last.
    zeroed : string;
    apple_entry : Table_Entry;
    apple_entry.key = "apple";
    print_string("same key: ");
    print_bool(same_string_key(apple_entry, "apple"));
    print_byte(32);
    print_bool(same_string_key(apple_entry, "app"));
    print_byte(32);
    print_bool(same_string_key(apple_entry, "apples"));
    print_byte(32);
    print_bool(same_string_key(apple_entry, "apply"));
    print_byte(32);
    print_bool(same_string_key(apple_entry, ""));
    print_byte(32);
    print_bool(same_string_key(apple_entry, zeroed));
    print_string(", empty ");
    empty_entry : Table_Entry;
    print_bool(same_string_key(empty_entry, ""));
    print_byte(32);
    print_bool(same_string_key(empty_entry, zeroed));
    print_string(", int ");
    int_entry : Int_Table_Entry;
    int_entry.key = 5;
    print_bool(same_int_key(int_entry, 5));
    print_byte(32);
    print_bool(same_int_key(int_entry, 6));
    print_byte(10);

    // Setting a key that is there changes its value, and adds nothing.
    hundred := 100;
    table_set(*t, "apple", *hundred);
    print_string("apple: ");
    print_int(int_value(table_find(t, "apple")));
    print_string(", count ");
    print_int(t.count);
    print_byte(10);

    print_string("remove: ");
    print_bool(table_remove(*t, "banana"));
    print_byte(32);
    print_bool(table_remove(*t, "banana"));
    print_byte(32);
    print_bool(table_find(t, "banana") == null);
    print_byte(32);
    print_int(t.count);
    print_byte(10);

    // The empty string is a key like any other.
    zero := 0;
    table_set(*t, "", *zero);
    print_string("empty key: ");
    print_bool(holds_int(table_find(t, ""), 0));
    print_byte(32);
    print_int(t.count);
    print_byte(10);

    // The table keeps a copy of a new key, so changing the bytes the key
    // was set from changes nothing in the table.
    buffer := u8.["z"[0], "e"[0], "s"[0], "t"[0]];
    view : []u8 = buffer;
    seven := 7;
    table_set(*t, cast(string) view, *seven);
    buffer[0] = "b"[0];
    print_string("key copied: ");
    print_bool(holds_int(table_find(t, "zest"), 7));
    print_byte(32);
    print_bool(table_find(t, "best") == null);
    print_byte(32);
    print_int(t.count);
    print_byte(10);

    // 190 for indexes 0 to 19, less banana's 1, plus 100 for apple's 0,
    // plus 0 for "", plus 7 for zest. Each key given finds the value given
    // with it.
    used_count := 0;
    sum := 0;
    keys_found := true;
    for i: 0..t.capacity - 1 {
        used, key, value := table_entry(t, i);
        if used {
            used_count += 1;
            sum += int_value(value);
            if !holds_int(table_find(t, key), int_value(value)) { keys_found = false; }
        }
    }
    print_string("iteration: ");
    print_int(used_count);
    print_string(" entries, sum ");
    print_int(sum);
    print_string(", keys found ");
    print_bool(keys_found);
    print_byte(10);

    print_string("capacity ");
    print_int(t.capacity);
    print_byte(10);

    table_free(*t);
    print_string("freed: ");
    show_sizes(t.count, t.capacity);
    print_byte(10);

    // FNV-1a's offset basis is the hash of no bytes, and of a negative
    // count. "foobar" is one of FNV-1a's published test values, and
    // hash_int(1) is the hash of the bytes 01 00 00 00 00 00 00 00, as a
    // little-endian machine holds 1.
    print_string("fnv-1a: ");
    print_bool(hash_string("") == 14695981039346656037);
    print_byte(32);
    print_bool(hash_bytes(null, -1) == 14695981039346656037);
    print_byte(32);
    print_bool(hash_string("a") == 0xaf63dc4c8601ec8c);
    print_byte(32);
    print_bool(hash_string("foobar") == 0x85944171f73967e8);
    print_byte(32);
    print_bool(hash_int(1) == 0x89cd31291d2aefa4);
    print_byte(10);

    // Three keys whose probes start at the same entry of 16: the second
    // and third are found by stepping past the first.
    n : Int_Table;
    int_table_init(*n, size_of(int), HEAP_ALLOCATOR);
    k1 := 0;
    k2 := same_slot_after(k1, 1);
    k3 := same_slot_after(k1, k2 + 1);
    one := 1;
    two := 2;
    three := 3;
    int_table_set(*n, k1, *one);
    int_table_set(*n, k2, *two);
    int_table_set(*n, k3, *three);
    print_string("same slot: ");
    print_bool((hash_int(k2) & 15) == (hash_int(k1) & 15));
    print_byte(32);
    print_bool((hash_int(k3) & 15) == (hash_int(k1) & 15));
    print_byte(10);

    // Setting a key that is there changes its value and adds nothing. k1
    // is found first in its chain, with no removed entry passed.
    int_table_set(*n, k1, *hundred);
    print_string("k1 set again: ");
    print_int(int_value(int_table_find(n, k1)));
    print_string(", count ");
    print_int(n.count);
    print_byte(10);

    // k2's entry is marked removed rather than emptied, so a find of k3
    // steps past it rather than stopping there.
    print_string("int remove: ");
    print_bool(int_table_remove(*n, k2));
    print_byte(32);
    print_bool(int_table_remove(*n, k2));
    print_byte(10);
    print_string("past a removed key: ");
    print_int(int_value(int_table_find(n, k3)));
    print_byte(10);

    print_string("removed key missing: ");
    print_bool(int_table_find(n, k2) == null);
    print_byte(10);

    // A set of a key past a removed entry finds the key further along,
    // rather than taking the removed entry: k3's value changes, nothing is
    // added, and k2's entry, the one after k1's, still holds no key, the
    // removed one included.
    thirty_three := 33;
    int_table_set(*n, k3, *thirty_three);
    k2_used, k2_key, k2_value := int_table_entry(n, cast(int) ((hash_int(k1) + 1) & 15));
    print_string("set past a removed key: ");
    print_int(int_value(int_table_find(n, k3)));
    print_string(", count ");
    print_int(n.count);
    print_string(", removed ");
    print_int(n.removed);
    print_string(", k2's entry ");
    print_bool(k2_used);
    print_byte(32);
    print_int(k2_key);
    print_byte(32);
    print_bool(k2_value == null);
    print_byte(10);

    twenty_two := 22;
    int_table_set(*n, k2, *twenty_two);
    print_int(int_value(int_table_find(n, k1)));
    print_byte(32);
    print_int(int_value(int_table_find(n, k2)));
    print_byte(32);
    print_int(int_value(int_table_find(n, k3)));
    print_string(", count ");
    print_int(n.count);
    print_byte(10);

    ten := 10;
    eleven := 11;
    twelve := 12;
    int_table_set(*n, -1, *ten);
    int_table_set(*n, -9223372036854775808, *eleven);
    int_table_set(*n, 9223372036854775807, *twelve);
    print_int(int_value(int_table_find(n, -1)));
    print_byte(32);
    print_int(int_value(int_table_find(n, -9223372036854775808)));
    print_byte(32);
    print_int(int_value(int_table_find(n, 9223372036854775807)));
    print_string(", count ");
    print_int(n.count);
    print_byte(10);

    // 100 + 22 + 33 + 10 + 11 + 12, and each key given is found at the
    // value's address given with it.
    entries := 0;
    int_sum := 0;
    int_keys_found := true;
    for i: 0..n.capacity - 1 {
        used, key, value := int_table_entry(n, i);
        if used {
            entries += 1;
            int_sum += int_value(value);
            if int_table_find(n, key) != value { int_keys_found = false; }
        }
    }
    print_string("entries: ");
    print_int(entries);
    print_string(", sum ");
    print_int(int_sum);
    print_string(", keys found ");
    print_bool(int_keys_found);
    print_byte(10);

    // The new k2 took the entry the old one was removed from.
    print_string("removed entry taken again: ");
    print_int(n.removed);
    print_byte(10);
    int_table_free(*n);

    // The same for string keys. "a" and "A" differ only in bit 5 of their
    // one byte, so their probes start at the same entry of 16 (see
    // hash_bytes), and "A" is set past "a"'s entry. Once "a" is removed,
    // setting "A" again changes its value and adds nothing.
    p : Table;
    table_init(*p, size_of(int), HEAP_ALLOCATOR);
    table_set(*p, "a", *one);
    table_set(*p, "A", *two);
    table_remove(*p, "a");
    table_set(*p, "A", *three);
    print_string("string set past a removed key: ");
    print_bool((hash_string("a") & 15) == (hash_string("A") & 15));
    print_byte(32);
    print_int(int_value(table_find(p, "A")));
    print_string(", count ");
    print_int(p.count);
    print_string(", removed ");
    print_int(p.removed);
    print_byte(10);
    table_free(*p);

    // Values of one byte: each entry is its 24-byte header and 8 bytes for
    // the value, so the next entry's header, and its value, stay aligned.
    g : Int_Table;
    int_table_init(*g, size_of(bool), HEAP_ALLOCATOR);
    for 0..999 {
        yes := it % 3 == 0;
        int_table_set(*g, it * 7, *yes);
    }
    all = true;
    for 0..999 {
        found := int_table_find(g, it * 7);
        if found == null || (cast(*bool) found).* != (it % 3 == 0) { all = false; }
    }
    print_string("1000 keys: ");
    print_bool(all);
    print_string(", capacity ");
    print_int(g.capacity);
    print_byte(10);

    for 0..999 {
        if it % 2 == 0 { int_table_remove(*g, it * 7); }
    }
    odd_found := true;
    even_missing := true;
    for 0..999 {
        found := int_table_find(g, it * 7);
        if it % 2 == 0 {
            if found != null { even_missing = false; }
        } else {
            if found == null || (cast(*bool) found).* != (it % 3 == 0) { odd_found = false; }
        }
    }
    print_string("after removing 500: ");
    print_int(g.count);
    print_byte(32);
    print_bool(odd_found);
    print_byte(32);
    print_bool(even_missing);
    print_byte(10);

    // New keys take removed entries or empty ones, and the used and
    // removed entries together stay under three quarters of 2048, so the
    // table doesn't grow.
    for 0..499 {
        yes := true;
        int_table_set(*g, it * 7 + 1, *yes);
    }
    print_string("after adding 500 more: ");
    print_int(g.count);
    print_string(", capacity ");
    print_int(g.capacity);
    print_byte(10);

    aligned := true;
    for i: 0..g.capacity - 1 {
        used, key, value := int_table_entry(g, i);
        if used && cast(int) value % 8 != 0 { aligned = false; }
    }
    print_string("bool values: entry size ");
    print_int(g.entry_size);
    print_string(", aligned ");
    print_bool(aligned);
    print_byte(10);
    int_table_free(*g);

    // 12 keys fill 16 entries as far as they may be filled, and removing 10
    // leaves 10 removed entries. The next set rehashes, and with 3 keys to
    // hold the capacity stays 16: the rehash only clears the removed ones.
    r : Int_Table;
    int_table_init(*r, size_of(int), HEAP_ALLOCATOR);
    for 0..11 {
        value := it;
        int_table_set(*r, it, *value);
    }
    for 0..9 { int_table_remove(*r, it); }
    hundred_and_one := 101;
    int_table_set(*r, 100, *hundred_and_one);
    print_string("removed entries cleared: ");
    show_sizes(r.count, r.capacity);
    print_byte(32);
    print_int(r.removed);
    print_byte(32);
    print_bool(holds_int(int_table_find(r, 10), 10) && holds_int(int_table_find(r, 11), 11) && holds_int(int_table_find(r, 100), 101));
    print_byte(10);
    int_table_free(*r);

    // A value set from one of the table's own values, while the set grows
    // the table: 12 keys fill 16 entries, and the 13th, set to key 5's
    // value, grows them to 32. The value is copied before the old entries
    // go back, and the spoiling allocator sets their bytes to 255. Both
    // allocations, the old entries and the grown ones, are given back by
    // the time the table is freed.
    spoiled_ints : Counter;
    s : Int_Table;
    int_table_init(*s, size_of(int), Allocator.{spoiling_allocator_proc, *spoiled_ints});
    for 0..11 {
        value := it * 10;
        int_table_set(*s, it, *value);
    }
    int_table_set(*s, 12, int_table_find(s, 5));
    print_string("own value set while growing: ");
    print_int(int_value(int_table_find(s, 12)));
    print_byte(32);
    print_int(s.capacity);
    int_table_free(*s);
    print_string(", allocations ");
    print_int(spoiled_ints.allocations);
    print_string(", frees ");
    print_int(spoiled_ints.frees);
    print_byte(10);

    // The same for a string table, which sets its keys its own way. A key
    // set again after its removal takes back its removed entry. Then 12
    // keys fill 16 entries, and the 13th, set to the 6th's value, grows
    // them to 32. Every allocation, the old entries included, is given
    // back by the time the table is freed.
    spoiled : Counter;
    u : Table;
    table_init(*u, size_of(int), Allocator.{spoiling_allocator_proc, *spoiled});
    for 0..3 {
        value := it * 10;
        table_set(*u, WORDS[it], *value);
    }
    table_remove(*u, WORDS[1]);
    print_string("string removed entry taken again: ");
    print_int(u.removed);
    print_byte(32);
    table_set(*u, WORDS[1], *ten);
    print_int(u.removed);
    print_byte(32);
    print_int(u.count);
    print_byte(10);
    for 4..11 {
        value := it * 10;
        table_set(*u, WORDS[it], *value);
    }
    table_set(*u, WORDS[12], table_find(u, WORDS[5]));
    print_string("own string value set while growing: ");
    print_int(int_value(table_find(u, WORDS[12])));
    print_byte(32);
    print_int(u.capacity);
    table_free(*u);
    print_string(", allocations ");
    print_int(spoiled.allocations);
    print_string(", frees ");
    print_int(spoiled.frees);
    print_byte(10);

    // A table that was never set, or was freed, has no entries: a find or
    // a remove touches none. A null value sets a zeroed one, at the address
    // set returns and find gives.
    e : Table;
    table_init(*e, size_of(int), HEAP_ALLOCATOR);
    z : Int_Table;
    int_table_init(*z, size_of(int), HEAP_ALLOCATOR);
    print_string("no entries: ");
    print_bool(table_remove(*e, "x"));
    print_byte(32);
    print_bool(int_table_find(z, 0) == null);
    print_byte(32);
    print_bool(int_table_remove(*z, 0));
    print_byte(10);
    set_at := table_set(*e, "x", null);
    print_string("null value: ");
    print_bool(holds_int(set_at, 0));
    print_byte(32);
    print_bool(set_at == table_find(e, "x"));
    print_byte(10);

    // A null value zeroes the value of a key that is there, and of a new
    // key that takes back a removed entry, whose bytes still hold the
    // removed key's value.
    print_string("null over a value: ");
    table_set(*e, "y", *seven);
    table_set(*e, "y", null);
    print_bool(holds_int(table_find(e, "y"), 0));
    print_byte(32);
    table_set(*e, "y", *seven);
    table_remove(*e, "y");
    table_set(*e, "y", null);
    print_bool(holds_int(table_find(e, "y"), 0) && e.removed == 0);
    print_byte(32);
    int_table_set(*z, 1, *seven);
    int_table_set(*z, 1, null);
    print_bool(holds_int(int_table_find(z, 1), 0));
    print_byte(32);
    int_table_set(*z, 1, *seven);
    int_table_remove(*z, 1);
    int_table_set(*z, 1, null);
    print_bool(holds_int(int_table_find(z, 1), 0) && z.removed == 0);
    print_byte(10);

    // An entry that holds no key gives false, the empty string and null.
    unused := 0;
    while unused < e.capacity {
        used, key, value := table_entry(e, unused);
        if !used { break; }
        unused += 1;
    }
    used, key, value := table_entry(e, unused);
    print_string("unused entry: ");
    print_bool(used);
    print_byte(32);
    print_int(key.count);
    print_byte(32);
    print_bool(key.data == null);
    print_byte(32);
    print_bool(value == null);
    print_byte(10);
    table_free(*e);
    int_table_free(*z);

    // The entries and every key's copy come from the table's allocator, and
    // go back to it: a removed key's at once, the rest when the table is
    // freed. The empty key's copy has no bytes, so it takes no memory.
    counter : Counter;
    c : Table;
    table_init(*c, size_of(int), Allocator.{counting_allocator_proc, *counter});
    keys := string.["one", "two", "three", ""];
    for keys {
        value := it_index;
        table_set(*c, it, *value);
    }
    table_remove(*c, "two");
    print_string("own allocator: allocations ");
    print_int(counter.allocations);
    print_string(", frees ");
    print_int(counter.frees);
    table_free(*c);
    print_string(", after free ");
    print_int(counter.frees);
    print_byte(10);

    // A freed table keeps its value size and its allocator, and takes
    // entries again when set.
    four := 4;
    table_set(*c, "four", *four);
    print_string("set after free: ");
    print_int(int_value(table_find(c, "four")));
    print_byte(32);
    show_sizes(c.count, c.capacity);
    print_byte(10);
    table_free(*c);

    // A negative value size, which no type has, is taken as 0: each entry
    // is only its header.
    x : Table;
    table_init(*x, -5, HEAP_ALLOCATOR);
    xi : Int_Table;
    int_table_init(*xi, -5, HEAP_ALLOCATOR);
    print_string("negative value size: ");
    print_int(x.value_size);
    print_byte(32);
    print_int(x.entry_size);
    print_byte(32);
    print_int(xi.value_size);
    print_byte(32);
    print_int(xi.entry_size);
    print_byte(10);
}
