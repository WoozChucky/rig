// Tables as constants (issue #113, spec 4.2): an array of structs holding
// string literals' and procedures' addresses, gone through, indexed at run
// time and called through. And globals given constant data: each is a
// writable copy of its own (a view global's array too), so writing one
// leaves the constant as it was, read again at run time. A view global
// given a view that is a part of constant data sees the array holding it,
// or none, the empty view, for one a literal leaves out.
printf :: (format: *u8, ..) -> s32 #foreign libc;
puts :: (s: *u8) -> s32 #foreign libc;

add :: (a: int, b: int) -> int { return a + b; }
sub :: (a: int, b: int) -> int { return a - b; }
mul :: (a: int, b: int) -> int { return a * b; }

Vec2 :: struct { x: int; y: int; }
Op :: struct { symbol: *u8; run: (int, int) -> int; }
Holder :: struct { v: []int; n: int; }
Named :: struct { name: string; n: int; }

NAME :: "rig";
ORIGIN :: Vec2.{3, 4};
PRIMES :: int.[2, 3, 5, 7, 11];
OPS :: Op.[.{"+", add}, .{"-", sub}, .{"*", mul}];
OP :: OPS[2].run;
SYMBOL :: OPS[1].symbol;
NO_VIEW :: Holder.{n = 1};
UNNAMED :: Named.{n = 1};

origin := ORIGIN;
copy := PRIMES;
view : []int = PRIMES;
name : *u8 = NAME;
second := OPS[1];
op : (int, int) -> int = OPS[0].run;
empty : []int = NO_VIEW.v;
holder := Holder.{v = NO_VIEW.v, n = 2};
nameless : []u8 = cast([]u8) UNNAMED.name;
pair : []int = Holder.{v = int.[5, 6]}.v;

main :: () {
    for OPS { printf("6 %s 3 = %lld\n", it.symbol, it.run(6, 3)); }
    i := 1;
    printf("%s %lld\n", OPS[i].symbol, OPS[i].run(10, 4));
    printf("%lld\n", OP(7, 6));
    puts(SYMBOL);
    s := SYMBOL;
    puts(s);

    origin.x = 9;
    copy[0] = 100;
    view[1] = 300;
    printf("%lld %lld %lld %lld\n", origin.x, copy[0], view[1], copy[1]);
    printf("%lld %lld %lld\n", view[0], view[4], view.count);
    j := 0;
    k := 1;
    o := ORIGIN;
    printf("%lld %lld %lld\n", o.x, PRIMES[j], PRIMES[k]);
    printf("%s %s %lld %lld\n", name, second.symbol, second.run(8, 5), op(8, 5));
    printf("%lld %lld %lld %lld\n", empty.count, holder.v.count, holder.n, nameless.count);
    printf("%lld %lld %lld\n", pair.count, pair[0], pair[1]);
}
