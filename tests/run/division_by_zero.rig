// A division by a zero that isn't known while compiling stops the program
// with a runtime error, at the operator, and status 101. What it printed
// before still comes out: C's exit flushes stdout, a pipe here.
puts :: (s: *u8) -> s32 #foreign libc;

main :: () {
    puts("before");
    zero := 0;
    x := 10 / zero;
    puts("after");
}
