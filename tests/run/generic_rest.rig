// What any procedure has, in generic procedures (issue #226, spec 7.11).
// A '..$T' parameter: each of its arguments gives T, the first typed one
// fixing it, and a spread gives its elements' type, so sum(..float.[...])
// is sum for float32. A default value may name T, and is checked and
// converted per instance: scale's `by: T = 2` is an int for scale(3) and a
// float32 for scale(1.5), sized's size_of(T) each instance's own size. A
// default #caller_location is the place of each call that leaves it out,
// after a baked $T too, whose argument has no code. A #run inside an
// instance sees that instance's T: kind's #if picks a branch per instance
// by its type's tag, while compiling. The same compiled, interpreted and
// in #runs, a constant's and a top-level one.
#import "Basic";

Vec2 :: struct { x: float; y: float; }

Mode :: enum { A; B; }

sum :: (values: ..$T) -> T {
    t: T;
    for values { t += it; }
    return t;
}

scale :: (v: $T, by: T = 2) -> T { return v * by; }

sized :: (v: $T, n: int = size_of(T)) -> int { return n; }

where :: (v: $T, loc: Source_Code_Location = #caller_location) -> int { return loc.line; }

where2 :: ($T: Type, loc: Source_Code_Location = #caller_location) -> int { return loc.line; }

kind :: (v: $T) -> string {
    #if #run type_info(T).tag == .ENUM {
        return "enum";
    } else #if #run type_info(T).tag == .STRUCT {
        return "struct";
    } else {
        return "other";
    }
}

K :: #run kind(Mode.A);

#run {
    print("{}\n", sum(1, 2));
}

main :: () {
    print("{}\n", sum(1, 2, 3));
    print("{}\n", sum(..float.[1.5, 2.5]));
    print("{} {} {}\n", scale(3), scale(1.5), scale(3, 3));
    print("{} {}\n", sized(cast(u8) 1), sized(Vec2.{}));
    print("{} {}\n", where(1), where2(int));
    print("{} {} {}\n", kind(Mode.B), kind(Vec2.{}), kind(3));
    print("{}\n", K);
}
