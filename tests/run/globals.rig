// Globals (issue #36): a counter that two procedures increment, globals
// left zero, constants used above their declarations, and globals with the
// names of the C functions the runtime's panic routine calls.
putchar :: (c: s32) -> s32 #foreign libc;
puts :: (s: *u8) -> s32 #foreign libc;

print_int :: (n: int) {
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

println :: (n: int) {
    print_int(n);
    putchar(10);
}

counter : int;
step : u8 = STEP;

tick :: () {
    counter += 1;
}

leap :: () {
    counter += cast(int) step;
}

zeroed : u16;
never_set : s32 = ---;  // zero too: a global is never on the stack
start := LIMIT * 2 + 1;
ready : bool = !STOPPED;

// The program's own, apart from C's write and exit: LLVM renames these,
// since the runtime declared C's first (spec 6.4).
write : int = 3;
exit : u8 = 1;

main :: () {
    for 1..5 { tick(); }
    leap();
    println(counter);
    tick();
    println(counter);

    if zeroed == 0 && never_set == 0 { puts("zeroed"); }
    println(start);
    if ready { puts("ready"); }
    ready = false;
    if !ready { puts("not ready any more"); }

    {
        counter := 100;  // a local hides the global
        println(counter);
    }
    println(counter);
    // A division by a variable is checked, so the program has the runtime's
    // panic routine, which calls C's write and exit.
    println(counter / write + cast(int) exit);

    zeroed -= 1;
    println(cast(int) zeroed);
}

STEP :: 7;
LIMIT :: 42;
STOPPED :: false;
