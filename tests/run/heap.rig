// The heap, through C (issue #57): malloc's *void goes into an *int with
// no cast, ten ints are written and summed through pointer arithmetic, and
// free takes the *int back as a *void.
putchar :: (c: s32) -> s32 #foreign libc;
malloc :: (size: u64) -> *void #foreign libc;
free :: (p: *void) #foreign libc;

print_int :: (n: int) {
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

println :: (n: int) {
    print_int(n);
    putchar(10);
}

main :: () {
    numbers : *int = malloc(10 * size_of(int));
    for 0..9 { (numbers + it).* = it * it; }

    sum := 0;
    p := numbers;
    end := numbers + 10;
    while p < end {
        sum += p.*;
        p += 1;
    }
    println(sum);
    println((numbers + 9).*);
    println(end - numbers);
    println(size_of(int) * 10);
    free(numbers);
}
