// #if in a body (issue #147, spec 4.9): decided while compiling, its taken
// branch's statements the enclosing block's (#if makes no scope), the
// branch not taken parsed and never checked. Each system takes its own
// branch; what's printed is the same on both.
puts :: (s: *u8) -> s32 #foreign libc;

system_name :: () -> string {
    #if OS == .WINDOWS { name := "windows"; } else { name := "linux"; }
    return name;                  // the branch's local: no scope
}
// The last statement, returning on every path because its taken branch does.
system_number :: () -> int {
    #if OS == .WINDOWS { return 1; } else #if OS == .LINUX { return 2; } else { return 0; }
}
// Each branch holds what would be an error on the other system: a constant division by zero there.
guarded :: () -> int {
    #if OS == .WINDOWS {
        g :: 1 / (cast(int) OS - cast(int) Operating_System.LINUX);
    } else {
        g :: 1 / (cast(int) OS - cast(int) Operating_System.WINDOWS);
    }
    return g;                     // -1 on Windows, 1 on Linux
}
PICKED :: #run system_number();   // a #run reaching a body #if
// The #run's walk follows the taken branch only: helper, reached nowhere
// else, is checked before the run, and nope, in the branch not taken, is
// never looked at.
PICKED_TOO :: #run pick();
pick :: () -> int { #if true { return helper(); } else { return nope(); } }
helper :: () -> int { return 7; }
ready :: () -> bool { return true; }

main :: () {
    name := system_name();
    if (name[0] == 119) == (OS == .WINDOWS) { puts("the name agrees with OS"); }
    if system_number() == cast(int) OS { puts("the last statement returns"); }
    if guarded() * guarded() == 1 { puts("the other system's branch is never checked"); }
    if PICKED == cast(int) OS { puts("#run takes the same branch"); }
    if PICKED_TOO == 7 { puts("#run reaches what the taken branch calls"); }
    sum := 0;
    for 1..3 { #if true { if it == 2 { continue; } } sum += it; }
    if sum == 4 { puts("continue in a taken branch"); }
    VERBOSE :: false;
    #if VERBOSE { puts("never"); } else #if #run ready() { puts("a local constant and a #run decide"); }
    #if false { x : int = "never checked"; nope(); }
}
