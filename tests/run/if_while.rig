// if, else if, else and while (spec 6.1). The chain picks one letter for
// each of 1 to 4, ABCD; the while counts down from 3 to 0, 3210. Then
// while's other lowering paths, and break and continue in nested loops:
// each of those lines is printed only when its counts are right.
putchar :: (c: s32) -> s32 #foreign libc;
puts :: (s: *u8) -> s32 #foreign libc;

main :: () {
    for 1..4 {
        if it == 1 {
            putchar(65);
        } else if it == 2 {
            putchar(66);
        } else if it == 3 {
            putchar(67);
        } else {
            putchar(68);
        }
    }
    putchar(10);

    n : s32 = 3;
    while n >= 0 {
        putchar(48 + n);
        n -= 1;
    }
    putchar(10);

    // A condition with && or || makes blocks of its own, and continue goes
    // back to the condition, not to the body: at i = 9, which is odd, the
    // condition ends the loop. Were continue to go to the body, it would go
    // on to i = 10 and count it.
    i := 0;
    evens := 0;
    while i < 9 && i != 100 {
        i += 1;
        if i & 1 == 1 { continue; }
        evens += 1;
    }
    if i == 9 && evens == 4 { puts("while &&"); }

    j := 0;
    while j < 3 || j == 5 {
        j += 1;
        if j == 3 { j = 5; continue; }
    }
    if j == 6 { puts("while ||"); }

    // break and continue in an inner loop leave or go on with that loop
    // only. Each of the three outer iterations counts the inner one's 1 and
    // 3 (2 is skipped, 4 breaks); the outer continue after the inner loop
    // is still the outer loop's.
    outer := 0;
    inner := 0;
    after := 0;
    for 1..3 {
        outer += 1;
        for k: 1..9 {
            if k == 2 { continue; }
            if k == 4 { break; }
            inner += 1;
        }
        if it == 2 { continue; }
        after += 1;
    }
    if outer == 3 && inner == 6 && after == 2 { puts("nested for"); }

    // The same with whiles: the inner one, a while true, ends only by its
    // break.
    a := 0;
    pairs := 0;
    while a < 3 {
        a += 1;
        b := 0;
        while true {
            b += 1;
            if b == 2 { continue; }
            if b > 3 { break; }
            pairs += 1;
        }
        if a == 2 { continue; }
        pairs += 10;
    }
    if a == 3 && pairs == 26 { puts("nested while"); }
}
