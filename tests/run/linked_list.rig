// A linked list on the heap: a struct holds a pointer to its own type (spec
// 6.5), its nodes come from malloc, and p.value is a field read and written
// through the pointer p.
putchar :: (c: s32) -> s32 #foreign libc;
malloc :: (size: u64) -> *void #foreign libc;
free :: (p: *void) #foreign libc;

print_int :: (n: int) {
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

println :: (n: int) {
    print_int(n);
    putchar(10);
}

Node :: struct {
    value: int;
    next: *Node;
}

// A new node holding value, in front of head; the new head.
push :: (head: *Node, value: int) -> *Node {
    node : *Node = malloc(size_of(Node));
    node.* = Node.{value, head};
    return node;
}

main :: () {
    list : *Node;
    for 1..10 { list = push(list, it); }

    sum := 0;
    count := 0;
    p := list;
    while p != null {
        sum += p.value;
        count += 1;
        p.value *= 2;
        p = p.next;
    }
    println(sum);
    println(count);
    println(list.value);
    println(list.next.value);
    println(list.next.next.next.next.next.next.next.next.next.value);

    while list != null {
        next := list.next;
        free(list);
        list = next;
    }
    println(size_of(Node));
}
