// Loaded by tests/run/modify.rig: widen_more's call of widen gives its
// block u16 here, from another file, and the block's bindings make the main
// file's instance of int. widen_less's gives u8, which the main file's
// uses gave first: the block doesn't run for it again.
widen_more :: () -> int { return widen(cast(u16) 4); }

widen_less :: () -> int { return widen(cast(u8) 6); }
