// Loaded by tests/run/load_files.rig and by load/shapes.rig, and read once.
// It #loads load_files.rig back, which loads nothing, that file being the
// program's main file, loaded already; newline is that file's.
#load "../load_files.rig";

puts :: (s: *u8) -> s32 #foreign libc;
putchar :: (c: s32) -> s32 #foreign libc;

print_int :: (n: int) {
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

// n, then a new line.
print_line :: (n: int) {
    print_int(n);
    newline();
}
