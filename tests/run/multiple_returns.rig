// Several results (spec 6.7): received by names, assigned to targets, and
// a call used as one value, which gives its first result.
putchar :: (c: s32) -> s32 #foreign libc;

print_int :: (n: int) {
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

println :: (n: int) {
    print_int(n);
    putchar(10);
}

divmod :: (a: int, b: int) -> int, int {
    return a / b, a % b;
}

swap :: (a: int, b: int) -> int, int {
    return b, a;
}

// Results of different types, a narrow one among them.
halve :: (n: int) -> bool, u8 {
    if n % 2 == 0 { return true, cast(u8) (n / 2); }
    return false, 255;
}

main :: () {
    q, r := divmod(7, 2);
    println(q);
    println(r);

    a := 1;
    b := 2;
    a, b = swap(a, b);
    println(a);
    println(b);

    q, r = divmod(100, 7);
    println(q);
    println(r);

    println(divmod(47, 10));
    println(divmod(9, 4) + 10);

    even, half := halve(10);
    if even { println(cast(int) half); }
    wide : int;
    even, wide = halve(3);  // the u8 widens into the int
    if !even { println(wide); }

    // Declared in a loop's body: received anew each time.
    for 1..3 {
        x, y := divmod(it * 10, 4);
        println(x * 10 + y);
    }
}
