// #no_abc turns off one procedure's bounds checks (Jai's name: array
// bounds checks): one past the end of a struct's array reads the field after
// it. Every other procedure keeps its checks.
putchar :: (c: s32) -> s32 #foreign libc;

print_int :: (n: int) {
    if n < 0 {
        putchar(45);
        print_int(-n);
        return;
    }
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

println :: (n: int) {
    print_int(n);
    putchar(10);
}

Holder :: struct {
    a: [4]int;
    b: int;
}

peek :: (h: *Holder, i: int) -> int #no_abc {
    return h.a[i];
}

main :: () {
    h : Holder;
    h.b = 42;
    println(peek(*h, 4));
}
