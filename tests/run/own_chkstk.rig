// A program may have a procedure of its own called __chkstk. On Windows LLVM
// calls __chkstk, by name, at the start of every function whose frame is
// bigger than a page, to touch the frame's pages in order; the program's
// own must not take that call (llvm_backend.cpp's declare_stack_probe). On
// Linux the probes are inline, and the name is the program's anyway.
putchar :: (c: s32) -> s32 #foreign libc;

println :: (digit: int) {
    putchar(cast(s32) digit + 48);
    putchar(10);
}

__chkstk :: () -> int {
    return 7;
}

main :: () {
    big : [100000]u8;
    big[99999] = 5;
    println(cast(int) big[99999]);
    println(__chkstk());
}
