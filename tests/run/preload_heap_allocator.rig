// Preload (spec 2.14): every program imports it, so this one, with no
// #import, has Allocator, its modes and the heap allocator. It declares
// C's free itself: Preload's own C declarations are __malloc, __realloc
// and __free, which leave the name to the program, and both reach C's
// one free.
puts :: (s: *u8) -> s32 #foreign libc;
free :: (memory: *void) #foreign libc;

// 8 ints from the allocator, written, grown to 16 with the first 8 kept,
// and given back: true when every step worked.
round_trip :: (a: Allocator) -> bool {
    numbers : *int = a.proc(ALLOCATE, 8 * size_of(int), 0, null, a.data);
    if numbers == null { return false; }
    for 0..7 { (numbers + it).* = it; }
    numbers = a.proc(RESIZE, 16 * size_of(int), 8 * size_of(int), numbers, a.data);
    if numbers == null { return false; }
    kept := (numbers + 7).* == 7;
    a.proc(FREE, 0, 0, numbers, a.data);
    return kept;
}

// The compile-time world has Preload too (spec 7.8).
WHILE_COMPILING :: #run round_trip(HEAP_ALLOCATOR);

main :: () {
    if round_trip(HEAP_ALLOCATOR) { puts("allocated, resized and freed on the heap"); }
    if WHILE_COMPILING { puts("and while compiling"); }
    a := HEAP_ALLOCATOR;
    p := a.proc(ALLOCATE, 64, 0, null, a.data);
    if p != null { puts("64 bytes from the heap"); }
    free(p);
    if a.proc(FREE_ALL, 0, 0, null, a.data) == null { puts("FREE_ALL gives null"); }
    if ALLOCATE == 0 && RESIZE == 1 && FREE == 2 && FREE_ALL == 3 { puts("the modes are 0 to 3"); }
}
