// array_pop of a resizable array whose count says it has elements but
// whose data is null (issue #158, spec 3.17, 8.4): its data is checked as
// a view's is, so the program stops at the built-in's name rather than
// reading through null.
main :: () {
    a : [..]int;
    a.count = 2;
    x := array_pop(*a);
}
