// Code run while compiling (issue #115, spec 7.8): a #run's result is a
// typed constant of its operand's type. One sizes an array, one names a
// procedure that main then calls, and one in a body folds with what's
// around it. A procedure value is also used as a value: held by a local,
// called as written, held by a global, held by a local of a body a #run
// reaches, and a foreign procedure's.
printf :: (format: *u8, ..) -> s32 #foreign libc;
strlen :: (s: *u8) -> u64 #foreign libc;

triangle :: (n: int) -> int {
    total := 0;
    for 1..n { total += it; }
    return total;
}

add :: (a: int, b: int) -> int { return a + b; }
pick :: () -> (int, int) -> int { return add; }
c_one :: () -> (s: *u8) -> u64 #c_call { return strlen; }

inner :: () -> int {
    f := #run pick();
    return f(4, 5);
}

LIMIT :: #run triangle(4);
grid : [LIMIT]int;
OP :: #run pick();
OUTER :: #run inner();
g : (int, int) -> int = #run pick();

main :: () {
    seed := #run triangle(3) + 1;
    printf("%lld %lld %lld\n", grid.count, seed, OP(2, 3));
    h := #run pick();
    length := #run c_one();
    printf("%lld %lld %lld %lld %llu\n", h(3, 4), (#run pick())(7, 8), g(2, 3), OUTER, length("abc"));
}
