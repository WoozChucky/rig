// Tables computed while compiling (issue #115, spec 7.8): a #run's array,
// its table of structs holding strings and procedures, and its view of
// memory malloc gave while compiling are baked into the program as
// constant data, as if they had been written there. One of the primes
// sizes an array. A table used in a body is read at run time. A table of
// narrow scalars keeps each at its own width, and a #run's bytes cast to a
// string are a string literal's.
printf :: (format: *u8, ..) -> s32 #foreign libc;
malloc :: (size: u64) -> *void #foreign libc;

Op :: struct {
    symbol: string;
    run: (int, int) -> int;
}

add :: (a: int, b: int) -> int { return a + b; }
sub :: (a: int, b: int) -> int { return a - b; }
mul :: (a: int, b: int) -> int { return a * b; }

is_prime :: (n: int) -> bool {
    if n < 2 { return false; }
    d := 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d += 1;
    }
    return true;
}

primes :: () -> [8]int {
    found : [8]int;
    count := 0;
    n := 2;
    while count < 8 {
        if is_prime(n) {
            found[count] = n;
            count += 1;
        }
        n += 1;
    }
    return found;
}

ops :: () -> [3]Op { return Op.[.{"+", add}, .{"-", sub}, .{"*", mul}]; }

squares :: (n: int) -> []int {
    v : []int;
    v.data = malloc(cast(u64) n * size_of(int));
    v.count = n;
    for 0..n - 1 { v[it] = it * it; }
    return v;
}

Narrow :: struct { a: s8; b: u8; c: s16; d: bool; z: bool; f: u16; e: float32; g: int; }

narrow :: () -> [2]Narrow {
    r : [2]Narrow;
    r[0] = .{-1, 200, -300, true, false, 65000, 1.5, 7};
    r[1] = .{5, 0, 0, false, true, 0, 0.0, -1};
    return r;
}

letters : [3]u8;

bytes :: () -> []u8 {
    letters[0] = 97;
    letters[1] = 98;
    letters[2] = 99;
    return letters;
}

NARROW :: #run narrow();
WORD :: cast(string) #run bytes();
word := cast(string) #run bytes();

PRIMES :: #run primes();
OPS :: #run ops();
SQUARES :: #run squares(5);
SAME :: SQUARES;
N :: PRIMES[3];

main :: () {
    for PRIMES { printf("%lld ", it); }
    printf("\n");
    for OPS { printf("6 %s 3 = %lld\n", it.symbol.data, it.run(6, 3)); }
    grid : [N]int;
    printf("%lld\n", grid.count);
    for SQUARES { printf("%lld ", it); }
    printf("\n");

    // A #run's table in a body is read at run time, from read-only data of
    // its own, and so is a constant made from a #run's view.
    i := 2;
    local := #run primes();
    view := #run squares(4);
    table := #run ops();
    printf("%lld %lld %lld\n", local[i], view[i + 1], SAME[i + 2]);
    printf("4 %s 5 = %lld\n", table[i].symbol.data, table[i].run(4, 5));

    // Folded, then read at run time.
    n := NARROW[0];
    printf("%d %d %d %d %d %d %g %lld\n", NARROW[0].a, NARROW[0].b, NARROW[0].c, NARROW[0].d, NARROW[0].z,
           NARROW[0].f, NARROW[0].e, NARROW[0].g);
    printf("%d %d %d %d %d %d %g %lld\n", n.a, n.b, n.c, n.d, n.z, n.f, n.e, n.g);
    j := 1;
    printf("%d %d %d %d %d %d %g %lld\n", NARROW[j].a, NARROW[j].b, NARROW[j].c, NARROW[j].d, NARROW[j].z,
           NARROW[j].f, NARROW[j].e, NARROW[j].g);

    // The global's bytes are its own: changing them leaves WORD's.
    word[0] = 65;
    printf("%s %s %lld\n", WORD, word.data, WORD.count);
}
