// A call of Preload's __runtime_error (issue #157, spec 8.1) whose text
// has no bytes, its data null, but a positive count is taken as one with
// none: the program stops with status 101 and writes nothing, rather than
// reading through the null pointer. Interpreted, the same (spec 10.8).
#import "Basic";

main :: () {
    print_line("before");
    text : string;
    text.count = 5;
    __runtime_error(text, 0);
    print_line("not reached");
}
