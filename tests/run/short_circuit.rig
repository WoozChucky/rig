// && and || evaluate their right side only when the left one doesn't decide:
// each call prints its letter, so the output shows which ones ran.
putchar :: (c: s32) -> s32 #foreign libc;

yes :: (c: s32) -> bool {
    putchar(c);
    return true;
}

no :: (c: s32) -> bool {
    putchar(c);
    return false;
}

main :: () {
    if no(65) && yes(66) { putchar(88); }               // A: false && ... is false
    if yes(67) && no(68) { putchar(88); }               // C D
    if yes(69) || yes(70) { putchar(71); }              // E G: true || ... is true
    if no(72) || no(73) { } else { putchar(74); }       // H I J
    b := no(75) && yes(76);                             // K
    if !b && (no(77) || yes(78)) { putchar(79); }       // M N O
    putchar(10);
}
