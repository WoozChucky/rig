// The milestone's acceptance program's sort (spec 6.5): an insertion sort
// of a view, given an array, which it sorts where it is.
putchar :: (c: s32) -> s32 #foreign libc;

print_int :: (n: int) {
    if n < 0 {
        putchar(45);
        print_int(-n);
        return;
    }
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

println :: (n: int) {
    print_int(n);
    putchar(10);
}

sort :: (a: []int) {
    for i: 1..a.count - 1 {
        x := a[i];
        j := i;
        while j > 0 && a[j - 1] > x { a[j] = a[j - 1]; j -= 1; }
        a[j] = x;
    }
}

main :: () {
    numbers := int.[5, 3, 9, 1, 7];
    sort(numbers);
    for numbers {
        print_int(it);
        putchar(32);
    }
    putchar(10);
    more : [10]int;
    for * more { it.* = (it_index * 7) % 10; }
    sort(more);
    for more { print_int(it); }
    putchar(10);
    none : []int;
    sort(none);
    one := int.[42];
    sort(one);
    println(one[0]);
}
