// Globals holding string literals (issue #60, spec 6.5): a global string, a
// *u8 and a []u8, a struct's string field and arrays and views of strings.
// Each one's bytes hold a literal's address, which the program's file can't
// give as a number: the linker writes it there (a relocation).
putchar :: (c: s32) -> s32 #foreign libc;
puts :: (s: *u8) -> s32 #foreign libc;

print :: (s: string) {
    for s { putchar(it); }
}

println :: (s: string) {
    print(s);
    putchar(10);
}

Named :: struct {
    id: int;
    name: string;
}

greeting := "hello";
c_greeting : *u8 = "hello, C";
c_again := cast(*u8) "again";
bytes := cast([]u8) "bytes";
named := Named.{7, "seven"};
names := string.["zero", "one", "two"];
list : []string = .["a", "bc", "def"];
nobody : string;

main :: () {
    println(greeting);
    puts(c_greeting);
    puts(c_again);
    println(cast(string) bytes);
    putchar(cast(s32) named.id + 48);
    putchar(32);
    println(named.name);
    for names { println(it); }
    for list {
        putchar(cast(s32) it.count + 48);
        putchar(cast(s32) it[it.count - 1]);
    }
    putchar(10);
    // A global without a value is zeroed: no bytes.
    putchar(cast(s32) nobody.count + 48);
    putchar(10);
    // A global string changes as any variable does.
    greeting = "bye";
    println(greeting);
}
