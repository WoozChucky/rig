// The no-case check of a #complete switch isn't a bounds check: it stays
// with --no-bounds-checks (issue #222, spec 6.14, 8.1). A u64 enum's value
// is written unsigned, 2^64-1 whole. Compiled and interpreted.
#import "Basic";

Huge :: enum u64 { SMALL; }

main :: () {
    print("before\n");
    h := cast(Huge) 18446744073709551615;
    if #complete h == {
        case .SMALL; print("small\n");
    }
    print("after\n");
}
