// A string switch reads the switched string's bytes only to compare them
// with a case of the same count (issue #222, spec 6.14, 8.4): a count of
// 3 with null data passes the case of 2 bytes, then stops at the
// switch's '==' at the case of 3.
puts :: (s: *u8) -> s32 #foreign libc;

main :: () {
    s : string;
    s.count = 3;
    if s == {
        case "ab";  puts("two");
        case "abc"; puts("three");
    }
}
