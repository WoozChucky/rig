// A switch on strings (issue #222, spec 6.14): each case compared as ==
// compares strings, in order; a constant's string and a #run's as
// cases; the empty string; and strings that differ only in length or
// in case.
#import "Basic";

GREETING :: "hello";
PICKED :: #run picked();
picked :: () -> string { return "picked"; }

kind :: (s: string) -> int {
    if s == {
        case "";       return 0;
        case GREETING; return 1;
        case "help";   return 2;
        case PICKED;   return 3;
        case;          return -1;
    }
}

main :: () {
    print("{} {} {} {} {} {}\n", kind(""), kind("hello"), kind("help"), kind("picked"), kind("hell"), kind("HELLO"));
    words := string.["help", "x", "hello"];
    for words {
        if it == {
            case "hello"; print("[hello]");
            case "help";  print("[help]");
        }
    }
    print("\n");
}
