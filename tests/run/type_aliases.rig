// Type aliases (issue #227, spec 3.22): a constant whose value names a
// type is that type under a second name, wherever a type is written: a
// struct's (V), a pointer's (P, an alias's pointer), a procedure type's
// written as a signature with no body (Cb) or with #type (Cb2), a built-in
// type's (My_Int, equal to int), an enum's, its members named through it
// (M.BUSY) and a cast to it, a union's (U), a resizable array's (Ints), an
// array's declared in a body (Local), one in a generic's body, each
// instance's (Two, [2]T, int's and float's), one passed for a $T: Type
// (size_t(M)), and one used before its declaration, in a struct's field
// (Holder's Later). A local alias may hide a name a debugger shows: a
// local, a global, a top-level constant and a procedure. The type
// information is the type's own, so V's description names Vec2. The same
// compiled, interpreted and in a top-level #run, which holds a local alias
// and calls a procedure that has one.
#import "Basic";

Vec2 :: struct { x: float; y: float; }

V :: Vec2;
P :: *V;
Cb :: (n: int) -> int;
Cb2 :: #type (int, string) -> bool;
My_Int :: int;
Mode :: enum { FREE; BUSY; }
M :: Mode;
Value :: union { i: s64; f: float64; }
U :: Value;
Ints :: [..]int;

Holder :: struct { at: Later; }
Later :: Defined_After;
Defined_After :: struct { v: My_Int; }

gv := 5;
N :: 3;

twice :: (n: int) -> int { return n * 2; }
long_enough :: (n: int, s: string) -> bool { return s.count >= n; }
size_t :: ($T: Type) -> int { return size_of(T); }

first_two :: (xs: []$T) -> [2]T {
    Two :: [2]T;
    r: Two;
    r[0] = xs[0];
    r[1] = xs[1];
    return r;
}

helper :: () -> int {
    L :: [2]int;
    b: L = .[3, 4];
    return b[0] + b[1];
}

#run {
    x: P;
    print("{}\n", x == null);
    L :: [2]int;
    b: L = .[1, 2];
    print("{} {}\n", b, helper());
}

main :: () {
    v: V = .{1, 2};
    print("{}\n", v);
    f: Cb = twice;
    print("{}\n", f(21));
    g: Cb2 = long_enough;
    print("{}\n", g(2, "abc"));
    n: My_Int = 7;
    print("{} {}\n", n, My_Int == int);
    m := M.BUSY;
    print("{} {} {}\n", m, cast(M) 0, size_t(M));
    u: U;
    u.i = 3;
    print("{} {}\n", u.i, size_of(U));
    xs: Ints;
    array_add(*xs, 3);
    print("{}\n", xs);
    array_free(*xs);
    Local :: [3]My_Int;
    arr: Local = .[1, 2, 3];
    print("{}\n", arr);
    print("{}\n", (cast(*Type_Info_Struct) type_info(V)).name);
    print("{}\n", first_two(int.[4, 5, 6]));
    print("{}\n", first_two(float.[1.5, 2.5]));
    h: Holder;
    print("{}\n", h);
    x := 1;
    {
        x :: s8;
        y: x = 2;
        gv :: [2]int;
        z: gv = .[1, 2];
        N :: u16;
        w: N = 9;
        helper :: *int;
        q: helper = null;
        print("{} {} {} {}\n", y, z, w, q == null);
    }
    print("{} {} {} {}\n", x, gv, N, helper());
}
