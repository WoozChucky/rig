// Types where a value goes (issue #226, spec 5.20): == and != compare two
// types while compiling, true when they're the same type. int and s64 are
// two types, float and float32 one, *Vec2 and Vec2 two; an enum's name
// names a type as a struct's does. A type is written as a value by its
// name, *X, [N]T, []T, [..]T or #type T, a procedure type's above all. The
// result is a constant bool, so #if decides on one, at the top level too,
// and a constant holds one. A local of a built-in type's name hides the
// type: int == 5 compares the local. The same compiled, interpreted and in
// #runs, a top-level one and one in a body, whose call runs while compiling
// with a comparison of types as its argument.
#import "Basic";

Vec2 :: struct { x: float; y: float; }

Mode :: enum { A; B; }

SAME :: int == s64;

negate :: (b: bool) -> bool { return !b; }

#run { print("{} {} {}\n", []u8 == []u8, int == s64, *Vec2 == *Vec2); }

#if *Vec2 == *Vec2 && int != s64 {
    DECIDED :: "top-level taken";
} else {
    DECIDED :: "top-level not taken";
}

main :: () {
    print("{} {} {}\n", int == int, int == s64, float == float32);
    print("{} {} {}\n", []int == []int, [..]int != []int, int != int);
    print("{} {} {} {}\n", *Vec2 == *Vec2, [3]Vec2 == [4]Vec2, *Vec2 == Vec2, *u8 == u8);
    print("{} {}\n", Mode == Mode, Mode != int);
    print("{}\n", #type (int) -> int == #type (int) -> int);
    #if *u8 == *u8 {
        print("taken\n");
    } else {
        print("not taken\n");
    }
    print("{}\n", DECIDED);
    print("{}\n", SAME);
    x := #run negate(int == s64);
    print("{}\n", x);
    int := 5;
    print("{}\n", int == 5);
}
