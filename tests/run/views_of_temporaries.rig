// A view of a literal or of a call's array result (spec 6.5) sees a
// temporary of its own, one per place in the source, filled only once the
// value is worked out. So a loop that runs the same place again reads the
// old view whole before the new value lands where it points: every value is
// read before anything is written.
putchar :: (c: s32) -> s32 #foreign libc;

print_int :: (n: int) {
    if n >= 10 { print_int(n / 10); }
    putchar(cast(s32) (n % 10) + 48);
}

show :: (v: []int) {
    for v {
        print_int(it);
        putchar(32);
    }
    putchar(10);
}

rev :: (v: []int) -> [2]int {
    return .[v[1], v[0]];
}

Holder :: struct { v: []int; }

// Both results read v: the first is copied out before the second is built.
step :: (v: []int) -> [2]int, [2]int {
    return .[v[1], v[0]], .[v[0], v[1]];
}

main :: () {
    // Fibonacci: the literal reads pair[0] after its first element is built.
    pair: []int = int.[0, 1];
    for 1..8 {
        pair = .[pair[1], pair[0] + pair[1]];
        print_int(pair[0]);
        putchar(32);
    }
    putchar(10);

    // A swap through the literal.
    w: []int = int.[1, 2];
    for 1..3 {
        w = .[w[1], w[0]];
        show(w);
    }

    // A procedure's array result, viewed, given back to it.
    x: []int = int.[3, 4];
    for 1..3 {
        x = rev(x);
        show(x);
    }

    // Two array results into views, the first given back to the call.
    a: []int = int.[1, 2];
    b: []int;
    for 1..3 {
        a, b = step(a);
        show(a);
        show(b);
    }

    // A literal in a struct literal's view field.
    h :=Holder.{int.[5, 6]};
    for 1..2 {
        h = .{.[h.v[1], h.v[0] + h.v[1]]};
        show(h.v);
    }
}
